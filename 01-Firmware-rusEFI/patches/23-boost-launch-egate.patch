 using ::testing::_;
 using ::testing::StrictMock;
+using ::testing::Return;
+using ::testing::InSequence;
 
 static Map2D<BOOST_CURVE_SIZE, float, float> testBoostCltCorr { "clt" };
 static Map2D<BOOST_CURVE_SIZE, float, float> testBoostIatCorr { "iat" };
@@ -409,3 +411,97 @@ TEST(BoostControl, SetOutputETB) {
 
 	bc.setOutput(25.0f);
 }
+
+// pro-style boost values during 2-step and anti-lag
+TEST(BoostControl, LaunchAndAntilagOverride) {
+	MockVp3d targetMap;
+	MockVp3d openMap;
+	EXPECT_CALL(targetMap, getValue(_, _)).WillRepeatedly(Return(150));
+	EXPECT_CALL(openMap, getValue(_, _)).WillRepeatedly(Return(40));
+
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	engineConfiguration->boostType = CLOSED_LOOP;
+	Sensor::setMockValue(SensorType::DriverThrottleIntent, 80.0f);
+	Sensor::setMockValue(SensorType::Tps1, 80.0f);
+	Sensor::setMockValue(SensorType::Rpm, 4000);
+
+	testBoostCltCorr.initTable(config->cltBoostCorr, config->cltBoostCorrBins);
+	testBoostIatCorr.initTable(config->iatBoostCorr, config->iatBoostCorrBins);
+	testBoostCltAdder.initTable(config->cltBoostAdder, config->cltBoostAdderBins);
+	testBoostIatAdder.initTable(config->iatBoostAdder, config->iatBoostAdderBins);
+
+	BoostController bc;
+	bc.init(nullptr, &openMap, &targetMap, testBoostCltCorr, testBoostIatCorr, testBoostCltAdder, testBoostIatAdder, &engineConfiguration->boostPid);
+
+	engineConfiguration->launchBoostOverride = true;
+	engineConfiguration->launchBoostDuty = 70;
+	engineConfiguration->launchBoostTarget = 120;
+	engineConfiguration->antilagBoostOverride = true;
+	engineConfiguration->antilagBoostDuty = 90;
+	engineConfiguration->antilagBoostTarget = 200;
+
+	// no 2-step, no anti-lag: the maps
+	bc.updateOverrideState();
+	EXPECT_FALSE(bc.isLaunchBoost);
+	EXPECT_FALSE(bc.isAntilagBoost);
+	EXPECT_NEAR(150, bc.getSetpoint().value_or(-1), 0.1);
+	EXPECT_NEAR(40, bc.getOpenLoop(0).value_or(-1), 0.1);
+
+	// 2-step active
+	engineConfiguration->launchControlEnabled = true;
+	engine->launchController.isLaunchCondition = true;
+	bc.updateOverrideState();
+	EXPECT_TRUE(bc.isLaunchBoost);
+	EXPECT_NEAR(120, bc.getSetpoint().value_or(-1), 0.1);
+	EXPECT_NEAR(70, bc.getOpenLoop(0).value_or(-1), 0.1);
+
+	// 2-step wins over anti-lag
+	engine->antilagController.isAntilagCondition = true;
+	bc.updateOverrideState();
+	EXPECT_TRUE(bc.isLaunchBoost);
+	EXPECT_FALSE(bc.isAntilagBoost);
+
+	// anti-lag only
+	engine->launchController.isLaunchCondition = false;
+	bc.updateOverrideState();
+	EXPECT_TRUE(bc.isAntilagBoost);
+	EXPECT_NEAR(200, bc.getSetpoint().value_or(-1), 0.1);
+	EXPECT_NEAR(90, bc.getOpenLoop(0).value_or(-1), 0.1);
+
+	// override off: back to the maps even during anti-lag
+	engineConfiguration->antilagBoostOverride = false;
+	bc.updateOverrideState();
+	EXPECT_FALSE(bc.isAntilagBoost);
+	EXPECT_NEAR(150, bc.getSetpoint().value_or(-1), 0.1);
+}
+
+TEST(BoostControl, RestPositionWithEngineStopped) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+
+	engineConfiguration->isBoostControlEnabled = true;
+	engineConfiguration->boostControlPin = Gpio::A0;
+	engineConfiguration->boostControlSafeDutyCycle = 5;
+	engineConfiguration->boostRestEnabled = true;
+	engineConfiguration->boostRestPosition = 30;
+	engineConfiguration->boostControlMinRpm = 2000;
+
+	StrictMock<MockPwm> pwm;
+	BoostController bc;
+	bc.init(&pwm, nullptr, nullptr, testBoostCltCorr, testBoostIatCorr, testBoostCltAdder, testBoostIatAdder, &engineConfiguration->boostPid);
+
+	{
+		InSequence s;
+		// stopped: rest position
+		EXPECT_CALL(pwm, setSimplePwmDutyCycle(0.30f));
+		// running below boost control conditions: safe duty as before
+		EXPECT_CALL(pwm, setSimplePwmDutyCycle(0.05f));
+	}
+
+	Sensor::setMockValue(SensorType::Rpm, 0);
+	bc.onFastCallback();
+	EXPECT_TRUE(bc.isAtRest);
+
+	Sensor::setMockValue(SensorType::Rpm, 900);
+	bc.onFastCallback();
+	EXPECT_FALSE(bc.isAtRest);
+}
