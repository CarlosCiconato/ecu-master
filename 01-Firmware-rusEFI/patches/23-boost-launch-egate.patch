diff --git a/firmware/controllers/actuators/boost_control.cpp b/firmware/controllers/actuators/boost_control.cpp
index 571c481..1fc0eca 100644
--- a/firmware/controllers/actuators/boost_control.cpp
+++ b/firmware/controllers/actuators/boost_control.cpp
@@ -76,6 +76,19 @@ expected<float> BoostController::observePlant() {
     return map;
 }
 
+void BoostController::updateOverrideState() {
+	isLaunchBoost = false;
+	isAntilagBoost = false;
+#if EFI_LAUNCH_CONTROL
+	isLaunchBoost = engineConfiguration->launchBoostOverride
+		&& engine->launchController.isLaunchOrPreLaunchCondition();
+#endif // EFI_LAUNCH_CONTROL
+#if EFI_ANTILAG_SYSTEM
+	isAntilagBoost = !isLaunchBoost && engineConfiguration->antilagBoostOverride
+		&& engine->antilagController.isAntilagCondition;
+#endif // EFI_ANTILAG_SYSTEM
+}
+
 expected<float> BoostController::getSetpoint() {
 	// If we're in open loop only mode, disregard any target computation.
 	// Open loop needs to work even in case of invalid closed loop config
@@ -85,6 +98,14 @@ expected<float> BoostController::getSetpoint() {
 		return (float)boostControllerClosedLoopPart;
 	}
 
+	// pro-style fixed target during 2-step or anti-lag
+	if (isLaunchBoost) {
+		return (float)engineConfiguration->launchBoostTarget;
+	}
+	if (isAntilagBoost) {
+		return (float)engineConfiguration->antilagBoostTarget;
+	}
+
 	float rpm = Sensor::getOrZero(SensorType::Rpm);
 
 	auto driverIntent = Sensor::get(SensorType::DriverThrottleIntent);
@@ -124,6 +145,12 @@ expected<percent_t> BoostController::getOpenLoop(float target) {
 	// Boost control open loop doesn't care about target - only TPS/RPM
 	UNUSED(target);
 
+	// pro-style fixed output during 2-step or anti-lag
+	if (isLaunchBoost || isAntilagBoost) {
+		openLoopPart = isLaunchBoost ? engineConfiguration->launchBoostDuty : engineConfiguration->antilagBoostDuty;
+		return (float)openLoopPart;
+	}
+
 	float rpm = Sensor::getOrZero(SensorType::Rpm);
 	auto driverIntent = readGppwmChannel(engineConfiguration->boostOpenLoopYAxis);
 
@@ -285,9 +312,17 @@ void BoostController::onFastCallback() {
 	tpsTooLow = Sensor::getOrZero(SensorType::Tps1) < engineConfiguration->boostControlMinTps;
 	mapTooLow = Sensor::getOrZero(SensorType::Map) < engineConfiguration->boostControlMinMap;
 
-  isBoostControlled = !(rpmTooLow || tpsTooLow || mapTooLow);
+	isBoostControlled = !(rpmTooLow || tpsTooLow || mapTooLow);
+
+	updateOverrideState();
 
-	if (!isBoostControlled) {
+	// eGate rest position with the engine stopped
+	isAtRest = engineConfiguration->boostRestEnabled && Sensor::getOrZero(SensorType::Rpm) == 0;
+
+	if (isAtRest) {
+		m_pid.reset();
+		setOutput((float)engineConfiguration->boostRestPosition);
+	} else if (!isBoostControlled && !isLaunchBoost && !isAntilagBoost) {
 		// Passing unexpected will use the safe duty cycle configured by the user
 		setOutput(unexpected);
 	} else {
