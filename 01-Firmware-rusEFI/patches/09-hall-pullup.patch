+/*
+ * @file hall_pullup.h
+ *
+ * pro-style crank and cam inputs that take a VR or a Hall sensor, chosen in software:
+ * each input has an output that turns on its Hall pull-up when its sensor type is Hall.
+ */
+
+#pragma once
+
+class HallPullupController : public EngineModule {
+public:
+	using interface_t = HallPullupController;
+
+	void onSlowCallback() override;
+
+	void update();
+};
