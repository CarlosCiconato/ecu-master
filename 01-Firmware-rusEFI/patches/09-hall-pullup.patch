diff --git a/unit_tests/tests/controllers/test_hall_pullup.cpp b/unit_tests/tests/controllers/test_hall_pullup.cpp
new file mode 100644
index 0000000..4ece414
--- /dev/null
+++ b/unit_tests/tests/controllers/test_hall_pullup.cpp
@@ -0,0 +1,41 @@
+#include "pch.h"
+
+#include "hall_pullup.h"
+
+// pro-style VR or Hall sensor chosen in software: each crank and cam input has an
+// output that turns on its Hall pull-up when its sensor type is Hall.
+
+TEST(HallPullup, OffForVrByDefault) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+
+	engine->module<HallPullupController>().unmock().update();
+
+	EXPECT_FALSE(enginePins.hallPullupCrank1.getLogicValue());
+	EXPECT_FALSE(enginePins.hallPullupCrank2.getLogicValue());
+	EXPECT_FALSE(enginePins.hallPullupCam1.getLogicValue());
+	EXPECT_FALSE(enginePins.hallPullupCam2.getLogicValue());
+}
+
+TEST(HallPullup, OnlyHallInputsGetPullup) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	auto& dut = engine->module<HallPullupController>().unmock();
+
+	engineConfiguration->triggerSensorType[0] = INPUT_SENSOR_VR;
+	engineConfiguration->triggerSensorType[1] = INPUT_SENSOR_HALL;
+	engineConfiguration->camSensorType[0] = INPUT_SENSOR_HALL;
+	engineConfiguration->camSensorType[1] = INPUT_SENSOR_VR;
+	dut.update();
+
+	EXPECT_FALSE(enginePins.hallPullupCrank1.getLogicValue());
+	EXPECT_TRUE(enginePins.hallPullupCrank2.getLogicValue());
+	EXPECT_TRUE(enginePins.hallPullupCam1.getLogicValue());
+	EXPECT_FALSE(enginePins.hallPullupCam2.getLogicValue());
+
+	// switching the type in software follows right away
+	engineConfiguration->triggerSensorType[0] = INPUT_SENSOR_HALL;
+	engineConfiguration->camSensorType[0] = INPUT_SENSOR_VR;
+	dut.onSlowCallback();
+
+	EXPECT_TRUE(enginePins.hallPullupCrank1.getLogicValue());
+	EXPECT_FALSE(enginePins.hallPullupCam1.getLogicValue());
+}
