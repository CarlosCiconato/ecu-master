diff --git a/firmware/controllers/modules/hall_pullup/hall_pullup.cpp b/firmware/controllers/modules/hall_pullup/hall_pullup.cpp
new file mode 100644
index 0000000..652f688
--- /dev/null
+++ b/firmware/controllers/modules/hall_pullup/hall_pullup.cpp
@@ -0,0 +1,22 @@
+#include "pch.h"
+
+#include "hall_pullup.h"
+
+template<typename TTypes>
+static bool isHall(const TTypes& types, size_t index) {
+	// boards with one bank have only 2 cam inputs
+	return index < efi::size(types) && types[index] == INPUT_SENSOR_HALL;
+}
+
+void HallPullupController::update() {
+	enginePins.hallPullupCrank1.setValue(isHall(engineConfiguration->triggerSensorType, 0));
+	enginePins.hallPullupCrank2.setValue(isHall(engineConfiguration->triggerSensorType, 1));
+	enginePins.hallPullupCam1.setValue(isHall(engineConfiguration->camSensorType, 0));
+	enginePins.hallPullupCam2.setValue(isHall(engineConfiguration->camSensorType, 1));
+	enginePins.hallPullupCam3.setValue(isHall(engineConfiguration->camSensorType, 2));
+	enginePins.hallPullupCam4.setValue(isHall(engineConfiguration->camSensorType, 3));
+}
+
+void HallPullupController::onSlowCallback() {
+	update();
+}
