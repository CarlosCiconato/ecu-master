--- /dev/null
+++ b/unit_tests/tests/trigger/test_cam_sync_only_at_start.cpp
@@ -0,0 +1,73 @@
+/*
+ * pro-style cam only for sync at start: once the engine runs with phase sync, a cam
+ * tooth in the other crank turn no longer flips the engine phase.
+ */
+
+#include "pch.h"
+
+TEST(CamSyncOnlyAtStart, Decision) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	engineConfiguration->maxCamPhaseResolveRpm = 0;
+
+	engineConfiguration->camSyncOnlyAtStart = false;
+	EXPECT_TRUE(shouldUseCamForPhase(true, true, 3000));
+
+	engineConfiguration->camSyncOnlyAtStart = true;
+	// no phase yet, or still cranking: the cam is used
+	EXPECT_TRUE(shouldUseCamForPhase(false, true, 3000));
+	EXPECT_TRUE(shouldUseCamForPhase(true, false, 200));
+	// running with phase: kept
+	EXPECT_FALSE(shouldUseCamForPhase(true, true, 3000));
+
+	// the existing RPM limit still works
+	engineConfiguration->camSyncOnlyAtStart = false;
+	engineConfiguration->maxCamPhaseResolveRpm = 1500;
+	EXPECT_FALSE(shouldUseCamForPhase(false, false, 2000));
+	EXPECT_TRUE(shouldUseCamForPhase(false, false, 1000));
+}
+
+// one crank tooth per turn (half moon, 1200 RPM), single tooth cam at toothMs of each cycle
+static void runCycles(EngineTestHelper& eth, int toothMs, int cycles) {
+	for (int cycle = 0; cycle < cycles; cycle++) {
+		for (int ms = 0; ms < 100; ms++) {
+			eth.moveTimeForwardUs(MS2US(1));
+			if (ms % 50 == 0) {
+				eth.firePrimaryTriggerRise();
+			} else if (ms % 50 == 25) {
+				eth.firePrimaryTriggerFall();
+			}
+			if (ms == toothMs) {
+				hwHandleVvtCamSignal(TriggerValue::RISE, getTimeNowNt(), 0);
+			}
+		}
+	}
+}
+
+static int phaseFlipsAfterCamMoves(bool onlyAtStart) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	engineConfiguration->triggerInputPins[1] = Gpio::Unassigned;
+	setCrankOperationMode();
+	engineConfiguration->vvtMode[0] = VVT_SINGLE_TOOTH;
+	engineConfiguration->vvtOffsets[0] = 0;
+	eth.setTriggerType(trigger_type_e::TT_HALF_MOON);
+	engineConfiguration->camInputs[0] = Gpio::A10;
+	engineConfiguration->camSyncOnlyAtStart = onlyAtStart;
+
+	runCycles(eth, 12, 20);
+	EXPECT_TRUE(engine->triggerCentral.triggerState.hasSynchronizedPhase());
+	EXPECT_TRUE(engine->rpmCalculator.isRunning());
+	int before = engine->triggerCentral.triggerState.phaseResyncCounter;
+
+	// bad cam signal: the tooth now shows up one crank turn later
+	runCycles(eth, 62, 5);
+	EXPECT_TRUE(engine->triggerCentral.triggerState.hasSynchronizedPhase());
+	return engine->triggerCentral.triggerState.phaseResyncCounter - before;
+}
+
+TEST(CamSyncOnlyAtStart, CamKeepsResyncingByDefault) {
+	EXPECT_GT(phaseFlipsAfterCamMoves(false), 0);
+}
+
+TEST(CamSyncOnlyAtStart, PhaseKeptWhileRunning) {
+	EXPECT_EQ(0, phaseFlipsAfterCamMoves(true));
+}
