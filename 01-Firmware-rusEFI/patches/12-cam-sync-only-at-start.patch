diff --git a/firmware/controllers/trigger/trigger_central.cpp b/firmware/controllers/trigger/trigger_central.cpp
index 94772ac..9e31346 100644
--- a/firmware/controllers/trigger/trigger_central.cpp
+++ b/firmware/controllers/trigger/trigger_central.cpp
@@ -179,12 +179,26 @@ PUBLIC_API_WEAK angle_t customAdjustCustom(TriggerCentral *tc, vvt_mode_e vvtMod
   return 0;
 }
 
-static angle_t adjustCrankPhase(int camIndex) {
+bool shouldUseCamForPhase(bool hasPhaseSync, bool isRunning, float rpm) {
 	float maxSyncThreshold = engineConfiguration->maxCamPhaseResolveRpm;
-	if (maxSyncThreshold != 0 && Sensor::getOrZero(SensorType::Rpm) > maxSyncThreshold) {
+	if (maxSyncThreshold != 0 && rpm > maxSyncThreshold) {
 		// The user has elected to stop trying to resolve crank phase after some RPM.
 		// Maybe their cam sensor only works at low RPM or something.
-		// Anyway, don't try to change crank phase at all, and return that we made no change.
+		return false;
+	}
+
+	// pro-style: phase found at start is kept while the engine runs
+	if (engineConfiguration->camSyncOnlyAtStart && hasPhaseSync && isRunning) {
+		return false;
+	}
+
+	return true;
+}
+
+static angle_t adjustCrankPhase(int camIndex) {
+	if (!shouldUseCamForPhase(getTriggerCentral()->triggerState.hasSynchronizedPhase(),
+			engine->rpmCalculator.isRunning(), Sensor::getOrZero(SensorType::Rpm))) {
+		// don't try to change crank phase at all, and return that we made no change.
 		return 0;
 	}
 
