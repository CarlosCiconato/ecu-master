diff --git a/unit_tests/tests/controllers/test_alert_manager.cpp b/unit_tests/tests/controllers/test_alert_manager.cpp
new file mode 100644
index 0000000..fd46f94
--- /dev/null
+++ b/unit_tests/tests/controllers/test_alert_manager.cpp
@@ -0,0 +1,178 @@
+#include "pch.h"
+
+#include "alert_manager.h"
+#include "limp_manager.h"
+
+// pro-style alert engine: sensor + limit (fixed or RPM curve) + minimum time + action,
+// latched with the alert output until the next engine start.
+
+class AlertManagerTest : public testing::Test {
+protected:
+	EngineTestHelper eth{engine_type_e::TEST_ENGINE};
+
+	AlertManager& alerts() {
+		return engine->module<AlertManager>().unmock();
+	}
+
+	void setRpm(float rpm) {
+		engine->rpmCalculator.setRpmValue(rpm);
+		Sensor::setMockValue(SensorType::Rpm, rpm);
+	}
+
+	void update() {
+		alerts().update(getTimeNowNt());
+	}
+
+	void SetUp() override {
+		engineConfiguration->cranking.rpm = 400;
+		setRpm(3000);
+
+		// Alert 1: low oil pressure, engine off after 0.5 s
+		auto& oil = config->alerts[0];
+		oil.sensor = GPPWM_OilPressure;
+		oil.action = ALERT_ENGINE_OFF;
+		oil.triggerBelow = true;
+		oil.useRpmCurve = false;
+		oil.threshold = 100; // kPa
+		oil.delay = 0.5f;
+		oil.minRpm = 0;
+		Sensor::setMockValue(SensorType::OilPressure, 300);
+	}
+};
+
+TEST_F(AlertManagerTest, TripsOnlyAfterMinimumTime) {
+	update();
+	EXPECT_FALSE(alerts().isTripped(0));
+
+	Sensor::setMockValue(SensorType::OilPressure, 50);
+	update();
+	advanceTimeUs(400'000);
+	update();
+	EXPECT_FALSE(alerts().isTripped(0));
+	EXPECT_EQ(ALERT_OFF, alerts().getLevel());
+
+	advanceTimeUs(200'000);
+	update();
+	EXPECT_TRUE(alerts().isTripped(0));
+	EXPECT_EQ(ALERT_ENGINE_OFF, alerts().getLevel());
+	EXPECT_EQ(1, engine->outputChannels.alertActiveMask);
+	EXPECT_EQ(1, engine->outputChannels.alertLatchedMask);
+	EXPECT_EQ(ALERT_ENGINE_OFF, engine->outputChannels.alertLevel);
+}
+
+TEST_F(AlertManagerTest, ShortGlitchDoesNotTrip) {
+	Sensor::setMockValue(SensorType::OilPressure, 50);
+	update();
+	advanceTimeUs(400'000);
+	update();
+
+	// Back to normal before the delay: the timer restarts
+	Sensor::setMockValue(SensorType::OilPressure, 300);
+	update();
+	Sensor::setMockValue(SensorType::OilPressure, 50);
+	advanceTimeUs(400'000);
+	update();
+	EXPECT_FALSE(alerts().isTripped(0));
+}
+
+TEST_F(AlertManagerTest, LatchedUntilNextStart) {
+	config->alerts[0].delay = 0;
+	Sensor::setMockValue(SensorType::OilPressure, 50);
+	update();
+	ASSERT_TRUE(alerts().isTripped(0));
+
+	// Pressure comes back but the alert stays latched
+	Sensor::setMockValue(SensorType::OilPressure, 300);
+	update();
+	EXPECT_TRUE(alerts().isTripped(0));
+	EXPECT_EQ(0, engine->outputChannels.alertActiveMask);
+	EXPECT_EQ(1, engine->outputChannels.alertLatchedMask);
+
+	// Engine stops: still latched
+	setRpm(0);
+	update();
+	EXPECT_TRUE(alerts().isTripped(0));
+
+	// Next start clears it
+	setRpm(200);
+	ASSERT_TRUE(engine->rpmCalculator.isCranking());
+	update();
+	EXPECT_FALSE(alerts().isTripped(0));
+	EXPECT_EQ(ALERT_OFF, alerts().getLevel());
+}
+
+TEST_F(AlertManagerTest, ArmedOnlyAboveMinRpm) {
+	config->alerts[0].delay = 0;
+	config->alerts[0].minRpm = 1000;
+	Sensor::setMockValue(SensorType::OilPressure, 50);
+
+	setRpm(800);
+	update();
+	EXPECT_FALSE(alerts().isTripped(0));
+
+	setRpm(1500);
+	update();
+	EXPECT_TRUE(alerts().isTripped(0));
+}
+
+TEST_F(AlertManagerTest, LimitByRpmCurve) {
+	config->alerts[0].action = ALERT_OFF;
+
+	// Alert 2: coolant above an RPM dependent limit, warn only
+	auto& clt = config->alerts[1];
+	clt.sensor = GPPWM_Clt;
+	clt.action = ALERT_WARN;
+	clt.triggerBelow = false;
+	clt.useRpmCurve = true;
+	clt.delay = 0;
+	clt.minRpm = 0;
+	setLinearCurve(config->alertRpmBins, 1000, 8000, 1);
+	setArrayValues(clt.curve, 100);
+	clt.curve[2] = 90; // 3000 RPM
+
+	EXPECT_NEAR(90, alerts().getThreshold(1, 3000), EPS4D);
+	EXPECT_NEAR(100, alerts().getThreshold(1, 1000), EPS4D);
+
+	Sensor::setMockValue(SensorType::Clt, 95);
+	setRpm(1000);
+	update();
+	EXPECT_FALSE(alerts().isTripped(1));
+
+	setRpm(3000);
+	update();
+	EXPECT_TRUE(alerts().isTripped(1));
+	EXPECT_EQ(ALERT_WARN, alerts().getLevel());
+	EXPECT_EQ(2, engine->outputChannels.alertLatchedMask);
+}
+
+TEST_F(AlertManagerTest, EngineOffCutsFuelAndSpark) {
+	config->alerts[0].delay = 0;
+	Sensor::setMockValue(SensorType::OilPressure, 50);
+	update();
+
+	getLimpManager()->updateState(3000, getTimeNowNt());
+	auto fuel = getLimpManager()->allowInjection();
+	auto spark = getLimpManager()->allowIgnition();
+	EXPECT_FALSE(fuel.value);
+	EXPECT_EQ(ClearReason::AlertEngineOff, fuel.reason);
+	EXPECT_FALSE(spark.value);
+	EXPECT_EQ(ClearReason::AlertEngineOff, spark.reason);
+}
+
+TEST_F(AlertManagerTest, SafeModeLimitsRpm) {
+	config->alerts[0].delay = 0;
+	config->alerts[0].action = ALERT_SAFE_MODE;
+	engineConfiguration->alertSafeModeRpm = 3000;
+	Sensor::setMockValue(SensorType::OilPressure, 50);
+	update();
+	ASSERT_EQ(ALERT_SAFE_MODE, alerts().getLevel());
+
+	getLimpManager()->updateState(3500, getTimeNowNt());
+	auto fuel = getLimpManager()->allowInjection();
+	EXPECT_FALSE(fuel.value);
+	EXPECT_EQ(ClearReason::AlertSafeMode, fuel.reason);
+	EXPECT_TRUE(getLimpManager()->allowIgnition().value);
+
+	getLimpManager()->updateState(2500, getTimeNowNt());
+	EXPECT_TRUE(getLimpManager()->allowInjection().value);
+}
