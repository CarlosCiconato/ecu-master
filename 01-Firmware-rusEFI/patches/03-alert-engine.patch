diff --git a/firmware/controllers/modules/alerts/alert_manager.cpp b/firmware/controllers/modules/alerts/alert_manager.cpp
new file mode 100644
index 0000000..0f378cd
--- /dev/null
+++ b/firmware/controllers/modules/alerts/alert_manager.cpp
@@ -0,0 +1,94 @@
+#include "pch.h"
+
+#include "alert_manager.h"
+#include "gppwm_channel_reader.h"
+
+static_assert(ALERT_COUNT <= 8, "alert masks are 8 bit");
+
+void AlertManager::setDefaultConfiguration() {
+	engineConfiguration->alertSafeModeRpm = 3000;
+	setLinearCurve(config->alertRpmBins, 1000, 8000, 1);
+	for (size_t i = 0; i < ALERT_COUNT; i++) {
+		config->alerts[i].action = ALERT_OFF;
+	}
+}
+
+float AlertManager::getThreshold(size_t index, float rpm) const {
+	const auto& alert = config->alerts[index];
+	if (alert.useRpmCurve) {
+		return interpolate2d(rpm, config->alertRpmBins, alert.curve);
+	}
+	return alert.threshold;
+}
+
+bool AlertManager::isConditionMet(size_t index, float rpm) const {
+	const auto& alert = config->alerts[index];
+	if (alert.action == ALERT_OFF) {
+		return false;
+	}
+
+	if (alert.minRpm > 0 && rpm < alert.minRpm) {
+		return false;
+	}
+
+	auto value = readGppwmChannel(alert.sensor);
+	if (!value) {
+		// A failed sensor is reported by its own diagnostics, not by the alert
+		return false;
+	}
+
+	float threshold = getThreshold(index, rpm);
+	return alert.triggerBelow ? value.Value < threshold : value.Value > threshold;
+}
+
+void AlertManager::update(efitick_t nowNt) {
+	// Latches hold until the next start
+	bool isCranking = engine->rpmCalculator.isCranking();
+	if (isCranking && !m_wasCranking) {
+		clearLatches();
+	}
+	m_wasCranking = isCranking;
+
+	float rpm = Sensor::getOrZero(SensorType::Rpm);
+
+	m_activeMask = 0;
+	for (size_t i = 0; i < ALERT_COUNT; i++) {
+		if (!isConditionMet(i, rpm)) {
+			m_conditionTimer[i].reset(nowNt);
+			continue;
+		}
+
+		if (m_conditionTimer[i].getElapsedSeconds(nowNt) >= config->alerts[i].delay) {
+			m_activeMask |= 1 << i;
+			m_latchedMask |= 1 << i;
+		}
+	}
+
+	engine->outputChannels.alertActiveMask = m_activeMask;
+	engine->outputChannels.alertLatchedMask = m_latchedMask;
+	engine->outputChannels.alertLevel = getLevel();
+
+	enginePins.alertOutput.setValue(m_latchedMask != 0);
+}
+
+void AlertManager::onFastCallback() {
+	update(getTimeNowNt());
+}
+
+alert_action_e AlertManager::getLevel() const {
+	alert_action_e level = ALERT_OFF;
+	for (size_t i = 0; i < ALERT_COUNT; i++) {
+		if ((m_latchedMask & (1 << i)) && config->alerts[i].action > level) {
+			level = config->alerts[i].action;
+		}
+	}
+	return level;
+}
+
+bool AlertManager::isTripped(size_t index) const {
+	return m_latchedMask & (1 << index);
+}
+
+void AlertManager::clearLatches() {
+	m_latchedMask = 0;
+}
diff --git a/firmware/controllers/modules/alerts/alert_manager.h b/firmware/controllers/modules/alerts/alert_manager.h
new file mode 100644
index 0000000..9fabc05
--- /dev/null
+++ b/firmware/controllers/modules/alerts/alert_manager.h
@@ -0,0 +1,37 @@
+/*
+ * @file alert_manager.h
+ *
+ * Generic alert engine, pro-style: each alert watches one sensor against a fixed
+ * limit or an RPM curve, must stay out of range for a minimum time, and then runs its
+ * action (warn only, safe mode RPM limit, or engine off). A tripped alert stays latched,
+ * with the alert output on, until the next engine start.
+ */
+
+#pragma once
+
+#include <rusefi/timer.h>
+
+class AlertManager : public EngineModule {
+public:
+	using interface_t = AlertManager;
+
+	void setDefaultConfiguration() override;
+	void onFastCallback() override;
+
+	void update(efitick_t nowNt);
+
+	// Most severe action among latched alerts
+	alert_action_e getLevel() const;
+	bool isTripped(size_t index) const;
+	// Threshold in use right now (fixed value or RPM curve)
+	float getThreshold(size_t index, float rpm) const;
+	void clearLatches();
+
+private:
+	bool isConditionMet(size_t index, float rpm) const;
+
+	Timer m_conditionTimer[ALERT_COUNT];
+	uint8_t m_activeMask = 0;
+	uint8_t m_latchedMask = 0;
+	bool m_wasCranking = false;
+};
