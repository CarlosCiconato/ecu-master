+	output_pin_e alertOutputPin;Alert lamp or buzzer. Turns on when any alert trips and stays on until the next engine start.
+	pin_output_mode_e alertOutputPinMode;
+	uint16_t alertSafeModeRpm;RPM limit (fuel cut) while an alert with the Safe mode action is tripped.;"RPM", 1, 0, 0, 15000, 0
+
 struct vvl_s
     int8_t fuelAdderPercent;;"%", 1, 0, 0, 100, 0
 	float ignitionRetard;Retard timing to remove from actual final timing (after all corrections) due to additional air.;"deg", 1, 0, -180, 180, 2
@@ -2610,6 +2614,25 @@ uint16_t[INJ_TIME_RPM_COUNT] injTimeRpmBins;;"RPM", 1, 0, 0, 18000, 0
 ! Progressive rev limiter, see progressiveRevLimitEnabled
