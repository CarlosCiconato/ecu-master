 uint8_t progressiveRevLimitStartCut;Spark cut at the start of the window. It rises linearly to 100% at the rev limit.;"%", 1, 0, 0, 100, 0
+
+! pro-style alert engine, see AlertManager
+#define ALERT_COUNT 8
+#define ALERT_CURVE_SIZE 8
+custom alert_action_e 1 bits, U08, @OFFSET@, [0:1], "Off", "Warn only", "Safe mode", "Engine off"
+
+struct alert_s
+	gppwm_channel_e sensor;Sensor watched by this alert.;
+	alert_action_e action;What happens when the alert trips. Every action also turns on the alert output until the next start.;
+	uint8_t autoscale delay;The condition must last this long before the alert trips.;"s", 0.1, 0, 0, 25, 1
+	bit triggerBelow,"below","above";Trip when the sensor goes below the limit (for example low oil pressure) or above it (for example high temperature).
+	bit useRpmCurve,"RPM curve","fixed";Use a limit that changes with RPM instead of a single value.
+	int16_t autoscale threshold;Fixed limit.;"", 0.1, 0, -3000, 3000, 1
+	uint16_t minRpm;The alert is only armed above this RPM. 0 means always armed.;"RPM", 1, 0, 0, 15000, 0
+	int16_t[ALERT_CURVE_SIZE] autoscale curve;Limit by RPM.;"", 0.1, 0, -3000, 3000, 1
+end_struct
+
+uint16_t[ALERT_CURVE_SIZE] alertRpmBins;;"RPM", 1, 0, 0, 18000, 0
+alert_s[ALERT_COUNT iterate] alerts;
 end_struct
 
