 	case engine_load_mode_e::LM_LUA: return &(getLuaAirmassModel());
 #endif
@@ -186,6 +190,47 @@ float getMaxAirflowAtMap(float map) {
 
 #if EFI_ENGINE_CONTROL
 
+floatms_t getInjectionTimeReferenceDeadtime() {
+	const auto& inj = engineConfiguration->injector;
+	float pressure = engineConfiguration->fuelReferencePressure;
+	if (engineConfiguration->useAbsolutePressureForLagTime) {
+		pressure += STD_ATMOSPHERE;
+	}
+
+	return interpolate3d(
+		inj.battLagCorrTable,
+		inj.battLagCorrPressBins, pressure,
+		inj.battLagCorrBattBins, INJ_TIME_REFERENCE_VOLTAGE
+	);
+}
+
+mass_t convertInjectionTimeToFuelMass(floatms_t pulseMs) {
+	// The table pulse includes the deadtime at 14 V; only the rest of it delivers fuel
+	floatms_t effectiveMs = pulseMs - getInjectionTimeReferenceDeadtime();
+	if (!(effectiveMs > 0)) {
+		return 0;
+	}
+
+	// Base flow (no pressure ratio), so the injector model still compensates fuel pressure
+	return effectiveMs * engine->module<InjectorModelPrimary>()->getBaseFlowRate() * 0.001f;
+}
+
+float getInjectionTimeTableLoad() {
+	return engineConfiguration->injTimeUseTps
+		? Sensor::getOrZero(SensorType::Tps1)
+		: Sensor::getOrZero(SensorType::Map);
+}
+
+mass_t getInjectionTimeTableFuelMass(float rpm) {
+	floatms_t pulseMs = interpolate3d(
+		config->injTimeTable,
+		config->injTimeLoadBins, getInjectionTimeTableLoad(),
+		config->injTimeRpmBins, rpm
+	);
+
+	return convertInjectionTimeToFuelMass(pulseMs);
+}
+
 // Per-cylinder base fuel mass
 static float getBaseFuelMass(float rpm) {
 	ScopePerf perf(PE::GetBaseFuel);
@@ -210,8 +255,14 @@ static float getBaseFuelMass(float rpm) {
 	// convert g/s -> kg/h
 	engine->engineState.airflowEstimate = gramPerMs * 3600000 /* milliseconds per hour */ / 1000 /* grams per kg */;
 
+	// Always run the fuel computer: it publishes the lambda target used by closed loop
 	float baseFuelMass = engine->fuelComputer.getCycleFuel(airmass.CylinderAirmass, rpm, airmass.EngineLoadPercent);
 
+	if (engineConfiguration->fuelAlgorithm == engine_load_mode_e::LM_INJ_TIME) {
+		// pro-style: the ms table is the base fuel, the lambda table only steers closed loop
+		baseFuelMass = getInjectionTimeTableFuelMass(rpm);
+	}
+
 	engine->engineState.baseFuel = baseFuelMass;
 
 	if (std::isnan(baseFuelMass)) {
