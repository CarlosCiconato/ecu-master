@@ -170,6 +170,10 @@ AirmassModelBase* getAirmassModel(engine_load_mode_e mode) {
 	case engine_load_mode_e::LM_SPEED_DENSITY: return &sdAirmass;
 	case engine_load_mode_e::LM_REAL_MAF: return &mafAirmass;
