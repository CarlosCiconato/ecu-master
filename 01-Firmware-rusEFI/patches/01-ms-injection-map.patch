diff --git a/unit_tests/tests/ignition_injection/test_injection_time_map.cpp b/unit_tests/tests/ignition_injection/test_injection_time_map.cpp
new file mode 100644
index 0000000..66fa2fc
--- /dev/null
+++ b/unit_tests/tests/ignition_injection/test_injection_time_map.cpp
@@ -0,0 +1,99 @@
+#include "pch.h"
+#include "fuel_math.h"
+#include "injector_model.h"
+
+// Injection time (ms) fuel strategy: the main table holds the injector pulse,
+// pro-style, and every usual correction still applies on top of it.
+class InjectionTimeMap : public testing::Test {
+protected:
+	EngineTestHelper eth{engine_type_e::TEST_ENGINE};
+
+	void SetUp() override {
+		engineConfiguration->fuelAlgorithm = engine_load_mode_e::LM_INJ_TIME;
+		engineConfiguration->injTimeUseTps = false;
+		engineConfiguration->injectionMode = IM_SEQUENTIAL;
+		engineConfiguration->cylindersCount = 4;
+		engineConfiguration->displacement = 2.0f;
+		engineConfiguration->coastingFuelCutEnabled = false;
+		engineConfiguration->injectorCompensationMode = ICM_None;
+		engineConfiguration->useAbsolutePressureForLagTime = false;
+		// 1 ms deadtime at every voltage and pressure
+		setTable(engineConfiguration->injector.battLagCorrTable, 1.0f);
+
+		setTable(config->veTable, 80);
+		setTable(config->lambdaTable, 1.0f);
+		setArrayValues(config->cltFuelCorr, 1.0f);
+		setArrayValues(config->iatFuelCorr, 1.0f);
+		setTable(config->postCrankingFactor, 1.0f);
+
+		Sensor::setMockValue(SensorType::BatteryVoltage, INJ_TIME_REFERENCE_VOLTAGE);
+		Sensor::setMockValue(SensorType::Clt, 70);
+		Sensor::setMockValue(SensorType::Iat, 20);
+		Sensor::setMockValue(SensorType::Tps1, 0);
+		Sensor::setMockValue(SensorType::Map, 100);
+		Sensor::setMockValue(SensorType::BarometricPressure, STD_ATMOSPHERE);
+		engine->rpmCalculator.setRpmValue(3000);
+	}
+
+	float flowGramPerMs() {
+		return engine->module<InjectorModelPrimary>()->getBaseFlowRate() * 0.001f;
+	}
+};
+
+TEST_F(InjectionTimeMap, PulseToMassRemovesDeadtime) {
+	EXPECT_NEAR(1.0f, getInjectionTimeReferenceDeadtime(), EPS4D);
+	EXPECT_NEAR(4.0f * flowGramPerMs(), convertInjectionTimeToFuelMass(5.0f), 1e-7f);
+
+	// Pulse at or below the deadtime delivers no fuel
+	EXPECT_EQ(0, convertInjectionTimeToFuelMass(1.0f));
+	EXPECT_EQ(0, convertInjectionTimeToFuelMass(0.5f));
+	EXPECT_EQ(0, convertInjectionTimeToFuelMass(0));
+}
+
+TEST_F(InjectionTimeMap, RoundTripAt14Volts) {
+	auto injector = engine->module<InjectorModelPrimary>();
+	injector->prepare();
+
+	for (float ms : {1.5f, 3.0f, 6.0f, 12.5f, 25.0f}) {
+		EXPECT_NEAR(ms, injector->getInjectionDuration(convertInjectionTimeToFuelMass(ms)), 1e-3f) << ms;
+	}
+}
+
+TEST_F(InjectionTimeMap, TableLookupByMapAndTps) {
+	setLinearCurve(config->injTimeLoadBins, 0, 150, 1);
+	setRpmTableBin(config->injTimeRpmBins);
+	for (size_t loadIndex = 0; loadIndex < INJ_TIME_LOAD_COUNT; loadIndex++) {
+		for (size_t rpmIndex = 0; rpmIndex < INJ_TIME_RPM_COUNT; rpmIndex++) {
+			// 0.05 ms per kPa (or % TPS), whatever the RPM
+			config->injTimeTable[loadIndex][rpmIndex] = 1.0f + config->injTimeLoadBins[loadIndex] * 0.05f;
+		}
+	}
+
+	Sensor::setMockValue(SensorType::Map, 100);
+	EXPECT_NEAR(100, getInjectionTimeTableLoad(), EPS4D);
+	EXPECT_NEAR(5.0f * flowGramPerMs(), getInjectionTimeTableFuelMass(3000), 1e-5f);
+
+	engineConfiguration->injTimeUseTps = true;
+	Sensor::setMockValue(SensorType::Tps1, 40);
+	EXPECT_NEAR(40, getInjectionTimeTableLoad(), EPS4D);
+	EXPECT_NEAR(2.0f * flowGramPerMs(), getInjectionTimeTableFuelMass(3000), 1e-5f);
+}
+
+TEST_F(InjectionTimeMap, FinalPulseMatchesTableWhenCorrectionsAreNeutral) {
+	setTable(config->injTimeTable, 6.0f);
+	engine->periodicFastCallback();
+
+	EXPECT_NEAR(6.0f, engine->engineState.injectionDuration, 0.01f);
+	EXPECT_NEAR(5.0f * flowGramPerMs(), engine->engineState.injectionMass[0], 1e-5f);
+	// Lambda target is still published for closed loop
+	EXPECT_NEAR(1.0f, engine->fuelComputer.targetLambda, EPS4D);
+}
+
+TEST_F(InjectionTimeMap, CorrectionsScaleOnlyTheEffectivePulse) {
+	setTable(config->injTimeTable, 6.0f);
+	setArrayValues(config->cltFuelCorr, 1.1f);
+	engine->periodicFastCallback();
+
+	// 1 ms deadtime + 5 ms * 1.1
+	EXPECT_NEAR(6.5f, engine->engineState.injectionDuration, 0.01f);
+}
