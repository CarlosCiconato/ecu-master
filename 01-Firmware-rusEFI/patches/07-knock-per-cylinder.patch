 	uint16_t m_knockFrequencyStart;Start Freq;"Hz", 1, 0, 0, 0, 0
 	float    m_knockFrequencyStep;Step Freq;"Hz", 1, 0, 0, 0, 0
 	float  	 m_knockFuelTrimMultiplier;Fuel trim when knock;"multiplier", 1, 0, 0, 0, 0
+	uint8_t[MAX_CYLINDER_COUNT iterate] autoscale m_knockCylRetard;Cyl retard;"deg", 0.1, 0, 0, 25, 1
 	bit hasKnockRecently;Detected recently
 	bit hasKnockRetardNow;Retard active
 end_struct
diff --git a/firmware/controllers/engine_cycle/knock_logic.h b/firmware/controllers/engine_cycle/knock_logic.h
