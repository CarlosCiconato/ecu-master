From 7d64c1c2ce1e744d84f7b22ebc4717f462ece710 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 25 Oct 2026 19:49:25 +0000
Subject: [PATCH] Per cylinder knock retard (pro-style)

New option knockRetardPerCylinder: knock retard is kept for each cylinder and only the
cylinder that knocked loses timing. Each cylinder has its own limit and reapply. The
shared knock retard shows the highest cylinder, and live data has the retard per cylinder.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TkhsyMr5ndz2MBCxuDZhPC
---
 firmware/controllers/algo/engine2.cpp         |  12 +-
 .../engine_cycle/knock_controller.cpp         |  59 ++++++++--
 .../engine_cycle/knock_controller.txt         |   1 +
 .../controllers/engine_cycle/knock_logic.h    |   7 ++
 firmware/integration/rusefi_config.txt        |   2 +-
 firmware/tunerstudio/tunerstudio.template.ini |   1 +
 unit_tests/tests/test_knock.cpp               | 106 ++++++++++++++++++
 7 files changed, 174 insertions(+), 14 deletions(-)

diff --git a/firmware/controllers/algo/engine2.cpp b/firmware/controllers/algo/engine2.cpp
index 6c332a2..8984e88 100644
--- a/firmware/controllers/algo/engine2.cpp
+++ b/firmware/controllers/algo/engine2.cpp
@@ -118,16 +118,18 @@ void EngineState::periodicFastCallback() {
 	float l_ignitionLoad = getIgnitionLoad();
 	engine->ignitionState.updateAdvanceCorrections(l_ignitionLoad);
 	float baseAdvance = engine->ignitionState.getWrappedAdvance(rpm, l_ignitionLoad);
-	float corrections = engineConfiguration->timingMode == TM_DYNAMIC ?
-			// Pull any extra timing for knock retard
-			- engine->module<KnockController>()->getKnockRetard()
+	bool isDynamicTiming = engineConfiguration->timingMode == TM_DYNAMIC;
+	auto& knock = engine->module<KnockController>().unmock();
+	float corrections = isDynamicTiming ?
 			// Degrees of timing REMOVED from actual timing during soft RPM limit window
 			- getLimpManager()->getLimitingTimingRetard() :
 			0;
+	// Knock retard is applied per cylinder below, it can differ between cylinders
 	float correctedIgnitionAdvance = baseAdvance + corrections;
 	// these fields are scaled_channel so let's only use for observability, with a local variables holding value while it matters locally
 	engine->ignitionState.baseIgnitionAdvance = MAKE_HUMAN_READABLE_ADVANCE(baseAdvance);
-	engine->ignitionState.correctedIgnitionAdvance = MAKE_HUMAN_READABLE_ADVANCE(correctedIgnitionAdvance);
+	engine->ignitionState.correctedIgnitionAdvance = MAKE_HUMAN_READABLE_ADVANCE(
+		correctedIgnitionAdvance - (isDynamicTiming ? knock.getKnockRetard() : 0));
 
 	// compute per-bank fueling
 	for (size_t bankIndex = 0; bankIndex < FT_BANK_COUNT; bankIndex++) {
@@ -151,6 +153,8 @@ void EngineState::periodicFastCallback() {
 		engine->engineState.injectionMass[cylinderIndex] = untrimmedInjectionMass * bankTrim * cylinderTrim * knockTrim;
 
 		angle_t cylinderIgnitionAdvance = correctedIgnitionAdvance
+									// Pull any extra timing for knock retard
+									- (isDynamicTiming ? knock.getKnockRetard(cylinderIndex) : 0)
 									+ getCylinderIgnitionTrim(cylinderIndex, rpm, l_ignitionLoad)
 									// spark hardware latency correction, for implementation details see:
 									// https://github.com/rusefi/rusefi/issues/6832:
diff --git a/firmware/controllers/engine_cycle/knock_controller.cpp b/firmware/controllers/engine_cycle/knock_controller.cpp
index 0a30e92..cd241f5 100644
--- a/firmware/controllers/engine_cycle/knock_controller.cpp
+++ b/firmware/controllers/engine_cycle/knock_controller.cpp
@@ -105,8 +105,15 @@ bool KnockControllerBase::onKnockSenseCompleted(uint8_t cylinderNumber, float db
 			// Adjust knock retard under lock
 			chibios_rt::CriticalSectionLocker csl;
 
-			auto newRetard = m_knockRetard + retardAmount;
-			m_knockRetard = clampF(0.f, newRetard, m_maximumRetard);
+			if (engineConfiguration->knockRetardPerCylinder) {
+				// pro-style: only the cylinder that knocked is retarded
+				auto newRetard = m_cylinderRetard[cylinderNumber] + retardAmount;
+				m_cylinderRetard[cylinderNumber] = clampF(0.f, newRetard, m_maximumRetard);
+			} else {
+				auto newRetard = m_knockRetard + retardAmount;
+				m_knockRetard = clampF(0.f, newRetard, m_maximumRetard);
+			}
+			updateRetardOutputs();
 
 			auto newFuelTrim = m_knockFuelTrimMultiplier + trimFuelAmount;
 			m_knockFuelTrimMultiplier = clampF(0.f, newFuelTrim, maximumFuelTrim);
@@ -120,6 +127,28 @@ float KnockControllerBase::getKnockRetard() const {
 	return m_knockRetard;
 }
 
+float KnockControllerBase::getKnockRetard(size_t cylinderIndex) const {
+	if (engineConfiguration->knockRetardPerCylinder && cylinderIndex < MAX_CYLINDER_COUNT) {
+		return m_cylinderRetard[cylinderIndex];
+	}
+	return m_knockRetard;
+}
+
+// In per cylinder mode m_knockRetard shows the highest cylinder retard, for gauges and logs
+void KnockControllerBase::updateRetardOutputs() {
+	bool perCylinder = engineConfiguration->knockRetardPerCylinder;
+	if (perCylinder) {
+		float highest = 0;
+		for (size_t i = 0; i < MAX_CYLINDER_COUNT; i++) {
+			highest = std::max(highest, m_cylinderRetard[i]);
+		}
+		m_knockRetard = highest;
+	}
+	for (size_t i = 0; i < MAX_CYLINDER_COUNT; i++) {
+		m_knockCylRetard[i] = perCylinder ? m_cylinderRetard[i] : m_knockRetard;
+	}
+}
+
 uint32_t KnockControllerBase::getKnockCount() const {
 	return m_knockCount;
 }
@@ -152,18 +181,30 @@ void KnockControllerBase::onFastCallback() {
 		 if(TPSValue < engineConfiguration->knockSuppressMinTps) {
 		 	m_knockRetard = 0.0;
 		 	m_knockFuelTrimMultiplier = 0.0;
+		 	setArrayValues(m_cylinderRetard, 0.0f);
+		 	updateRetardOutputs();
 		 	return;
 		 }
 
-		// Reduce knock retard at the requested rate
-		float newRetard = m_knockRetard - applyRetardAmount;
-
-		// don't allow retard to go negative
-		if (newRetard < 0) {
-			m_knockRetard = 0;
+		if (engineConfiguration->knockRetardPerCylinder) {
+			// Reapply timing on each cylinder at the requested rate
+			for (size_t i = 0; i < MAX_CYLINDER_COUNT; i++) {
+				m_cylinderRetard[i] = std::max(0.0f, m_cylinderRetard[i] - applyRetardAmount);
+			}
 		} else {
-			m_knockRetard = newRetard;
+			setArrayValues(m_cylinderRetard, 0.0f);
+
+			// Reduce knock retard at the requested rate
+			float newRetard = m_knockRetard - applyRetardAmount;
+
+			// don't allow retard to go negative
+			if (newRetard < 0) {
+				m_knockRetard = 0;
+			} else {
+				m_knockRetard = newRetard;
+			}
 		}
+		updateRetardOutputs();
 
 		// Reduce fuel trim at the requested rate
 		float newTrim = m_knockFuelTrimMultiplier - applyFuelAmount;
diff --git a/firmware/controllers/engine_cycle/knock_controller.txt b/firmware/controllers/engine_cycle/knock_controller.txt
