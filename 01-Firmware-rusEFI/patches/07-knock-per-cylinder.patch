@@ -28,7 +28,10 @@ public:
 	bool onKnockSenseCompleted(uint8_t cylinderNumber, float dbv, efitick_t lastKnockTime);
 
 	float getFuelTrimMultiplier() const;
+	// Highest retard among cylinders
 	float getKnockRetard() const;
+	// Retard for one cylinder: its own in per cylinder mode, else the shared one
+	float getKnockRetard(size_t cylinderIndex) const;
 	uint32_t getKnockCount() const;
 
 	virtual float getKnockThreshold() const = 0;
@@ -42,6 +45,10 @@ private:
 	Timer m_lastKnockTimer;
 
 	int8_t m_gain[MAX_CYLINDER_COUNT];
+
+	// Per cylinder mode only, see knockRetardPerCylinder
+	float m_cylinderRetard[MAX_CYLINDER_COUNT] = {};
+	void updateRetardOutputs();
 };
 
 class KnockController : public KnockControllerBase {
diff --git a/firmware/integration/rusefi_config.txt b/firmware/integration/rusefi_config.txt
index 6177f13..dd9fb7a 100644
--- a/firmware/integration/rusefi_config.txt
+++ b/firmware/integration/rusefi_config.txt
@@ -1871,7 +1871,7 @@ uint8_t autoscale knockFuelTrim;Maximum Amount of Fuel trim when knock;"%", 1, 0
 	bit vvlControlEnabled,"enabled","disabled"
 	bit keepIdleSolenoidWhenStopped,"enabled","disabled";By default the idle solenoid is switched off whenever the engine is not turning, to be quieter and save power. Enable this to keep driving it to the position the idle controller asks for, which at zero RPM is the cranking curve for the current coolant temperature - for valves which need to rest somewhere other than de-energized. The valve is only driven for a minute after the engine stops turning, then switched off anyway to protect the coil and the battery.
 	bit canSnifferIncludeBus,"Yes","No";Include CAN bus in trace using Elmue SLCAN prefixes (CAN1: none, CAN2: &, CAN3: $). Disable for standard SLCAN clients such as SavvyCAN or slcand. Reconnect the sniffer after changing this setting.
-	bit unusedBit_Fancy5
+	bit knockRetardPerCylinder,"per cylinder","all cylinders";pro-style: retard timing only on the cylinder that knocked, instead of on all cylinders.
 	bit unusedBit_Fancy6
 	bit unusedBit_Fancy7
 	bit unusedBit_Fancy8
diff --git a/firmware/tunerstudio/tunerstudio.template.ini b/firmware/tunerstudio/tunerstudio.template.ini
index 4935c44..3d72c70 100644
--- a/firmware/tunerstudio/tunerstudio.template.ini
+++ b/firmware/tunerstudio/tunerstudio.template.ini
@@ -4525,6 +4525,7 @@ include_file @@SECONDARY_PANELS_FILE@@
 		panel = knockCylinderMapping@@if_ts_show_knock_cylinder_mapping
 
 	dialog = softwareKnockResponseCfg, "Response"
+		field = "Retard on",				knockRetardPerCylinder
 		field = "Retard Aggression",		knockRetardAggression
 		field = "Retard Reapply Rate",	knockRetardReapplyRate
 		field = "Fuel Trim Aggression",		knockFuelTrimAggression
diff --git a/unit_tests/tests/test_knock.cpp b/unit_tests/tests/test_knock.cpp
index b5b14fc..6683e86 100644
--- a/unit_tests/tests/test_knock.cpp
+++ b/unit_tests/tests/test_knock.cpp
@@ -248,3 +248,109 @@ TEST(Knock, FuelTrimReapply) {
 	// Should have no knock retard
 	EXPECT_FLOAT_EQ(dut.getFuelTrimMultiplier(), 1.0);
 }
+
+// pro-style per cylinder knock retard, see knockRetardPerCylinder
+
+TEST(Knock, PerCylinderRetardsOnlyKnockingCylinder) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	engineConfiguration->knockRetardPerCylinder = true;
+	engineConfiguration->knockRetardAggression = 10;
+	engineConfiguration->knockSuppressMinTps = 0;
+	setArrayValues(engine->engineState.timingAdvance, 0.0f);
+
+	MockKnockController dut;
+	dut.onFastCallback();
+
+	// strong knock on cylinder 3 only: 10% of the distance from 0 to -20
+	dut.onKnockSenseCompleted(2, 30, 0);
+	EXPECT_FLOAT_EQ(2, dut.getKnockRetard(2));
+	EXPECT_FLOAT_EQ(0, dut.getKnockRetard(0));
+	EXPECT_FLOAT_EQ(0, dut.getKnockRetard(1));
+	EXPECT_FLOAT_EQ(0, dut.getKnockRetard(3));
+	// the shared value shows the highest cylinder retard
+	EXPECT_FLOAT_EQ(2, dut.getKnockRetard());
+	EXPECT_NEAR(2, dut.m_knockCylRetard[2], 0.1);
+	EXPECT_NEAR(0, dut.m_knockCylRetard[0], 0.1);
+
+	// each cylinder is limited on its own
+	for (size_t i = 0; i < 100; i++) {
+		dut.onKnockSenseCompleted(0, 30, 0);
+	}
+	EXPECT_FLOAT_EQ(8, dut.getKnockRetard(0));
+	EXPECT_FLOAT_EQ(2, dut.getKnockRetard(2));
+	EXPECT_FLOAT_EQ(8, dut.getKnockRetard());
+}
+
+TEST(Knock, PerCylinderReapply) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	engineConfiguration->knockRetardPerCylinder = true;
+	engineConfiguration->knockRetardAggression = 10;
+	engineConfiguration->knockRetardReapplyRate = 1;
+	engineConfiguration->knockSuppressMinTps = 0;
+	setArrayValues(engine->engineState.timingAdvance, 0.0f);
+
+	MockKnockController dut;
+	dut.onFastCallback();
+
+	dut.onKnockSenseCompleted(1, 30, 0);
+	dut.onKnockSenseCompleted(1, 30, 0);
+	dut.onKnockSenseCompleted(3, 30, 0);
+	EXPECT_FLOAT_EQ(4, dut.getKnockRetard(1));
+	EXPECT_FLOAT_EQ(2, dut.getKnockRetard(3));
+
+	constexpr auto fastPeriodSec = FAST_CALLBACK_PERIOD_MS / 1000.0f;
+	dut.onFastCallback();
+	EXPECT_FLOAT_EQ(4 - fastPeriodSec, dut.getKnockRetard(1));
+	EXPECT_FLOAT_EQ(2 - fastPeriodSec, dut.getKnockRetard(3));
+	EXPECT_FLOAT_EQ(4 - fastPeriodSec, dut.getKnockRetard());
+
+	for (size_t i = 0; i < 1000; i++) {
+		dut.onFastCallback();
+	}
+	EXPECT_FLOAT_EQ(0, dut.getKnockRetard(1));
+	EXPECT_FLOAT_EQ(0, dut.getKnockRetard(3));
+	EXPECT_FLOAT_EQ(0, dut.getKnockRetard());
+}
+
+TEST(Knock, AllCylindersModeSharesRetard) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	engineConfiguration->knockRetardPerCylinder = false;
+	engineConfiguration->knockRetardAggression = 10;
+	engineConfiguration->knockSuppressMinTps = 0;
+	setArrayValues(engine->engineState.timingAdvance, 0.0f);
+
+	MockKnockController dut;
+	dut.onFastCallback();
+
+	dut.onKnockSenseCompleted(0, 30, 0);
+	EXPECT_FLOAT_EQ(2, dut.getKnockRetard());
+	for (size_t cyl = 0; cyl < 4; cyl++) {
+		EXPECT_FLOAT_EQ(2, dut.getKnockRetard(cyl));
+		EXPECT_NEAR(2, dut.m_knockCylRetard[cyl], 0.1);
+	}
+}
+
+TEST(Knock, PerCylinderRetardReachesIgnitionTiming) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	engineConfiguration->timingMode = TM_DYNAMIC;
+	engineConfiguration->knockRetardPerCylinder = true;
+	engineConfiguration->knockRetardAggression = 10;
+	engineConfiguration->knockRetardReapplyRate = 0;
+	engineConfiguration->knockSuppressMinTps = 0;
+	setArrayValues(config->knockBaseNoise, 20);
+	setTable(config->maxKnockRetardTable, 8);
+	setTable(config->ignitionTable, 15);
+
+	auto& knock = engine->module<KnockController>().unmock();
+	knock.onFastCallback();
+	setArrayValues(engine->engineState.timingAdvance, 0.0f);
+	knock.onKnockSenseCompleted(1, 50, 0);
+	ASSERT_FLOAT_EQ(2, knock.getKnockRetard(1));
+
+	engine->periodicFastCallback();
+
+	EXPECT_NEAR(15, engine->engineState.timingAdvance[0], EPS4D);
+	EXPECT_NEAR(15 - 2, engine->engineState.timingAdvance[1], EPS4D);
+	EXPECT_NEAR(15, engine->engineState.timingAdvance[2], EPS4D);
+	EXPECT_NEAR(15, engine->engineState.timingAdvance[3], EPS4D);
+}
