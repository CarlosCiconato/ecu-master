From 2cb968d26f6269aa08ca35f92083325f53d2bf66 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 26 Oct 2026 10:19:36 +0000
Subject: [PATCH] Cranking timing by coolant temperature (pro-style)

New curve crankingAdvanceCltBins/crankingAdvanceCltAdder adds degrees to the cranking
timing (table or fixed angle) by coolant temperature. Default is all zeros, so no change;
a failed CLT sensor adds nothing.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TkhsyMr5ndz2MBCxuDZhPC
---
 .../algo/defaults/default_cranking.cpp        |  4 +++
 .../algo/ignition/ignition_state.cpp          | 15 +++++++--
 firmware/integration/rusefi_config.txt        |  2 ++
 firmware/tunerstudio/tunerstudio.template.ini |  9 +++++
 .../test_ignition_state.cpp                   | 33 +++++++++++++++++++
 5 files changed, 61 insertions(+), 2 deletions(-)

diff --git a/firmware/controllers/algo/defaults/default_cranking.cpp b/firmware/controllers/algo/defaults/default_cranking.cpp
index aa5fa75..5f06725 100644
--- a/firmware/controllers/algo/defaults/default_cranking.cpp
+++ b/firmware/controllers/algo/defaults/default_cranking.cpp
@@ -35,6 +35,10 @@ void setDefaultCranking() {
 	setLinearCurve(config->cltCrankingCorrBins, CLT_CURVE_RANGE_FROM, 100, 1);
 	setLinearCurve(config->cltCrankingCorr, 50, 50, 1); // now as % of idle valve/etb
 
+	// cranking timing by CLT: no change by default
+	setLinearCurve(config->crankingAdvanceCltBins, -40, 100, 1);
+	setArrayValues(config->crankingAdvanceCltAdder, 0);
+
 #if CRANKING_CURVE_SIZE == 8
 	// Cranking temperature compensation
 	static const float crankingCoef[] = {
diff --git a/firmware/controllers/algo/ignition/ignition_state.cpp b/firmware/controllers/algo/ignition/ignition_state.cpp
index 07bd730..d964085 100644
--- a/firmware/controllers/algo/ignition/ignition_state.cpp
+++ b/firmware/controllers/algo/ignition/ignition_state.cpp
@@ -234,16 +234,27 @@ angle_t getAdvanceCorrections(float engineLoad) {
 /**
  * @return ignition timing angle advance before TDC for Cranking
  */
+static angle_t getCrankingAdvanceCltAdder() {
+	// pro-style cranking timing by coolant temperature, 0 = no change
+	auto clt = Sensor::get(SensorType::Clt);
+	if (!clt.Valid) {
+		return 0;
+	}
+	return interpolate2d(clt.Value, config->crankingAdvanceCltBins, config->crankingAdvanceCltAdder);
+}
+
 angle_t getCrankingAdvance(float rpm, float engineLoad) {
+	angle_t cltAdder = getCrankingAdvanceCltAdder();
+
 	// get advance from the separate table for Cranking
 	if (engineConfiguration->useSeparateAdvanceForCranking) {
-		return interpolate2d(rpm, config->crankingAdvanceBins, config->crankingAdvance);
+		return interpolate2d(rpm, config->crankingAdvanceBins, config->crankingAdvance) + cltAdder;
 	}
 
 	// Interpolate the cranking timing angle to the earlier running angle for faster engine start
 	angle_t crankingToRunningTransitionAngle = getRunningAdvance(engineConfiguration->cranking.rpm, engineLoad);
 	// interpolate not from zero, but starting from min. possible rpm detected
-	return interpolateClamped(engine->rpmCalculator.getMinCrankingRpm(), engineConfiguration->crankingTimingAngle, engineConfiguration->cranking.rpm, crankingToRunningTransitionAngle, rpm);
+	return interpolateClamped(engine->rpmCalculator.getMinCrankingRpm(), engineConfiguration->crankingTimingAngle + cltAdder, engineConfiguration->cranking.rpm, crankingToRunningTransitionAngle, rpm);
 }
 #endif // EFI_ENGINE_CONTROL && EFI_SHAFT_POSITION_INPUT
 
