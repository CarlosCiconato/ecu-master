+
+// pro-style auto recovery: the throttle turns back on by itself after a latched fault
+static EtbController* initEtbAutoRecoverTest() {
+	Sensor::setMockValue(SensorType::AcceleratorPedal, 10, true);
+	EtbController *etb = initEtbIntegratedTest();
+	// ETB controllers are global, start from a clean state
+	etb->etbAutoRecoverCount = 0;
+	etb->etbTpsErrorCounter = 0;
+	etb->etbPpsErrorCounter = 0;
+
+	engine->module<SensorChecker>()->onIgnitionStateChanged(true);
+	engine->module<SensorChecker>()->onSlowCallback();
+	advanceTimeUs(MS2US(6000));
+	engine->module<SensorChecker>()->onSlowCallback();
+
+	engineConfiguration->etbAutoRecoverEnabled = true;
+	engineConfiguration->etbAutoRecoverDelay = 1;
+	engineConfiguration->etbAutoRecoverMaxTries = 2;
+	return etb;
+}
+
+static void makeTpsIntermittent(EtbController *etb) {
+	for (size_t i = 0; i < 51; i++) {
+		Sensor::setInvalidMockValue(SensorType::Tps1);
+		etb->update();
+		Sensor::setMockValue(SensorType::Tps1, 20);
+		etb->update();
+	}
+}
+
+TEST(etb, autoRecoverAfterIntermittentTps) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	EtbController *etb = initEtbAutoRecoverTest();
+
+	makeTpsIntermittent(etb);
+	EXPECT_EQ((int)EtbStatus::IntermittentTps, etb->etbErrorCode);
+
+	// sensors fine, but not long enough yet
+	advanceTimeUs(MS2US(500));
+	etb->update();
+	EXPECT_EQ((int)EtbStatus::IntermittentTps, etb->etbErrorCode);
+	EXPECT_EQ(0, etb->etbAutoRecoverCount);
+
+	advanceTimeUs(MS2US(600));
+	etb->update();
+	EXPECT_EQ(1, etb->etbAutoRecoverCount);
+	EXPECT_EQ(0, etb->etbTpsErrorCounter);
+	etb->update();
+	EXPECT_EQ(0, etb->etbErrorCode);
+
+	// second fault, second recovery
+	makeTpsIntermittent(etb);
+	advanceTimeUs(MS2US(1100));
+	etb->update();
+	EXPECT_EQ(2, etb->etbAutoRecoverCount);
+	etb->update();
+	EXPECT_EQ(0, etb->etbErrorCode);
+
+	// out of tries: stays off
+	makeTpsIntermittent(etb);
+	advanceTimeUs(MS2US(5000));
+	etb->update();
+	etb->update();
+	EXPECT_EQ(2, etb->etbAutoRecoverCount);
+	EXPECT_EQ((int)EtbStatus::IntermittentTps, etb->etbErrorCode);
+}
+
+TEST(etb, noAutoRecoverWhileSensorStillBad) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	EtbController *etb = initEtbAutoRecoverTest();
+
+	makeTpsIntermittent(etb);
+	Sensor::setInvalidMockValue(SensorType::Tps1);
+	advanceTimeUs(MS2US(5000));
+	etb->update();
+	EXPECT_EQ(0, etb->etbAutoRecoverCount);
+	EXPECT_NE(0, etb->etbErrorCode);
+}
+
+TEST(etb, autoRecoverOffKeepsFaultLatched) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	EtbController *etb = initEtbAutoRecoverTest();
+	engineConfiguration->etbAutoRecoverEnabled = false;
+
+	makeTpsIntermittent(etb);
+	advanceTimeUs(MS2US(5000));
+	etb->update();
+	EXPECT_EQ(0, etb->etbAutoRecoverCount);
+	EXPECT_EQ((int)EtbStatus::IntermittentTps, etb->etbErrorCode);
+}
+
+TEST(etb, autoRecoverAfterJam) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	EtbController *etb = initEtbAutoRecoverTest();
+
+	getLimpManager()->reportEtbJammed();
+	ASSERT_FALSE(getLimpManager()->allowElectronicThrottle());
+	etb->update();
+	EXPECT_EQ((int)EtbStatus::JamDetected, etb->etbErrorCode);
+
+	advanceTimeUs(MS2US(1100));
+	etb->update();
+	EXPECT_EQ(1, etb->etbAutoRecoverCount);
+	EXPECT_TRUE(getLimpManager()->allowElectronicThrottle());
+	EXPECT_EQ(ClearReason::None, getLimpManager()->getEtbClearReason());
+	etb->update();
+	EXPECT_EQ(0, etb->etbErrorCode);
+}
