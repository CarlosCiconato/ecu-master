 }
 
+void LimpManager::clearEtbJam() {
+	// a fatal error is never cleared
+	if (m_allowEtb.clearReason == ClearReason::EtbProblem) {
+		m_allowEtb.reset();
+	}
+	if (m_rpmLimitReason == ClearReason::EtbJammedRevLimit) {
+		m_faultRevLimit = INT32_MAX;
+		m_rpmLimitReason = ClearReason::None;
+	}
+}
+
 void LimpManager::fatalError() {
 	m_allowEtb.clear(ClearReason::Fatal);
 	m_allowIgnition.clear(ClearReason::Fatal);
