diff --git a/firmware/controllers/actuators/electronic_throttle.cpp b/firmware/controllers/actuators/electronic_throttle.cpp
index 925cd0d..5684feb 100644
--- a/firmware/controllers/actuators/electronic_throttle.cpp
+++ b/firmware/controllers/actuators/electronic_throttle.cpp
@@ -678,11 +678,43 @@ bool EtbController::checkStatus() {
 		localReason = EtbStatus::Redundancy;
 	}
 
+	tryAutoRecover(localReason);
+
 	etbErrorCode = (int8_t)localReason;
 
 	return localReason == EtbStatus::None;
 }
 
+void EtbController::tryAutoRecover(EtbStatus reason) {
+	bool isLatchedFault = reason == EtbStatus::IntermittentTps
+		|| reason == EtbStatus::IntermittentPps
+		|| (reason == EtbStatus::JamDetected
+			&& getLimpManager()->getEtbClearReason() == ClearReason::EtbProblem);
+	bool sensorsFine = Sensor::get(m_positionSensor).Valid
+		&& Sensor::get(SensorType::AcceleratorPedal).Valid;
+	bool triesLeft = engineConfiguration->etbAutoRecoverMaxTries == 0
+		|| etbAutoRecoverCount < engineConfiguration->etbAutoRecoverMaxTries;
+
+	if (!engineConfiguration->etbAutoRecoverEnabled || !isLatchedFault || !sensorsFine || !triesLeft) {
+		m_autoRecoverTimer.reset();
+		return;
+	}
+
+	if (!m_autoRecoverTimer.hasElapsedSec(engineConfiguration->etbAutoRecoverDelay)) {
+		return;
+	}
+
+	// turn back on: the next error starts counting from zero again
+	etbTpsErrorCounter = 0;
+	etbPpsErrorCounter = 0;
+	jamDetected = false;
+	m_jamDetectTimer.reset();
+	getLimpManager()->clearEtbJam();
+	etbAutoRecoverCount++;
+	m_autoRecoverTimer.reset();
+	efiPrintf("ETB turned back on after a fault, %d time(s)", etbAutoRecoverCount);
+}
+
 void EtbController::update() {
 #if !EFI_UNIT_TEST
 	// If we didn't get initialized, fail fast
@@ -880,6 +912,10 @@ void setBoschVNH2SP30Curve() {
 void setDefaultEtbParameters() {
 	engineConfiguration->etbIdleThrottleRange = 15;
 
+	// auto recovery is off by default; when on, 2 s of good sensors and up to 3 times
+	engineConfiguration->etbAutoRecoverDelay = 2;
+	engineConfiguration->etbAutoRecoverMaxTries = 3;
+
 	setLinearCurve(config->pedalToTpsPedalBins, /*from*/0, /*to*/100, 1);
 	setRpmTableBin(config->pedalToTpsRpmBins);
 
