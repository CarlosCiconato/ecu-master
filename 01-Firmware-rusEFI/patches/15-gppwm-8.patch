index 77f9a4c..7956b9f 100644
--- a/unit_tests/tests/actuators/test_gppwm.cpp
+++ b/unit_tests/tests/actuators/test_gppwm.cpp
@@ -218,3 +218,29 @@ TEST(GpPwmCoverage, NaNTableResultAppliesErrorDutyToSwitchHysteresis) {
 	EXPECT_FLOAT_EQ(0, ch.update(0).Result);
 	EXPECT_FLOAT_EQ(100, ch.update(0).Result);
 }
+
+// pro-style: 8 general purpose PWM outputs instead of 4
+TEST(GpPwm, EightChannels) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+
+	EXPECT_EQ(8u, efi::size(engineConfiguration->gppwm));
+	EXPECT_EQ(8u, efi::size(engine->outputChannels.gppwmOutput));
+
+	auto& cfg = engineConfiguration->gppwm[7];
+	cfg.pin = Gpio::A7;
+	cfg.pwmFrequency = 0;
+	cfg.onAboveDuty = 60;
+	cfg.offBelowDuty = 50;
+	cfg.rpmAxis = GPPWM_Rpm;
+	cfg.loadAxis = GPPWM_Tps;
+	setTable(cfg.table, 80);
+	initGpPwm();
+
+	Sensor::setMockValue(SensorType::Rpm, 2000);
+	Sensor::setMockValue(SensorType::Tps1, 30);
+	updateGppwm();
+
+	EXPECT_NEAR(80, engine->outputChannels.gppwmOutput[7], 0.5);
+	EXPECT_NEAR(2000, engine->outputChannels.gppwmXAxis[7], 1);
+	EXPECT_NEAR(30, engine->outputChannels.gppwmYAxis[7], 0.1);
+}
