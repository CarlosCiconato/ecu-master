diff --git a/unit_tests/tests/controllers/test_ltft_injection_time.cpp b/unit_tests/tests/controllers/test_ltft_injection_time.cpp
new file mode 100644
index 0000000..9f013fe
--- /dev/null
+++ b/unit_tests/tests/controllers/test_ltft_injection_time.cpp
@@ -0,0 +1,109 @@
+#include "pch.h"
+#include "fuel_math.h"
+
+// LTFT on top of the Injection time (ms) main table: trims follow the ms table
+// axes (RPM x MAP or TPS) and "Apply" writes into the ms table, not VE.
+
+#define ITERATE_TIME(time, action)	\
+	for (size_t i = 0; i < (time * 1000 / FAST_CALLBACK_PERIOD_MS); i++) { \
+		(action); \
+	}
+
+class LtftInjectionTime : public testing::Test {
+protected:
+	EngineTestHelper eth{engine_type_e::TEST_ENGINE};
+	LtftState ltftState;
+	LongTermFuelTrim ltft;
+
+	void SetUp() override {
+		ltftState.load();
+		ltft.init(&ltftState);
+
+		engineConfiguration->fuelAlgorithm = engine_load_mode_e::LM_INJ_TIME;
+		engineConfiguration->ltft.enabled = true;
+		engineConfiguration->ltft.correctionEnabled = true;
+		engineConfiguration->ltft.deadband = 0.5; // %
+		engineConfiguration->ltft.maxAdd = 15.0; // %
+		engineConfiguration->ltft.maxRemove = 5; // %
+		engineConfiguration->ltft.timeConstant[ftRegionCruise] = 30; // seconds
+
+		// Axes deliberately different from the VE table ones
+		setLinearCurve(config->injTimeLoadBins, 0, 150, 1);
+		setLinearCurve(config->injTimeRpmBins, 500, 8000, 1);
+
+		// 1 ms deadtime everywhere
+		engineConfiguration->useAbsolutePressureForLagTime = false;
+		setTable(engineConfiguration->injector.battLagCorrTable, 1.0f);
+	}
+};
+
+TEST_F(LtftInjectionTime, LearnsOnMsTableAxesWithTps) {
+	engineConfiguration->injTimeUseTps = true;
+
+	float rpm = config->injTimeRpmBins[5];
+	Sensor::setMockValue(SensorType::Tps1, config->injTimeLoadBins[3]);
+	// The VE fuel load is ignored in this mode
+	float veFuelLoad = 999;
+
+	ClosedLoopFuelResult clInput;
+	clInput.region = ftRegionCruise;
+	clInput.banks[0] = clInput.banks[1] = 1.5;
+	ITERATE_TIME(100, ltft.learn(clInput, rpm, veFuelLoad))
+
+	EXPECT_TRUE(ltft.ltftLearning);
+	EXPECT_FLOAT_EQ(0.15f, ltftState.trims[0][3][5]);
+	EXPECT_FLOAT_EQ(0.15f, ltftState.trims[1][3][5]);
+	EXPECT_FLOAT_EQ(1.15f, ltft.getTrims(rpm, veFuelLoad).banks[0]);
+
+	// Another TPS cell is not affected
+	Sensor::setMockValue(SensorType::Tps1, config->injTimeLoadBins[10]);
+	EXPECT_FLOAT_EQ(1.0f, ltft.getTrims(rpm, veFuelLoad).banks[0]);
+}
+
+TEST_F(LtftInjectionTime, LearnsOnMsTableAxesWithMap) {
+	engineConfiguration->injTimeUseTps = false;
+
+	float rpm = config->injTimeRpmBins[2];
+	Sensor::setMockValue(SensorType::Map, config->injTimeLoadBins[8]);
+
+	ClosedLoopFuelResult clInput;
+	clInput.region = ftRegionCruise;
+	clInput.banks[0] = clInput.banks[1] = 0.5;
+	ITERATE_TIME(100, ltft.learn(clInput, rpm, 0))
+
+	EXPECT_FLOAT_EQ(-0.05f, ltftState.trims[0][8][2]);
+	EXPECT_FLOAT_EQ(0.95f, ltft.getTrims(rpm, 0).banks[0]);
+}
+
+TEST_F(LtftInjectionTime, ApplyScalesOnlyEffectivePulse) {
+	setTable(config->injTimeTable, 6.0f);
+	setTable(config->veTable, 80);
+	ltftState.trims[0][2][4] = 0.1f;
+	ltftState.trims[1][2][4] = 0.1f;
+	// Pulse below the deadtime stays as it is
+	config->injTimeTable[7][7] = 0.8f;
+	ltftState.trims[0][7][7] = 0.1f;
+	ltftState.trims[1][7][7] = 0.1f;
+
+	ltftState.applyToVe();
+
+	// 1 ms deadtime + 5 ms * 1.1
+	EXPECT_NEAR(6.5f, config->injTimeTable[2][4], 0.001f);
+	EXPECT_NEAR(6.0f, config->injTimeTable[2][5], 0.001f);
+	EXPECT_NEAR(0.8f, config->injTimeTable[7][7], 0.001f);
+	// VE is not touched in this mode
+	EXPECT_NEAR(80, config->veTable[2][4], 0.01f);
+}
+
+TEST_F(LtftInjectionTime, VeModeStillAppliesToVe) {
+	engineConfiguration->fuelAlgorithm = engine_load_mode_e::LM_SPEED_DENSITY;
+	setTable(config->injTimeTable, 6.0f);
+	setTable(config->veTable, 80);
+	ltftState.trims[0][2][4] = 0.1f;
+	ltftState.trims[1][2][4] = 0.1f;
+
+	ltftState.applyToVe();
+
+	EXPECT_NEAR(88, config->veTable[2][4], 0.01f);
+	EXPECT_NEAR(6.0f, config->injTimeTable[2][4], 0.001f);
+}
