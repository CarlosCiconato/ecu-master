--- a/firmware/controllers/long_term_fuel_trim.cpp
+++ b/firmware/controllers/long_term_fuel_trim.cpp
@@ -12,6 +12,7 @@
 #include "storage.h"
 
 #include "long_term_fuel_trim.h"
+#include "fuel_math.h"
 
 #include "board_overrides.h"
 
@@ -28,6 +29,26 @@ static LtftState ltftState;
 // LTFT to VE table custom apply algo
 std::optional<setup_custom_board_overrides_type> custom_board_LtftTrimToVeApply;
 
+// The trims share one grid with the main fuel table: VE, or the Injection time (ms) table
+static_assert(INJ_TIME_LOAD_COUNT == VE_LOAD_COUNT && INJ_TIME_RPM_COUNT == VE_RPM_COUNT,
+	"LTFT trims grid must match the Injection time (ms) table");
+
+static bool isInjectionTimeFueling() {
+	return engineConfiguration->fuelAlgorithm == engine_load_mode_e::LM_INJ_TIME;
+}
+
+// In Injection time (ms) mode the trims follow the ms table axes and its own load (MAP or TPS)
+static float getTrimsLoad(float fuelLoad) {
+	return isInjectionTimeFueling() ? getInjectionTimeTableLoad() : fuelLoad;
+}
+
+static float interpolateTrims(const float (&trims)[VE_LOAD_COUNT][VE_RPM_COUNT], float load, float rpm) {
+	if (isInjectionTimeFueling()) {
+		return interpolate3d(trims, config->injTimeLoadBins, load, config->injTimeRpmBins, rpm);
+	}
+	return interpolate3d(trims, config->veLoadBins, load, config->veRpmBins, rpm);
+}
+
 bool LtftState::save() {
 #if EFI_PROD_CODE
 	StorageStatus status = storageWrite(EFI_LTFT_RECORD_ID, (const uint8_t *)trims, sizeof(trims));
@@ -72,6 +93,10 @@ void LtftState::applyToVe() {
 		return;
 	}
 
+	// The ms table pulse includes the deadtime: only the effective part is scaled,
+	// the same way the trims are applied at runtime
+	floatms_t deadtime = isInjectionTimeFueling() ? getInjectionTimeReferenceDeadtime() : 0;
+
 	for (size_t loadIndex = 0; loadIndex < VE_LOAD_COUNT; loadIndex++) {
 		for (size_t rpmIndex = 0; rpmIndex < VE_RPM_COUNT; rpmIndex++) {
 			float k = 0;
@@ -82,6 +107,14 @@ void LtftState::applyToVe() {
 			}
 			k = k / FT_BANK_COUNT;
 
+			if (isInjectionTimeFueling()) {
+				float pulseMs = config->injTimeTable[loadIndex][rpmIndex];
+				if (pulseMs > deadtime) {
+					config->injTimeTable[loadIndex][rpmIndex] = deadtime + (pulseMs - deadtime) * k;
+				}
+				continue;
+			}
+
 			config->veTable[loadIndex][rpmIndex] = config->veTable[loadIndex][rpmIndex] * k;
 		}
 	}
@@ -137,8 +170,13 @@ void LongTermFuelTrim::learn(ClosedLoopFuelResult clResult, float rpm, float fue
 
 	// TODO: should we swap x and y here to keep aligned to wierd TS table definition?
 	// x - load, y - rpm
-	auto x = priv::getClosestBin(fuelLoad, config->veLoadBins);
-	auto y = priv::getClosestBin(rpm, config->veRpmBins);
+	float load = getTrimsLoad(fuelLoad);
+	auto x = isInjectionTimeFueling()
+		? priv::getClosestBin(load, config->injTimeLoadBins)
+		: priv::getClosestBin(load, config->veLoadBins);
+	auto y = isInjectionTimeFueling()
+		? priv::getClosestBin(rpm, config->injTimeRpmBins)
+		: priv::getClosestBin(rpm, config->veRpmBins);
 
 	// Skip learning if current load point falls far outside the table
 	if ((abs(x.Frac) > 0.5) ||
@@ -236,11 +274,7 @@ ClosedLoopFuelResult LongTermFuelTrim::getTrims(float rpm, float fuelLoad) {
 	// Is there any reason we should not apply LTFT?
 
 	for (size_t bank = 0; bank < FT_BANK_COUNT; bank++) {
-		ltftCorrection[bank] = 1.0f + interpolate3d(
-			m_state->trims[bank],
-			config->veLoadBins, fuelLoad,
-			config->veRpmBins, rpm
-		);
+		ltftCorrection[bank] = 1.0f + interpolateTrims(m_state->trims[bank], getTrimsLoad(fuelLoad), rpm);
 	}
 
 	ClosedLoopFuelResult result;
