@@ -2,6 +2,7 @@
 
 #include "alert_manager.h"
 #include "limp_manager.h"
+#include "gppwm_channel_reader.h"
 
 // pro-style alert engine: sensor + limit (fixed or RPM curve) + minimum time + action,
 // latched with the alert output until the next engine start.
@@ -176,3 +177,96 @@ TEST_F(AlertManagerTest, SafeModeLimitsRpm) {
 	getLimpManager()->updateState(2500, getTimeNowNt());
 	EXPECT_TRUE(getLimpManager()->allowInjection().value);
 }
+
+// Items 40/41: fuel pressure and per-cylinder EGT alerts
+TEST_F(AlertManagerTest, EgtSensorsForEachCylinder) {
+	Sensor::setMockValue(SensorType::EGT3, 650);
+	Sensor::setMockValue(SensorType::EGT8, 720);
+	EXPECT_NEAR(650, readGppwmChannel(GPPWM_Egt3).value_or(0), 0.01);
+	EXPECT_NEAR(720, readGppwmChannel(GPPWM_Egt8).value_or(0), 0.01);
+	EXPECT_FALSE(readGppwmChannel(GPPWM_Egt5).Valid);
+
+	// hottest cylinder, failed sensors left out
+	EXPECT_NEAR(720, readGppwmChannel(GPPWM_EgtMax).value_or(0), 0.01);
+	Sensor::setMockValue(SensorType::EGT4, 910);
+	EXPECT_NEAR(910, readGppwmChannel(GPPWM_EgtMax).value_or(0), 0.01);
+}
+
+TEST_F(AlertManagerTest, NoEgtSensorMeansNoEgtMax) {
+	EXPECT_FALSE(readGppwmChannel(GPPWM_EgtMax).Valid);
+}
+
+TEST_F(AlertManagerTest, FuelPressureDifferential) {
+	Sensor::setMockValue(SensorType::Map, 150);
+	Sensor::setMockValue(SensorType::BarometricPressure, 100);
+
+	engineConfiguration->fuelPressureSensorMode = FPM_Absolute;
+	Sensor::setMockValue(SensorType::FuelPressureInjector, 400);
+	EXPECT_NEAR(250, readGppwmChannel(GPPWM_FuelPressureDiff).value_or(0), 0.01);
+
+	engineConfiguration->fuelPressureSensorMode = FPM_Gauge;
+	Sensor::setMockValue(SensorType::FuelPressureInjector, 300);
+	EXPECT_NEAR(250, readGppwmChannel(GPPWM_FuelPressureDiff).value_or(0), 0.01);
+
+	engineConfiguration->fuelPressureSensorMode = FPM_Differential;
+	EXPECT_NEAR(300, readGppwmChannel(GPPWM_FuelPressureDiff).value_or(0), 0.01);
+
+	// failed MAP: no reading unless the sensor is differential
+	Sensor::setInvalidMockValue(SensorType::Map);
+	EXPECT_TRUE(readGppwmChannel(GPPWM_FuelPressureDiff).Valid);
+	engineConfiguration->fuelPressureSensorMode = FPM_Absolute;
+	EXPECT_FALSE(readGppwmChannel(GPPWM_FuelPressureDiff).Valid);
+}
+
+TEST_F(AlertManagerTest, LowFuelPressureDifferentialTrips) {
+	auto& fuel = config->alerts[1];
+	fuel.sensor = GPPWM_FuelPressureDiff;
+	fuel.action = ALERT_SAFE_MODE;
+	fuel.triggerBelow = true;
+	fuel.useRpmCurve = false;
+	fuel.threshold = 250; // kPa above MAP
+	fuel.delay = 0.2f;
+	fuel.minRpm = 1000;
+
+	engineConfiguration->fuelPressureSensorMode = FPM_Absolute;
+	Sensor::setMockValue(SensorType::Map, 200);
+	Sensor::setMockValue(SensorType::FuelPressureInjector, 500); // 300 kPa above MAP
+	update();
+	advanceTimeUs(300'000);
+	update();
+	EXPECT_FALSE(alerts().isTripped(1));
+
+	// boost goes up, fuel pressure does not follow
+	Sensor::setMockValue(SensorType::Map, 280); // 220 kPa above MAP
+	update();
+	advanceTimeUs(300'000);
+	update();
+	EXPECT_TRUE(alerts().isTripped(1));
+	EXPECT_EQ(ALERT_SAFE_MODE, alerts().getLevel());
+}
+
+TEST_F(AlertManagerTest, HotCylinderTrips) {
+	auto& egt = config->alerts[2];
+	egt.sensor = GPPWM_EgtMax;
+	egt.action = ALERT_WARN;
+	egt.triggerBelow = false;
+	egt.useRpmCurve = false;
+	egt.threshold = 900; // C
+	egt.delay = 0.1f;
+	egt.minRpm = 0;
+
+	for (auto t : { SensorType::EGT1, SensorType::EGT2, SensorType::EGT3, SensorType::EGT4 }) {
+		Sensor::setMockValue(t, 800);
+	}
+	update();
+	advanceTimeUs(200'000);
+	update();
+	EXPECT_FALSE(alerts().isTripped(2));
+
+	Sensor::setMockValue(SensorType::EGT3, 950);
+	update();
+	advanceTimeUs(200'000);
+	update();
+	EXPECT_TRUE(alerts().isTripped(2));
+	EXPECT_EQ(ALERT_WARN, alerts().getLevel());
+}
