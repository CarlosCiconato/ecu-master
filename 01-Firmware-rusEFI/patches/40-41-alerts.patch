--- a/firmware/controllers/actuators/gppwm_channel_reader.cpp
+++ b/firmware/controllers/actuators/gppwm_channel_reader.cpp
@@ -6,6 +6,39 @@
 #include "throttle_model.h"
 #include "gppwm_channel_reader.h"
 
+// fuel pressure above manifold pressure, from the fuel pressure sensor whatever the injector compensation mode
+static expected<float> readFuelPressureDiff() {
+	auto fps = Sensor::get(SensorType::FuelPressureInjector);
+	if (!fps) {
+		return unexpected;
+	}
+	if (engineConfiguration->fuelPressureSensorMode == FPM_Differential) {
+		return fps.Value;
+	}
+	auto map = Sensor::get(SensorType::Map);
+	if (!map) {
+		return unexpected;
+	}
+	if (engineConfiguration->fuelPressureSensorMode == FPM_Gauge) {
+		auto baro = Sensor::get(SensorType::BarometricPressure);
+		float baroKpa = (baro && baro.Value > 50 && baro.Value < 120) ? baro.Value : STD_ATMOSPHERE;
+		return fps.Value + baroKpa - map.Value;
+	}
+	return fps.Value - map.Value;
+}
+
+// hottest cylinder, only working EGT sensors count
+static expected<float> readEgtMax() {
+	expected<float> result = unexpected;
+	for (int i = 0; i < 8; i++) {
+		auto egt = Sensor::get(static_cast<SensorType>(static_cast<int>(SensorType::EGT1) + i));
+		if (egt && (!result || egt.Value > result.Value)) {
+			result = egt.Value;
+		}
+	}
+	return result;
+}
+
 expected<float> readGppwmChannel(gppwm_channel_e channel) {
 	switch (channel) {
 	case GPPWM_Zero:
@@ -90,6 +123,22 @@ expected<float> readGppwmChannel(gppwm_channel_e channel) {
 		return Sensor::get(SensorType::OilTemperature);
 	case GPPWM_FuelPressure:
 		return Sensor::get(SensorType::FuelPressureInjector);
+	case GPPWM_Egt3:
+		return Sensor::get(SensorType::EGT3);
+	case GPPWM_Egt4:
+		return Sensor::get(SensorType::EGT4);
+	case GPPWM_Egt5:
+		return Sensor::get(SensorType::EGT5);
+	case GPPWM_Egt6:
+		return Sensor::get(SensorType::EGT6);
+	case GPPWM_Egt7:
+		return Sensor::get(SensorType::EGT7);
+	case GPPWM_Egt8:
+		return Sensor::get(SensorType::EGT8);
+	case GPPWM_FuelPressureDiff:
+		return readFuelPressureDiff();
+	case GPPWM_EgtMax:
+		return readEgtMax();
 	case GPPWM_ThrottleRatio:
 #if EFI_ENGINE_CONTROL
 		return getThrottlePressureRatio(Sensor::getOrZero(SensorType::Map));
