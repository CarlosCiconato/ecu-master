diff --git a/firmware/controllers/modules/cold_start_injector/cold_start_injector.cpp b/firmware/controllers/modules/cold_start_injector/cold_start_injector.cpp
new file mode 100644
index 0000000..33681de
--- /dev/null
+++ b/firmware/controllers/modules/cold_start_injector/cold_start_injector.cpp
@@ -0,0 +1,47 @@
+#include "pch.h"
+
+#include "cold_start_injector.h"
+
+void ColdStartInjector::update() {
+	bool isCranking = engine->rpmCalculator.isCranking();
+	if (isCranking) {
+		m_sinceCranking.reset();
+		m_crankedThisStart = true;
+	}
+
+	bool isAfterStart = m_crankedThisStart
+		&& engine->rpmCalculator.isRunning()
+		&& !m_sinceCranking.hasElapsedSec(engineConfiguration->coldStartInjectorAfterStart);
+
+	auto clt = Sensor::get(SensorType::Clt);
+	// failed coolant sensor: do not inject
+	bool shouldBeActive = (isCranking || isAfterStart)
+		&& clt
+		&& clt.Value < engineConfiguration->coldStartInjectorMaxClt;
+
+	if (!shouldBeActive) {
+		m_isActive = false;
+		enginePins.coldStartInjector.setValue(false);
+		return;
+	}
+
+	if (!m_isActive) {
+		// first pulse right away
+		m_pulseTimer.reset();
+		m_isActive = true;
+	}
+
+	float pulseMs = interpolate2d(clt.Value, config->coldStartInjectorCltBins, config->coldStartInjectorPulse);
+	float periodMs = std::max<float>(engineConfiguration->coldStartInjectorPeriod, 20);
+	float positionMs = fmodf(m_pulseTimer.getElapsedSeconds() * 1000, periodMs);
+
+	enginePins.coldStartInjector.setValue(positionMs < pulseMs);
+}
+
+void ColdStartInjector::onFastCallback() {
+	update();
+}
+
+void ColdStartInjector::onEngineStop() {
+	m_crankedThisStart = false;
+}
diff --git a/firmware/controllers/modules/cold_start_injector/cold_start_injector.h b/firmware/controllers/modules/cold_start_injector/cold_start_injector.h
new file mode 100644
index 0000000..2d87b3d
--- /dev/null
+++ b/firmware/controllers/modules/cold_start_injector/cold_start_injector.h
@@ -0,0 +1,29 @@
+/*
+ * @file cold_start_injector.h
+ *
+ * pro-style cold start injector: an extra injector (for example gasoline on an
+ * ethanol engine) that pulses while cranking, and for a set time after start, when the
+ * coolant is below a limit. Pulse length comes from a coolant temperature curve.
+ */
+
+#pragma once
+
+class ColdStartInjector : public EngineModule {
+public:
+	using interface_t = ColdStartInjector;
+
+	void onFastCallback() override;
+	void onEngineStop() override;
+
+	void update();
+
+	bool isActive() const {
+		return m_isActive;
+	}
+
+private:
+	bool m_isActive = false;
+	bool m_crankedThisStart = false;
+	Timer m_sinceCranking;
+	Timer m_pulseTimer;
+};
