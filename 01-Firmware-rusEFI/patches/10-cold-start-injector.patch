diff --git a/unit_tests/tests/controllers/test_cold_start_injector.cpp b/unit_tests/tests/controllers/test_cold_start_injector.cpp
new file mode 100644
index 0000000..e46b74a
--- /dev/null
+++ b/unit_tests/tests/controllers/test_cold_start_injector.cpp
@@ -0,0 +1,119 @@
+#include "pch.h"
+
+#include "cold_start_injector.h"
+
+// pro-style cold start injector: pulses while cranking (and after start if set)
+// when the coolant is below the limit, pulse length by coolant temperature.
+
+class ColdStartInjectorTest : public testing::Test {
+protected:
+	EngineTestHelper eth{engine_type_e::TEST_ENGINE};
+
+	ColdStartInjector& dut() {
+		return engine->module<ColdStartInjector>().unmock();
+	}
+
+	bool isOn() {
+		return enginePins.coldStartInjector.getLogicValue();
+	}
+
+	void SetUp() override {
+		engineConfiguration->cranking.rpm = 400;
+		engineConfiguration->coldStartInjectorMaxClt = 20;
+		engineConfiguration->coldStartInjectorAfterStart = 0;
+		engineConfiguration->coldStartInjectorPeriod = 500;
+		copyArray(config->coldStartInjectorCltBins, { -40, -20, 0, 20, 40, 60, 80, 100 });
+		copyArray(config->coldStartInjectorPulse, { 150, 120, 80, 40, 0, 0, 0, 0 });
+		Sensor::setMockValue(SensorType::Clt, 0);
+	}
+};
+
+TEST_F(ColdStartInjectorTest, OffWithEngineStopped) {
+	engine->rpmCalculator.setRpmValue(0);
+	dut().update();
+	EXPECT_FALSE(dut().isActive());
+	EXPECT_FALSE(isOn());
+}
+
+TEST_F(ColdStartInjectorTest, PulsesWhileCrankingCold) {
+	engine->rpmCalculator.setRpmValue(200);
+
+	// 80 ms on at 0 C, then off until the next pulse 500 ms later
+	dut().update();
+	EXPECT_TRUE(dut().isActive());
+	EXPECT_TRUE(isOn());
+	advanceTimeUs(70'000);
+	dut().update();
+	EXPECT_TRUE(isOn());
+	advanceTimeUs(20'000);
+	dut().update();
+	EXPECT_FALSE(isOn());
+	advanceTimeUs(400'000);
+	dut().update();
+	EXPECT_FALSE(isOn());
+	advanceTimeUs(20'000);
+	dut().update();
+	EXPECT_TRUE(isOn());
+}
+
+TEST_F(ColdStartInjectorTest, PulseLengthFollowsCoolant) {
+	engine->rpmCalculator.setRpmValue(200);
+	Sensor::setMockValue(SensorType::Clt, -20);
+	dut().update();
+	advanceTimeUs(110'000);
+	dut().update();
+	// 120 ms at -20 C
+	EXPECT_TRUE(isOn());
+	advanceTimeUs(20'000);
+	dut().update();
+	EXPECT_FALSE(isOn());
+}
+
+TEST_F(ColdStartInjectorTest, WarmEngineOrFailedSensorDoesNothing) {
+	engine->rpmCalculator.setRpmValue(200);
+
+	Sensor::setMockValue(SensorType::Clt, 25);
+	dut().update();
+	EXPECT_FALSE(dut().isActive());
+	EXPECT_FALSE(isOn());
+
+	Sensor::setInvalidMockValue(SensorType::Clt);
+	dut().update();
+	EXPECT_FALSE(dut().isActive());
+	EXPECT_FALSE(isOn());
+}
+
+TEST_F(ColdStartInjectorTest, StopsWhenEngineStartsUnlessAfterStartIsSet) {
+	engine->rpmCalculator.setRpmValue(200);
+	dut().update();
+	EXPECT_TRUE(isOn());
+
+	engine->rpmCalculator.setRpmValue(1000);
+	dut().update();
+	EXPECT_FALSE(dut().isActive());
+	EXPECT_FALSE(isOn());
+}
+
+TEST_F(ColdStartInjectorTest, KeepsPulsingAfterStart) {
+	engineConfiguration->coldStartInjectorAfterStart = 2; // seconds
+
+	engine->rpmCalculator.setRpmValue(200);
+	dut().update();
+	engine->rpmCalculator.setRpmValue(1000);
+	advanceTimeUs(1'000'000);
+	dut().update();
+	EXPECT_TRUE(dut().isActive());
+
+	advanceTimeUs(1'100'000);
+	dut().update();
+	EXPECT_FALSE(dut().isActive());
+	EXPECT_FALSE(isOn());
+}
+
+TEST_F(ColdStartInjectorTest, NoAfterStartWithoutCranking) {
+	engineConfiguration->coldStartInjectorAfterStart = 2;
+	// running without a crank seen by this module, for example after a stall recovery
+	engine->rpmCalculator.setRpmValue(1000);
+	dut().update();
+	EXPECT_FALSE(dut().isActive());
+}
