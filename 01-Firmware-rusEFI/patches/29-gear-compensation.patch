diff --git a/unit_tests/tests/ignition_injection/test_ignition_state.cpp b/unit_tests/tests/ignition_injection/test_ignition_state.cpp
index b3d47e3..91ec08a 100644
--- a/unit_tests/tests/ignition_injection/test_ignition_state.cpp
+++ b/unit_tests/tests/ignition_injection/test_ignition_state.cpp
@@ -372,3 +372,38 @@ TEST(ignition_state, crankingAdvanceByClt) {
 	Sensor::setMockValue(SensorType::Clt, 0);
 	EXPECT_NEAR(12, getCrankingAdvance(engine->rpmCalculator.getMinCrankingRpm(), 50), EPS2D);
 }
+
+// pro-style timing and fuel compensation by gear (RPM x gear tables)
+TEST(ignition_state, gearCompensation) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+
+	Sensor::setMockValue(SensorType::Rpm, 3000);
+	Sensor::setMockValue(SensorType::DetectedGear, 3);
+
+	// default tables change nothing
+	EXPECT_NEAR(0, getGearTimingCorrection(), EPS2D);
+	EXPECT_NEAR(1, getGearFuelCoefficient(), EPS2D);
+
+	// third gear row: -2 deg and +5 % fuel
+	setArrayValues(config->gearTimingTable[2], -2);
+	setArrayValues(config->gearFuelTable[2], 5);
+	EXPECT_NEAR(-2, getGearTimingCorrection(), EPS2D);
+	EXPECT_NEAR(1.05, getGearFuelCoefficient(), EPS2D);
+
+	// another gear uses its own row
+	Sensor::setMockValue(SensorType::DetectedGear, 2);
+	EXPECT_NEAR(0, getGearTimingCorrection(), EPS2D);
+
+	// neutral, no gear detection or a gear without a row: no change
+	Sensor::setMockValue(SensorType::DetectedGear, 0);
+	EXPECT_NEAR(0, getGearTimingCorrection(), EPS2D);
+	Sensor::setInvalidMockValue(SensorType::DetectedGear);
+	EXPECT_NEAR(1, getGearFuelCoefficient(), EPS2D);
+	Sensor::setMockValue(SensorType::DetectedGear, 8);
+	EXPECT_NEAR(0, getGearTimingCorrection(), EPS2D);
+
+	// the gear timing goes into the timing corrections
+	Sensor::setMockValue(SensorType::DetectedGear, 3);
+	getAdvanceCorrections(50);
+	EXPECT_NEAR(-2, engine->ignitionState.timingGearCorrection, 0.01);
+}
