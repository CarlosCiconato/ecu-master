diff --git a/firmware/controllers/algo/ignition/ignition_state.cpp b/firmware/controllers/algo/ignition/ignition_state.cpp
index d964085..570af61 100644
--- a/firmware/controllers/algo/ignition/ignition_state.cpp
+++ b/firmware/controllers/algo/ignition/ignition_state.cpp
@@ -195,6 +195,36 @@ void IgnitionState::updateAdvanceCorrections(float engineLoad) {
 	cltTimingCorrection = getCltTimingCorrection(engineLoad);
 }
 
+template <typename TTable>
+static float getGearCompensation(const TTable& table) {
+	// pro-style compensation by gear, 0 in neutral or without gear detection
+	auto gear = Sensor::get(SensorType::DetectedGear);
+	if (!gear.Valid || gear.Value < 1) {
+		return 0;
+	}
+	float rpm = Sensor::getOrZero(SensorType::Rpm);
+	// rows are whole gears, no blending between them
+	float row = std::round(gear.Value);
+	size_t i = 0;
+	for (; i < GEAR_COMP_GEAR_COUNT; i++) {
+		if (config->gearCompGearBins[i] == row) {
+			break;
+		}
+	}
+	if (i == GEAR_COMP_GEAR_COUNT) {
+		return 0;
+	}
+	return interpolate2d(rpm, config->gearCompRpmBins, table[i]);
+}
+
+angle_t getGearTimingCorrection() {
+	return getGearCompensation(config->gearTimingTable);
+}
+
+float getGearFuelCoefficient() {
+	return 1 + getGearCompensation(config->gearFuelTable) / 100;
+}
+
 angle_t getAdvanceCorrections(float engineLoad) {
 	auto iat = Sensor::get(SensorType::Iat);
 
@@ -216,12 +246,15 @@ angle_t getAdvanceCorrections(float engineLoad) {
 
 	engine->ignitionState.dfcoTimingRetard = engine->module<DfcoController>()->getTimingRetard();
 
+	engine->ignitionState.timingGearCorrection = getGearTimingCorrection();
+
 #if EFI_TUNER_STUDIO
 	engine->outputChannels.multiSparkCounter = engine->engineState.multispark.count;
 #endif /* EFI_TUNER_STUDIO */
 
 	return engine->ignitionState.timingIatCorrection
 		+ engine->ignitionState.cltTimingCorrection
+		+ engine->ignitionState.timingGearCorrection
 		+ engine->ignitionState.timingPidCorrection
 		- engine->ignitionState.dfcoTimingRetard
 		- engine->module<BurstKnock>().unmock().getTimingRetard()
