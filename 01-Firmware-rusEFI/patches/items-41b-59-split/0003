+
+// outra-ecu-style selector switch: 0-5 V in equal bands, one per tune
+
+TEST_F(TuneSelectorTest, SelectorVoltagePicksTune) {
+	tunes().update(false, 0.5f);
+	EXPECT_EQ(1, tunes().getActiveTune());
+	tunes().update(false, 2.5f);
+	EXPECT_EQ(2, tunes().getActiveTune());
+	EXPECT_EQ(&config->extraTunes[0].veTable, &getActiveVeTable());
+	tunes().update(false, 4.5f);
+	EXPECT_EQ(3, tunes().getActiveTune());
+	tunes().update(false, 0.2f);
+	EXPECT_EQ(1, tunes().getActiveTune());
+}
+
+TEST_F(TuneSelectorTest, SelectorHysteresisAtBandEdge) {
+	// 3 tunes: edges at 1.67 V and 3.33 V
+	tunes().update(false, 1.0f);
+	EXPECT_EQ(1, tunes().getActiveTune());
+	// just past the edge: stays on tune 1
+	tunes().update(false, 1.70f);
+	EXPECT_EQ(1, tunes().getActiveTune());
+	// clearly in band 2
+	tunes().update(false, 1.80f);
+	EXPECT_EQ(2, tunes().getActiveTune());
+	// back just under the edge: stays on tune 2
+	tunes().update(false, 1.62f);
+	EXPECT_EQ(2, tunes().getActiveTune());
+	tunes().update(false, 1.5f);
+	EXPECT_EQ(1, tunes().getActiveTune());
+}
+
+TEST_F(TuneSelectorTest, SelectorSkipsEmptyTune) {
+	setTable(config->extraTunes[1].lambdaTable, 0);
+	tunes().update(false, 2.5f);
+	EXPECT_EQ(2, tunes().getActiveTune());
+	// tune 3 is empty: stays on tune 2
+	tunes().update(false, 4.5f);
+	EXPECT_EQ(2, tunes().getActiveTune());
+}
+
+TEST_F(TuneSelectorTest, ButtonStillWorksWithSelector) {
+	tunes().update(false, 0.5f);
+	EXPECT_EQ(1, tunes().getActiveTune());
+	// button moves on while the selector stays put
+	tunes().update(true, 0.5f);
+	tunes().update(false, 0.5f);
+	EXPECT_EQ(2, tunes().getActiveTune());
+	// moving the selector picks its tune again
+	tunes().update(false, 4.5f);
+	EXPECT_EQ(3, tunes().getActiveTune());
+}
+
+TEST_F(TuneSelectorTest, SelectorFollowsTuneCount) {
+	engineConfiguration->tuneCount = 2;
+	// 2 tunes: one band each side of 2.5 V
+	tunes().update(false, 2.0f);
+	EXPECT_EQ(1, tunes().getActiveTune());
+	tunes().update(false, 4.9f);
+	EXPECT_EQ(2, tunes().getActiveTune());
+}
