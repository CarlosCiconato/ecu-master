+++ b/firmware/controllers/modules/tune_selector/tune_selector.cpp
@@ -89,7 +89,29 @@ void TuneSelector::selectTune(uint8_t tune) {
 	}
 }
 
+uint8_t TuneSelector::getSelectorPosition(float volts, uint8_t count) const {
+	if (count < 1) {
+		return 1;
+	}
+	float band = 5.0f / count;
+	int position = std::clamp<int>(static_cast<int>(volts / band) + 1, 1, count);
+
+	// stay where we are until the voltage is clearly in the next band
+	if (m_selectorPosition >= 1 && m_selectorPosition <= count && position != m_selectorPosition) {
+		float lower = (m_selectorPosition - 1) * band;
+		float upper = m_selectorPosition * band;
+		if (volts > lower - selectorHysteresis && volts < upper + selectorHysteresis) {
+			position = m_selectorPosition;
+		}
+	}
+	return position;
+}
+
 void TuneSelector::update(bool buttonPressed) {
+	update(buttonPressed, unexpected);
+}
+
+void TuneSelector::update(bool buttonPressed, SensorResult selectorVoltage) {
 	uint8_t count = getTuneCount();
 
 	// The app (or TunerStudio) picks a tune by writing activeTune
@@ -97,7 +119,20 @@ void TuneSelector::update(bool buttonPressed) {
 	if (configTune != m_lastConfigTune) {
 		m_lastConfigTune = configTune;
 		selectTune(configTune);
-	} else if (buttonPressed && !m_wasPressed) {
+	}
+
+	// Selector switch by voltage: a new position picks its tune
+	if (selectorVoltage) {
+		uint8_t position = getSelectorPosition(selectorVoltage.Value, count);
+		if (position != m_selectorPosition) {
+			m_selectorPosition = position;
+			selectTune(position);
+		}
+	} else {
+		m_selectorPosition = 0;
+	}
+
+	if (buttonPressed && !m_wasPressed) {
 		// Next usable tune, skipping empty ones
 		uint8_t tune = m_activeTune;
 		for (uint8_t i = 0; i < count; i++) {
@@ -126,5 +161,9 @@ void TuneSelector::update(bool buttonPressed) {
 void TuneSelector::onSlowCallback() {
 	bool pressed = isBrainPinValid(engineConfiguration->tuneSwitchPin)
 		&& efiReadPin(engineConfiguration->tuneSwitchPin, engineConfiguration->tuneSwitchPinMode);
-	update(pressed);
+	SensorResult selector = unexpected;
+	if (isAdcChannelValid(engineConfiguration->tuneSelectorChannel)) {
+		selector = adcGetScaledVoltage("tune", engineConfiguration->tuneSelectorChannel);
+	}
+	update(pressed, selector);
 }
