+++ b/unit_tests/tests/test_downshift_blip.cpp
@@ -0,0 +1,86 @@
+#include "pch.h"
+
+#include "downshift_blip.h"
+#include "electronic_throttle_impl.h"
+#include "mocks.h"
+
+using ::testing::_;
+using ::testing::StrictMock;
+
+// outra-ecu-style throttle blip on downshift
+
+static void setupBlip() {
+	engineConfiguration->blipThrottleAdd = 15;
+	engineConfiguration->blipDuration = 300;
+	engineConfiguration->blipMinRpm = 1500;
+}
+
+TEST(DownshiftBlip, offByDefault) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	DownshiftBlip blip;
+	blip.update(true, 4000, getTimeNowNt());
+	EXPECT_EQ(0, blip.getThrottleAdd(getTimeNowNt()));
+}
+
+TEST(DownshiftBlip, pressGivesTimedBlip) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	setupBlip();
+	DownshiftBlip blip;
+
+	blip.update(false, 4000, getTimeNowNt());
+	EXPECT_EQ(0, blip.getThrottleAdd(getTimeNowNt()));
+
+	blip.update(true, 4000, getTimeNowNt());
+	EXPECT_EQ(15, blip.getThrottleAdd(getTimeNowNt()));
+
+	// holding the button does not make it longer
+	advanceTimeUs(200e3);
+	blip.update(true, 4000, getTimeNowNt());
+	EXPECT_EQ(15, blip.getThrottleAdd(getTimeNowNt()));
+	advanceTimeUs(150e3);
+	blip.update(true, 4000, getTimeNowNt());
+	EXPECT_EQ(0, blip.getThrottleAdd(getTimeNowNt()));
+
+	// a new press gives a new blip
+	blip.update(false, 4000, getTimeNowNt());
+	blip.update(true, 4000, getTimeNowNt());
+	EXPECT_EQ(15, blip.getThrottleAdd(getTimeNowNt()));
+}
+
+TEST(DownshiftBlip, noBlipBelowMinRpm) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	setupBlip();
+	DownshiftBlip blip;
+	blip.update(false, 1000, getTimeNowNt());
+	blip.update(true, 1000, getTimeNowNt());
+	EXPECT_EQ(0, blip.getThrottleAdd(getTimeNowNt()));
+}
+
+TEST(DownshiftBlip, addsToThrottleTarget) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	setupBlip();
+	engineConfiguration->etbIdleThrottleRange = 0;
+
+	Sensor::setMockValue(SensorType::Tps1Primary, 0);
+	Sensor::setMockValue(SensorType::Tps1, 0.0f, true);
+	Sensor::setMockValue(SensorType::AcceleratorPedal, 0.0f, true);
+
+	EtbController etb;
+	StrictMock<MockVp3d> pedalMap;
+	EXPECT_CALL(pedalMap, getValue(_, _))
+		.WillRepeatedly([](float xRpm, float y) {
+			return y;
+		});
+	etb.init(DC_Throttle1, nullptr, nullptr, &pedalMap);
+
+	Sensor::setMockValue(SensorType::AcceleratorPedal, 10.0f, true);
+	EXPECT_FLOAT_EQ(10, etb.getSetpoint().value_or(-1));
+
+	auto& blip = engine->module<DownshiftBlip>().unmock();
+	blip.update(false, 4000, getTimeNowNt());
+	blip.update(true, 4000, getTimeNowNt());
+	EXPECT_FLOAT_EQ(25, etb.getSetpoint().value_or(-1));
+
+	advanceTimeUs(400e3);
+	EXPECT_FLOAT_EQ(10, etb.getSetpoint().value_or(-1));
+}
