@@ -0,0 +1,35 @@
+#include "pch.h"
+
+#include "downshift_blip.h"
+
+void DownshiftBlip::update(bool buttonPressed, float rpm, efitick_t nowNt) {
+	bool enabled = engineConfiguration->blipThrottleAdd > 0 && engineConfiguration->blipDuration > 0;
+
+	// a new press starts a blip; holding the button does not make it longer
+	if (enabled && buttonPressed && !m_wasPressed && rpm >= engineConfiguration->blipMinRpm) {
+		m_started = true;
+		m_blipTimer.reset(nowNt);
+	}
+	m_wasPressed = buttonPressed;
+
+	if (!enabled) {
+		m_started = false;
+	}
+}
+
+bool DownshiftBlip::isActive(efitick_t nowNt) const {
+	return m_started
+		&& m_blipTimer.getElapsedSeconds(nowNt) * 1000 < engineConfiguration->blipDuration;
+}
+
+float DownshiftBlip::getThrottleAdd(efitick_t nowNt) const {
+	return isActive(nowNt) ? engineConfiguration->blipThrottleAdd : 0;
+}
+
+void DownshiftBlip::onFastCallback() {
+	bool pressed = isBrainPinValid(engineConfiguration->blipButtonPin)
+		&& efiReadPin(engineConfiguration->blipButtonPin, engineConfiguration->blipButtonPinMode);
+	efitick_t nowNt = getTimeNowNt();
+	update(pressed, Sensor::getOrZero(SensorType::Rpm), nowNt);
+	engine->outputChannels.blipThrottleAdd = getThrottleAdd(nowNt);
+}
