+TEST(EgtRise, alertSensorReadsModule) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	auto& mon = engine->module<EgtRiseMonitor>().unmock();
+	EXPECT_FALSE(readGppwmChannel(GPPWM_EgtRiseRate).Valid);
+	feed(mon, 600, 80, 6, 4);
+	EXPECT_NEAR(80, readGppwmChannel(GPPWM_EgtRiseRate).value_or(0), 5);
+}
