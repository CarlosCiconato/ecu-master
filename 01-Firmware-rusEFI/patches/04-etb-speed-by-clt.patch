index f361d01..925cd0d 100644
--- a/firmware/controllers/actuators/electronic_throttle.cpp
+++ b/firmware/controllers/actuators/electronic_throttle.cpp
@@ -358,6 +358,9 @@ expected<percent_t> EtbController::getSetpointEtb() {
 	// Clamp before rev limiter to avoid ineffective rev limit due to crazy out of range position target
 	targetPosition = clampPercentValue(targetPosition);
 
+	// Throttle speed limit by CLT, before the rev limiter so that one is never slowed down
+	targetPosition = m_speedLimiter.apply(targetPosition, Sensor::getOrZero(SensorType::Clt), getTimeNowNt());
+
 	// Lastly, apply ETB rev limiter
 	auto etbRpmLimit = engineConfiguration->etbRevLimitStart;
 	if (etbRpmLimit != 0) {
@@ -384,6 +387,34 @@ expected<percent_t> EtbController::getSetpointEtb() {
 	return targetPosition;
 }
 
+percent_t EtbSpeedLimiter::apply(percent_t target, float clt, efitick_t nowNt) {
+	if (!engineConfiguration->etbSpeedLimitEnabled || !m_hasPrevious) {
+		m_hasPrevious = true;
+		m_previous = target;
+		m_timer.reset(nowNt);
+		return target;
+	}
+
+	// Guard against a long gap (first call after a pause) allowing a jump
+	float dt = std::min(m_timer.getElapsedSecondsAndReset(nowNt), 0.1f);
+
+	float delta = target - m_previous;
+	if (delta > 0) {
+		float openSpeed = interpolate2d(clt, config->etbSpeedCltBins, config->etbOpenSpeed);
+		if (openSpeed > 0) {
+			delta = std::min(delta, openSpeed * dt);
+		}
+	} else if (delta < 0) {
+		float closeSpeed = interpolate2d(clt, config->etbSpeedCltBins, config->etbCloseSpeed);
+		if (closeSpeed > 0) {
+			delta = std::max(delta, -closeSpeed * dt);
+		}
+	}
+
+	m_previous += delta;
+	return m_previous;
+}
