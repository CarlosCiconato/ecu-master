diff --git a/unit_tests/tests/actuators/test_etb_speed_limit.cpp b/unit_tests/tests/actuators/test_etb_speed_limit.cpp
new file mode 100644
index 0000000..f38c8e7
--- /dev/null
+++ b/unit_tests/tests/actuators/test_etb_speed_limit.cpp
@@ -0,0 +1,93 @@
+#include "pch.h"
+
+#include "electronic_throttle_impl.h"
+#include "mocks.h"
+
+using ::testing::_;
+using ::testing::StrictMock;
+
+// pro-style throttle speed limit: opening and closing speed (%/s) by coolant temperature
+
+class EtbSpeedLimit : public testing::Test {
+protected:
+	EngineTestHelper eth{engine_type_e::TEST_ENGINE};
+	EtbSpeedLimiter limiter;
+
+	void SetUp() override {
+		engineConfiguration->etbSpeedLimitEnabled = true;
+		setLinearCurve(config->etbSpeedCltBins, -20, 120, 1); // 20 C steps
+		setArrayValues(config->etbOpenSpeed, 100);
+		setArrayValues(config->etbCloseSpeed, 200);
+	}
+
+	percent_t step(percent_t target, float clt = 80) {
+		advanceTimeUs(50'000);
+		return limiter.apply(target, clt, getTimeNowNt());
+	}
+};
+
+TEST_F(EtbSpeedLimit, LimitsOpeningAndClosing) {
+	// First call takes the target as it is
+	EXPECT_FLOAT_EQ(10, limiter.apply(10, 80, getTimeNowNt()));
+
+	// 100 %/s opening: 5% per 50 ms
+	EXPECT_NEAR(15, step(60), EPS4D);
+	EXPECT_NEAR(20, step(60), EPS4D);
+
+	// 200 %/s closing: 10% per 50 ms
+	EXPECT_NEAR(10, step(0), EPS4D);
+	EXPECT_NEAR(0, step(0), EPS4D);
+	EXPECT_NEAR(0, step(0), EPS4D);
+}
+
+TEST_F(EtbSpeedLimit, SlowerWhenCold) {
+	config->etbOpenSpeed[0] = 20; // -20 C
+
+	limiter.apply(0, -20, getTimeNowNt());
+	EXPECT_NEAR(1, step(50, -20), EPS4D);
+
+	// Warm engine opens at the normal speed
+	EXPECT_NEAR(6, step(50, 80), EPS4D);
+}
+
+TEST_F(EtbSpeedLimit, ZeroMeansNoLimit) {
+	setArrayValues(config->etbOpenSpeed, 0);
+	limiter.apply(0, 80, getTimeNowNt());
+	EXPECT_FLOAT_EQ(80, step(80));
+}
+
+TEST_F(EtbSpeedLimit, DisabledPassesThrough) {
+	engineConfiguration->etbSpeedLimitEnabled = false;
+	limiter.apply(0, 80, getTimeNowNt());
+	EXPECT_FLOAT_EQ(80, step(80));
+	EXPECT_FLOAT_EQ(0, step(0));
+}
+
+TEST_F(EtbSpeedLimit, AppliedToEtbSetpoint) {
+	// Must have TPS & PPS initialized for ETB setup
+	Sensor::setMockValue(SensorType::Tps1Primary, 0);
+	Sensor::setMockValue(SensorType::Tps1, 0.0f, true);
+	Sensor::setMockValue(SensorType::AcceleratorPedal, 0.0f, true);
+	Sensor::setMockValue(SensorType::Clt, 80);
+	engineConfiguration->etbIdleThrottleRange = 0;
+	engineConfiguration->etbRevLimitStart = 0;
+
+	EtbController etb;
+	// Mock pedal map that's just passthru pedal -> target
+	StrictMock<MockVp3d> pedalMap;
+	EXPECT_CALL(pedalMap, getValue(_, _))
+		.WillRepeatedly([](float xRpm, float y) {
+			return y;
+		});
+	etb.init(DC_Throttle1, nullptr, nullptr, &pedalMap);
+
+	// Closed pedal gives the 1% minimum position
+	EXPECT_NEAR(1, etb.getSetpoint().value_or(-1), EPS4D);
+
+	// Pedal floored: the target only rises 5% per 50 ms (the limiter runs before the min/max clamp)
+	Sensor::setMockValue(SensorType::AcceleratorPedal, 100.0f, true);
+	advanceTimeUs(50'000);
+	EXPECT_NEAR(5, etb.getSetpoint().value_or(-1), EPS4D);
+	advanceTimeUs(50'000);
+	EXPECT_NEAR(10, etb.getSetpoint().value_or(-1), EPS4D);
+}
