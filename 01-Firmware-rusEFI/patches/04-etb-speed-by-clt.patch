+// pro-style throttle speed limit: opening and closing speed (%/s) by coolant temperature
+class EtbSpeedLimiter {
+public:
+	// Moves toward the requested target no faster than the configured speed
+	percent_t apply(percent_t target, float clt, efitick_t nowNt);
+
+private:
+	bool m_hasPrevious = false;
+	percent_t m_previous = 0;
+	Timer m_timer;
+};
