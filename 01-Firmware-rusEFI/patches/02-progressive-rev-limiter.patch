diff --git a/firmware/controllers/limp_manager.cpp b/firmware/controllers/limp_manager.cpp
index 8b994cb..b23d5d1 100644
--- a/firmware/controllers/limp_manager.cpp
+++ b/firmware/controllers/limp_manager.cpp
@@ -77,6 +77,21 @@ void LimpManager::updateRevLimit(float rpm) {
 
 	percent_t fuelAdded = interpolateClamped(resumeRpm, 0, m_revLimit, engineConfiguration->rpmSoftLimitFuelAdded, rpm);
 	m_fuelCorrection = 1.0f + fuelAdded / 100;
+
+	// Progressive rev limiter: random spark cut ramps up inside the window below the limit
+	float windowStart = m_revLimit - config->progressiveRevLimitWindow;
+	if (engineConfiguration->progressiveRevLimitEnabled && rpm >= windowStart) {
+		float startRatio = config->progressiveRevLimitStartCut / 100.0f;
+		m_revLimitSparkSkipRatio = config->progressiveRevLimitWindow > 0
+			? interpolateClamped(windowStart, startRatio, m_revLimit, 1.0f, rpm)
+			: 1.0f;
+	} else {
+		m_revLimitSparkSkipRatio = 0;
+	}
+}
+
+float LimpManager::getRevLimitSparkSkipRatio() const {
+	return m_revLimitSparkSkipRatio;
 }
 
