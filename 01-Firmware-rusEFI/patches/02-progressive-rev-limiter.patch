index 0000000..d748494
--- /dev/null
+++ b/unit_tests/tests/test_progressive_rev_limiter.cpp
@@ -0,0 +1,77 @@
+#include "pch.h"
+
+#include "limp_manager.h"
+
+// pro-style progressive rev limiter: spark cut ramps from the start %
+// to 100% inside the window below the rev limit.
+
+TEST(ProgressiveRevLimiter, RampsInsideWindow) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	engineConfiguration->useCltBasedRpmLimit = false;
+	engineConfiguration->rpmHardLimit = 7000;
+	engineConfiguration->progressiveRevLimitEnabled = true;
+	config->progressiveRevLimitWindow = 500;
+	config->progressiveRevLimitStartCut = 20;
+
+	auto limp = getLimpManager();
+
+	limp->updateRevLimit(6400);
+	EXPECT_FLOAT_EQ(0, limp->getRevLimitSparkSkipRatio());
+
+	limp->updateRevLimit(6500);
+	EXPECT_NEAR(0.2f, limp->getRevLimitSparkSkipRatio(), EPS4D);
+
+	limp->updateRevLimit(6750);
+	EXPECT_NEAR(0.6f, limp->getRevLimitSparkSkipRatio(), EPS4D);
+
+	limp->updateRevLimit(7000);
+	EXPECT_NEAR(1.0f, limp->getRevLimitSparkSkipRatio(), EPS4D);
+
+	// Above the limit stays at full cut
+	limp->updateRevLimit(7300);
+	EXPECT_NEAR(1.0f, limp->getRevLimitSparkSkipRatio(), EPS4D);
+}
+
+TEST(ProgressiveRevLimiter, DisabledMeansNoCut) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	engineConfiguration->useCltBasedRpmLimit = false;
+	engineConfiguration->rpmHardLimit = 7000;
+	engineConfiguration->progressiveRevLimitEnabled = false;
+	config->progressiveRevLimitWindow = 500;
+	config->progressiveRevLimitStartCut = 20;
+
+	getLimpManager()->updateRevLimit(6900);
+	EXPECT_FLOAT_EQ(0, getLimpManager()->getRevLimitSparkSkipRatio());
+}
+
+TEST(ProgressiveRevLimiter, FollowsCltBasedLimit) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	engineConfiguration->useCltBasedRpmLimit = true;
+	setArrayValues(config->cltRevLimitRpm, 4000);
+	Sensor::setMockValue(SensorType::Clt, 20);
+	engineConfiguration->progressiveRevLimitEnabled = true;
+	config->progressiveRevLimitWindow = 400;
+	config->progressiveRevLimitStartCut = 0;
+
+	getLimpManager()->updateRevLimit(3800);
+	EXPECT_NEAR(0.5f, getLimpManager()->getRevLimitSparkSkipRatio(), EPS4D);
+}
+
+TEST(ProgressiveRevLimiter, FeedsHardSparkLimiter) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	engineConfiguration->useCltBasedRpmLimit = false;
+	engineConfiguration->rpmHardLimit = 7000;
+	engineConfiguration->progressiveRevLimitEnabled = true;
+	config->progressiveRevLimitWindow = 500;
+	config->progressiveRevLimitStartCut = 20;
+
+	Sensor::setMockValue(SensorType::Rpm, 6750);
+	eth.engine.periodicFastCallback();
+
+	EXPECT_NEAR(0.6f, engine->hardSparkLimiter.getTargetSkipRatio(), EPS4D);
+
+	// Below the window nothing is cut
+	Sensor::setMockValue(SensorType::Rpm, 3000);
+	eth.engine.periodicFastCallback();
+	EXPECT_FLOAT_EQ(0, engine->hardSparkLimiter.getTargetSkipRatio());
+}
