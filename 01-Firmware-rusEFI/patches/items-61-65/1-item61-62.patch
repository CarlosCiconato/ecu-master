From f5370bffcd8a954c4e4821bd7d882806f749f839 Mon Sep 17 00:00:00 2001
From: Carlos Ciconato <354919267+CarlosCiconato@users.noreply.github.com>
Date: Sun, 1 Nov 2026 13:17:42 +0000
Subject: [PATCH] Idle by TPS and MAP/TPS compensation for the Injection time
 (ms) table, pro-style

Item 61: with the ms table on TPS, below the idle TPS threshold the pulse
comes from an idle ms-by-RPM curve (injTimeIdleRpmBins/injTimeIdleTable).
Item 62: % compensation on the useful pulse by the load sensor the ms
table does not use (TPS when on MAP, MAP when on TPS).
Both off by default.
---
 .../algo/defaults/default_fuel.cpp            |  9 ++++
 firmware/controllers/algo/fuel_math.cpp       | 34 +++++++++---
 firmware/controllers/algo/fuel_math.h         |  2 +
 firmware/integration/rusefi_config.txt        | 10 +++-
 firmware/tunerstudio/tunerstudio.template.ini | 18 +++++++
 .../test_injection_time_map.cpp               | 53 +++++++++++++++++++
 6 files changed, 118 insertions(+), 8 deletions(-)

diff --git a/firmware/controllers/algo/defaults/default_fuel.cpp b/firmware/controllers/algo/defaults/default_fuel.cpp
index bdf3a9a8700..505554ee779 100644
--- a/firmware/controllers/algo/defaults/default_fuel.cpp
+++ b/firmware/controllers/algo/defaults/default_fuel.cpp
@@ -372,6 +372,15 @@ static void setDefaultPriming() {
 
 static void setDefaultInjTimeTable() {
 	setRpmTableBin(config->injTimeRpmBins);
+	// Idle by TPS: 600..3000 RPM, 1.5 ms; MAP/TPS compensation: neutral
+	setLinearCurve(config->injTimeIdleRpmBins, 600, 3000, 50);
+	setArrayValues(config->injTimeIdleTable, 1.5f);
+	if (engineConfiguration->injTimeUseTps) {
+		setLinearCurve(config->injTimeLoadCompBins, 20, 250, 1);
+	} else {
+		setLinearCurve(config->injTimeLoadCompBins, 0, 100, 1);
+	}
+	setArrayValues(config->injTimeLoadComp, 0);
 	setLinearCurve(config->injTimeLoadBins, 20, 250, 1);
 
 	// Placeholder only: roughly 1 ms deadtime plus a pulse proportional to load
diff --git a/firmware/controllers/algo/fuel_math.cpp b/firmware/controllers/algo/fuel_math.cpp
index 0403d9d897b..2d22b8e4b6a 100644
--- a/firmware/controllers/algo/fuel_math.cpp
+++ b/firmware/controllers/algo/fuel_math.cpp
@@ -249,14 +249,36 @@ float getInjectionTimeTableLoad() {
 		: Sensor::getOrZero(SensorType::Map);
 }
 
+// pro-style idle by TPS: only with the ms table on TPS, throttle below the idle threshold
+bool isInjectionTimeIdleActive() {
+	return engineConfiguration->injTimeIdleTableEnabled
+		&& engineConfiguration->injTimeUseTps
+		&& Sensor::getOrZero(SensorType::Tps1) < engineConfiguration->idlePidDeactivationTpsThreshold;
+}
+
+// pro-style MAP/TPS compensation: multiplier from the load sensor the ms table does not use
+float getInjectionTimeLoadCompensation() {
+	if (!engineConfiguration->injTimeLoadCompEnabled) {
+		return 1;
+	}
+	float other = engineConfiguration->injTimeUseTps
+		? Sensor::getOrZero(SensorType::Map)
+		: Sensor::getOrZero(SensorType::Tps1);
+	float percent = interpolate2d(other, config->injTimeLoadCompBins, config->injTimeLoadComp);
+	return 1 + percent / 100;
+}
+
 mass_t getInjectionTimeTableFuelMass(float rpm) {
-	floatms_t pulseMs = interpolate3d(
-		getActiveInjTimeTable(),
-		config->injTimeLoadBins, getInjectionTimeTableLoad(),
-		config->injTimeRpmBins, rpm
-	);
+	floatms_t pulseMs = isInjectionTimeIdleActive()
+		? interpolate2d(rpm, config->injTimeIdleRpmBins, config->injTimeIdleTable)
+		: interpolate3d(
+			getActiveInjTimeTable(),
+			config->injTimeLoadBins, getInjectionTimeTableLoad(),
+			config->injTimeRpmBins, rpm
+		);
 
-	return convertInjectionTimeToFuelMass(pulseMs);
+	// the compensation scales only the useful part of the pulse, deadtime stays
+	return convertInjectionTimeToFuelMass(pulseMs) * getInjectionTimeLoadCompensation();
 }
 
 // Per-cylinder base fuel mass
diff --git a/firmware/controllers/algo/fuel_math.h b/firmware/controllers/algo/fuel_math.h
index b7810a492e7..5c9f596450d 100644
--- a/firmware/controllers/algo/fuel_math.h
+++ b/firmware/controllers/algo/fuel_math.h
@@ -41,6 +41,8 @@ float getStage2InjectionFraction(float rpm, float fuelLoad);
 float getStandardAirCharge();
 
 // Injection time (ms) fuel strategy, see LM_INJ_TIME
+bool isInjectionTimeIdleActive();
+float getInjectionTimeLoadCompensation();
 #define INJ_TIME_REFERENCE_VOLTAGE 14.0f
 floatms_t getInjectionTimeReferenceDeadtime();
 mass_t convertInjectionTimeToFuelMass(floatms_t pulseMs);
diff --git a/firmware/integration/rusefi_config.txt b/firmware/integration/rusefi_config.txt
index ebe1c57a0df..99d3a25b8d2 100644
--- a/firmware/integration/rusefi_config.txt
+++ b/firmware/integration/rusefi_config.txt
@@ -297,6 +297,8 @@ struct_no_prefix engine_configuration_s
 
 #define FUEL_RPM_COUNT 16
 #define FUEL_LOAD_COUNT 16
+#define INJ_TIME_IDLE_COUNT 16
+#define INJ_TIME_COMP_COUNT 16
 #define INJ_TIME_RPM_COUNT 16
 #define INJ_TIME_LOAD_COUNT 16
 
@@ -1916,8 +1918,8 @@ uint8_t autoscale knockFuelTrim;Maximum Amount of Fuel trim when knock;"%", 1, 0
 	bit transmissionSlipRpmSourceIsInputShaftSpeed,"Input Shaft Speed","Engine RPM";Input Shaft Speed measures internal gearbox slip. Engine RPM also includes clutch or torque-converter slip. Accurate gear ratios are required.
 	bit etbAutoRecoverEnabled,"enabled","disabled";pro-style: turn the electronic throttle back on by itself after a sensor error or a jam, once the sensors read fine again.
 	bit camSyncOnlyAtStart,"at start only","always";pro-style: use the cam only to find the engine phase at start. Once the engine runs with phase sync, cam teeth no longer change the phase (VVT position still works), so a bad cam signal while running cannot shift injection and spark.
-	bit unusedBit_Fancy26
-	bit unusedBit_Fancy27
+	bit injTimeIdleTableEnabled,"enabled","disabled";pro-style idle by TPS: with the Injection time (ms) table on TPS, below the idle TPS threshold the pulse comes from the idle ms-by-RPM curve instead of the main table.
+	bit injTimeLoadCompEnabled,"enabled","disabled";pro-style MAP/TPS compensation: % on the Injection time (ms) fuel by the other load sensor (TPS when the table is on MAP, MAP when it is on TPS).
 	bit unusedBit_Fancy28
 	bit unusedBit_Fancy29
 	bit unusedBit_Fancy30
@@ -2763,6 +2765,10 @@ include_file controllers/modules/fuel_pump/fuel_pump_tables.txt
 uint16_t[INJ_TIME_LOAD_COUNT x INJ_TIME_RPM_COUNT] autoscale injTimeTable;Injector pulse per cylinder per cycle at 14 V, deadtime included. All usual fuel corrections are applied on top.;"ms", 0.001, 0, 0, 65, 3
 uint16_t[INJ_TIME_LOAD_COUNT] injTimeLoadBins;;{injTimeUseTps ? "%" : "kPa"}, 1, 0, 0, 1000, 0
 uint16_t[INJ_TIME_RPM_COUNT] injTimeRpmBins;;"RPM", 1, 0, 0, 18000, 0
+uint16_t[INJ_TIME_IDLE_COUNT] injTimeIdleRpmBins;;"RPM", 1, 0, 0, 5000, 0
+uint16_t[INJ_TIME_IDLE_COUNT] autoscale injTimeIdleTable;Idle by TPS: injector pulse per cylinder per cycle at 14 V, deadtime included, by RPM.;"ms", 0.001, 0, 0, 65, 3
+uint16_t[INJ_TIME_COMP_COUNT] injTimeLoadCompBins;;{injTimeUseTps ? "kPa" : "%"}, 1, 0, 0, 1000, 0
+int16_t[INJ_TIME_COMP_COUNT] autoscale injTimeLoadComp;MAP/TPS compensation in % on the useful part of the Injection time (ms) pulse.;"%", 0.1, 0, -50, 100, 1
 
 ! Progressive rev limiter, see progressiveRevLimitEnabled
 uint16_t progressiveRevLimitWindow;RPM below the rev limit where the progressive spark cut starts.;"RPM", 1, 0, 0, 3000, 0
diff --git a/firmware/tunerstudio/tunerstudio.template.ini b/firmware/tunerstudio/tunerstudio.template.ini
index 13976b8ab02..4f4b0de1bdc 100644
--- a/firmware/tunerstudio/tunerstudio.template.ini
+++ b/firmware/tunerstudio/tunerstudio.template.ini
@@ -620,6 +620,20 @@ include_file @@TUNING_SECTION_FILE@@
 
 @@BOARD_CURVES_FROM_FILE@@
 
+	curve = injTimeIdleCurve, "Idle by TPS (ms by RPM)"
+		columnLabel = "RPM", "Pulse"
+		xAxis		= 0, 3000, 7
+		yAxis		= 0, 5, 6
+		xBins		= injTimeIdleRpmBins, RPMValue
+		yBins		= injTimeIdleTable
+
+	curve = injTimeLoadCompCurve, "MAP/TPS compensation"
+		columnLabel = {injTimeUseTps ? "MAP" : "TPS"}, "Fuel %"
+		xAxis		= 0, 300, 7
+		yAxis		= -30, 30, 7
+		xBins		= injTimeLoadCompBins, { injTimeUseTps ? MAPValue : TPSValue }
+		yBins		= injTimeLoadComp
+
 	curve = fan1PwmCurve, "Fan 1 Speed Demand vs Temperature"
 		columnLabel = "Coolant", "Demand %"
 		xAxis		= @@DEFAULT_CLT_AXIS_LOW_VALUE@@, { cltHighXaxis }, 9
@@ -6338,6 +6352,10 @@ dialog = tcuControls, "Transmission Settings"
 	dialog = injTimeTableDialog, "Injection time (ms)"
 		panel = fuelStrategyPanel
 		panel = injTimeTableTbl
+		field = "Idle by TPS (ms by RPM below idle TPS)",	injTimeIdleTableEnabled, { injTimeUseTps }
+		panel = injTimeIdleCurve, { injTimeUseTps && injTimeIdleTableEnabled }
+		field = "MAP/TPS compensation",			injTimeLoadCompEnabled
+		panel = injTimeLoadCompCurve, { injTimeLoadCompEnabled }
 
 	dialog = veTableDialog3D, @@VE_TABLE_NAME@@
 		topicHelp = "veTableDialogHelp"
diff --git a/unit_tests/tests/ignition_injection/test_injection_time_map.cpp b/unit_tests/tests/ignition_injection/test_injection_time_map.cpp
index 3596abd0cef..362c4e9ab4a 100644
--- a/unit_tests/tests/ignition_injection/test_injection_time_map.cpp
+++ b/unit_tests/tests/ignition_injection/test_injection_time_map.cpp
@@ -97,3 +97,56 @@ TEST_F(InjectionTimeMap, CorrectionsScaleOnlyTheEffectivePulse) {
 	// 1 ms deadtime + 5 ms * 1.1
 	EXPECT_NEAR(6.5f, engine->engineState.injectionDuration, 0.01f);
 }
+
+// Item 61: idle by TPS (pro-style), ms by RPM below the idle TPS threshold
+TEST_F(InjectionTimeMap, IdleByTpsCurve) {
+	setTable(config->injTimeTable, 6.0f);
+	setLinearCurve(config->injTimeIdleRpmBins, 600, 3000, 50);
+	setArrayValues(config->injTimeIdleTable, 3.0f);
+	engineConfiguration->idlePidDeactivationTpsThreshold = 2;
+	engineConfiguration->injTimeUseTps = true;
+	Sensor::setMockValue(SensorType::Tps1, 0);
+
+	// off: main table
+	engineConfiguration->injTimeIdleTableEnabled = false;
+	EXPECT_FALSE(isInjectionTimeIdleActive());
+	EXPECT_NEAR(5.0f * flowGramPerMs(), getInjectionTimeTableFuelMass(1000), 1e-5f);
+
+	// on, throttle closed: idle curve
+	engineConfiguration->injTimeIdleTableEnabled = true;
+	EXPECT_TRUE(isInjectionTimeIdleActive());
+	EXPECT_NEAR(2.0f * flowGramPerMs(), getInjectionTimeTableFuelMass(1000), 1e-5f);
+
+	// throttle open: main table again
+	Sensor::setMockValue(SensorType::Tps1, 10);
+	EXPECT_FALSE(isInjectionTimeIdleActive());
+	EXPECT_NEAR(5.0f * flowGramPerMs(), getInjectionTimeTableFuelMass(1000), 1e-5f);
+
+	// only with the table on TPS
+	Sensor::setMockValue(SensorType::Tps1, 0);
+	engineConfiguration->injTimeUseTps = false;
+	EXPECT_FALSE(isInjectionTimeIdleActive());
+}
+
+// Item 62: MAP/TPS compensation (pro-style), % on the useful pulse by the other load sensor
+TEST_F(InjectionTimeMap, LoadCompensationByOtherSensor) {
+	setTable(config->injTimeTable, 6.0f);
+	setLinearCurve(config->injTimeLoadCompBins, 0, 150, 10);
+	for (size_t i = 0; i < INJ_TIME_COMP_COUNT; i++) {
+		config->injTimeLoadComp[i] = config->injTimeLoadCompBins[i] < 50 ? -10 : 20;
+	}
+
+	engineConfiguration->injTimeLoadCompEnabled = false;
+	EXPECT_NEAR(1, getInjectionTimeLoadCompensation(), EPS4D);
+
+	// table on MAP: compensation by TPS
+	engineConfiguration->injTimeLoadCompEnabled = true;
+	Sensor::setMockValue(SensorType::Tps1, 20);
+	EXPECT_NEAR(0.9f, getInjectionTimeLoadCompensation(), EPS4D);
+	EXPECT_NEAR(4.5f * flowGramPerMs(), getInjectionTimeTableFuelMass(3000), 1e-5f);
+
+	// table on TPS: compensation by MAP
+	engineConfiguration->injTimeUseTps = true;
+	Sensor::setMockValue(SensorType::Map, 140);
+	EXPECT_NEAR(1.2f, getInjectionTimeLoadCompensation(), EPS4D);
+}
