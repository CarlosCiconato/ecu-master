--- /dev/null
+++ b/firmware/controllers/modules/shift_light/shift_light.h
@@ -0,0 +1,40 @@
+/*
+ * @file shift_light.h
+ *
+ * pro-style shift light: one shift RPM per gear (plus one for gear unknown / neutral),
+ * a lamp output (steady or blinking) and live data for the app to flash the screen and draw
+ * the LED bar (progress from shift RPM - pre RPM up to the shift RPM).
+ */
+
+#pragma once
+
+class ShiftLight : public EngineModule {
+public:
+	using interface_t = ShiftLight;
+
+	void onFastCallback() override;
+
+	// gear < 1 or above the table = first entry (gear unknown / neutral)
+	void update(float rpm, int gear, efitick_t nowNt);
+
+	// shift RPM for the gear, 0 = off
+	int getShiftRpm(int gear) const;
+	bool isOn() const {
+		return m_on;
+	}
+	// 0..100 %, LED bar fill
+	uint8_t getProgress() const {
+		return m_progress;
+	}
+	int getTargetRpm() const {
+		return m_target;
+	}
+	// lamp state including blinking
+	bool getLampState(efitick_t nowNt) const;
+
+private:
+	bool m_on = false;
+	uint8_t m_progress = 0;
+	int m_target = 0;
+	efitick_t m_onSince = 0;
+};
