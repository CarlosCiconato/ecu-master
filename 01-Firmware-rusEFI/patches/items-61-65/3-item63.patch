diff --git a/firmware/controllers/modules/shift_light/shift_light.cpp b/firmware/controllers/modules/shift_light/shift_light.cpp
new file mode 100644
index 00000000000..d6ec1cc311a
--- /dev/null
+++ b/firmware/controllers/modules/shift_light/shift_light.cpp
@@ -0,0 +1,71 @@
+#include "pch.h"
+
+#include "shift_light.h"
+
+// RPM below the shift RPM that turns the light off again (no flicker at the limit)
+static constexpr int shiftLightHysteresis = 100;
+
+int ShiftLight::getShiftRpm(int gear) const {
+	if (gear < 1 || gear >= SHIFT_LIGHT_GEARS) {
+		gear = 0;
+	}
+	int rpm = engineConfiguration->shiftLightRpm[gear];
+	// a gear left at 0 uses the 'gear unknown' RPM
+	return rpm > 0 ? rpm : engineConfiguration->shiftLightRpm[0];
+}
+
+void ShiftLight::update(float rpm, int gear, efitick_t nowNt) {
+	m_target = getShiftRpm(gear);
+	if (m_target <= 0) {
+		m_on = false;
+		m_progress = 0;
+		return;
+	}
+
+	bool wasOn = m_on;
+	if (rpm >= m_target) {
+		m_on = true;
+	} else if (rpm < m_target - shiftLightHysteresis) {
+		m_on = false;
+	}
+	if (m_on && !wasOn) {
+		m_onSince = nowNt;
+	}
+
+	int pre = engineConfiguration->shiftLightPreRpm;
+	if (m_on) {
+		m_progress = 100;
+	} else if (pre <= 0) {
+		m_progress = 0;
+	} else {
+		float start = m_target - pre;
+		float progress = (rpm - start) * 100 / pre;
+		m_progress = (uint8_t)clampF(0, progress, 99);
+	}
+}
+
+bool ShiftLight::getLampState(efitick_t nowNt) const {
+	if (!m_on) {
+		return false;
+	}
+	int hz = engineConfiguration->shiftLightBlinkHz;
+	if (hz <= 0) {
+		return true;
+	}
+	// starts lit, half period on, half off
+	float elapsed = NT2US(nowNt - m_onSince) * 1e-6f;
+	int halfPeriods = (int)(elapsed * hz * 2);
+	return (halfPeriods % 2) == 0;
+}
+
+void ShiftLight::onFastCallback() {
+	efitick_t nowNt = getTimeNowNt();
+	auto gear = Sensor::get(SensorType::DetectedGear);
+	int gearNumber = gear ? (int)(gear.Value + 0.5f) : 0;
+	update(Sensor::getOrZero(SensorType::Rpm), gearNumber, nowNt);
+
+	engine->outputChannels.shiftLightTarget = m_target;
+	engine->outputChannels.shiftLightProgress = m_progress;
+	engine->outputChannels.shiftLightOn = m_on;
+	enginePins.shiftLight.setValue(getLampState(nowNt));
+}
