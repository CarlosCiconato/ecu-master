diff --git a/unit_tests/tests/test_shift_light.cpp b/unit_tests/tests/test_shift_light.cpp
new file mode 100644
index 00000000000..d8711d14798
--- /dev/null
+++ b/unit_tests/tests/test_shift_light.cpp
@@ -0,0 +1,80 @@
+#include "pch.h"
+
+#include "shift_light.h"
+
+// pro-style shift light: RPM per gear, LED bar progress, lamp blink
+
+static void setupShiftLight() {
+	engineConfiguration->shiftLightRpm[0] = 7000; // gear unknown
+	engineConfiguration->shiftLightRpm[1] = 6500; // 1st
+	engineConfiguration->shiftLightRpm[2] = 7500; // 2nd
+	engineConfiguration->shiftLightPreRpm = 1000;
+	engineConfiguration->shiftLightBlinkHz = 0;
+}
+
+TEST(ShiftLight, offByDefault) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	ShiftLight light;
+	light.update(9000, 0, getTimeNowNt());
+	EXPECT_FALSE(light.isOn());
+	EXPECT_EQ(0, light.getProgress());
+	EXPECT_EQ(0, light.getTargetRpm());
+}
+
+TEST(ShiftLight, rpmPerGear) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	setupShiftLight();
+	ShiftLight light;
+
+	EXPECT_EQ(6500, light.getShiftRpm(1));
+	EXPECT_EQ(7500, light.getShiftRpm(2));
+	// gear left at 0 and unknown gear use the first value
+	EXPECT_EQ(7000, light.getShiftRpm(3));
+	EXPECT_EQ(7000, light.getShiftRpm(0));
+	EXPECT_EQ(7000, light.getShiftRpm(9));
+
+	light.update(6600, 1, getTimeNowNt());
+	EXPECT_TRUE(light.isOn());
+	light.update(6600, 2, getTimeNowNt());
+	EXPECT_FALSE(light.isOn());
+}
+
+TEST(ShiftLight, barAndHysteresis) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	setupShiftLight();
+	ShiftLight light;
+
+	light.update(5000, 2, getTimeNowNt());
+	EXPECT_EQ(0, light.getProgress());
+	light.update(7000, 2, getTimeNowNt());
+	EXPECT_EQ(50, light.getProgress());
+	EXPECT_FALSE(light.isOn());
+
+	light.update(7500, 2, getTimeNowNt());
+	EXPECT_TRUE(light.isOn());
+	EXPECT_EQ(100, light.getProgress());
+
+	// stays on just below the shift RPM, off 100 RPM below
+	light.update(7450, 2, getTimeNowNt());
+	EXPECT_TRUE(light.isOn());
+	light.update(7390, 2, getTimeNowNt());
+	EXPECT_FALSE(light.isOn());
+}
+
+TEST(ShiftLight, blink) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	setupShiftLight();
+	engineConfiguration->shiftLightBlinkHz = 5; // 100 ms on, 100 ms off
+	ShiftLight light;
+
+	light.update(8000, 0, getTimeNowNt());
+	EXPECT_TRUE(light.getLampState(getTimeNowNt()));
+	advanceTimeUs(150'000);
+	EXPECT_FALSE(light.getLampState(getTimeNowNt()));
+	advanceTimeUs(100'000);
+	EXPECT_TRUE(light.getLampState(getTimeNowNt()));
+
+	engineConfiguration->shiftLightBlinkHz = 0;
+	advanceTimeUs(100'000);
+	EXPECT_TRUE(light.getLampState(getTimeNowNt()));
+}
