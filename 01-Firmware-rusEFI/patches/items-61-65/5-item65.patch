diff --git a/firmware/controllers/modules/traction_wheels/traction_wheels.cpp b/firmware/controllers/modules/traction_wheels/traction_wheels.cpp
new file mode 100644
index 00000000000..a293c3e9b71
--- /dev/null
+++ b/firmware/controllers/modules/traction_wheels/traction_wheels.cpp
@@ -0,0 +1,162 @@
+#include "pch.h"
+
+#include "traction_wheels.h"
+
+// a CAN wheel speed older than this is not used
+static constexpr float canWheelTimeoutSec = 0.5f;
+
+float TractionWheels::wiredHzToKph(float hz, int pulsesPerRev) {
+	if (pulsesPerRev <= 0) {
+		return 0;
+	}
+	// revs per second x circumference (m) = m/s, x 3.6 = km/h
+	float circumferenceM = engineConfiguration->tcTireCircumference / 1000.0f;
+	return hz / pulsesPerRev * circumferenceM * 3.6f;
+}
+
+void TractionWheels::setCanWheelSpeed(TcWheel wheel, float kph, efitick_t nowNt) {
+	size_t i = (size_t)wheel;
+	if (i >= TC_WHEEL_COUNT) {
+		return;
+	}
+	m_canSpeed[i] = kph;
+	m_canTime[i] = nowNt;
+	m_canSeen[i] = true;
+}
+
+expected<float> TractionWheels::canAxle(TcWheel left, TcWheel right, efitick_t nowNt) const {
+	float sum = 0;
+	int count = 0;
+	for (auto wheel : { left, right }) {
+		size_t i = (size_t)wheel;
+		if (m_canSeen[i] && NT2US(nowNt - m_canTime[i]) * 1e-6f < canWheelTimeoutSec) {
+			sum += m_canSpeed[i];
+			count++;
+		}
+	}
+	if (count == 0) {
+		return unexpected;
+	}
+	return sum / count;
+}
+
+static expected<float> wiredAxle(SensorType type, int pulsesPerRev) {
+	auto hz = Sensor::get(type);
+	if (!hz) {
+		return unexpected;
+	}
+	return TractionWheels::wiredHzToKph(hz.Value, pulsesPerRev);
+}
+
+expected<float> TractionWheels::getFrontSpeed(efitick_t nowNt) const {
+	switch (engineConfiguration->tcWheelSource) {
+	case TC_WHEELS_WIRED:
+		return wiredAxle(SensorType::AuxSpeed1, engineConfiguration->tcFrontPulsesPerRev);
+	case TC_WHEELS_CAN:
+		return canAxle(TcWheel::FrontLeft, TcWheel::FrontRight, nowNt);
+	default:
+		return unexpected;
+	}
+}
+
+expected<float> TractionWheels::getRearSpeed(efitick_t nowNt) const {
+	switch (engineConfiguration->tcWheelSource) {
+	case TC_WHEELS_WIRED:
+		return wiredAxle(SensorType::AuxSpeed2, engineConfiguration->tcRearPulsesPerRev);
+	case TC_WHEELS_CAN:
+		return canAxle(TcWheel::RearLeft, TcWheel::RearRight, nowNt);
+	default:
+		return unexpected;
+	}
+}
+
+bool TractionWheels::isEnabledBySwitch() const {
+#if EFI_GPIO_HARDWARE
+	if (isBrainPinValid(engineConfiguration->tcSwitchPin)) {
+		return efiReadPin(engineConfiguration->tcSwitchPin, engineConfiguration->tcSwitchPinMode);
+	}
+#endif
+	// no switch: always on
+	return true;
+}
+
+expected<float> TractionWheels::getSlipRatio(efitick_t nowNt) const {
+	if (engineConfiguration->tcWheelSource == TC_WHEELS_OFF || !isEnabledBySwitch()) {
+		return unexpected;
+	}
+	auto front = getFrontSpeed(nowNt);
+	auto rear = getRearSpeed(nowNt);
+	if (!front || !rear) {
+		return unexpected;
+	}
+	bool frontDriven = engineConfiguration->tcFrontWheelDrive;
+	float driven = frontDriven ? front.Value : rear.Value;
+	float free = frontDriven ? rear.Value : front.Value;
+	if (free < std::max<float>(engineConfiguration->tcMinSpeed, 1)) {
+		return unexpected;
+	}
+	return driven / free;
+}
+
+expected<float> TractionWheels::getSlipPercent(efitick_t nowNt) const {
+	auto ratio = getSlipRatio(nowNt);
+	if (!ratio) {
+		return unexpected;
+	}
+	return (ratio.Value - 1) * 100;
+}
+
+void TractionWheels::onSlowCallback() {
+	efitick_t nowNt = getTimeNowNt();
+	engine->outputChannels.wheelSpeedFront = getFrontSpeed(nowNt).value_or(0);
+	engine->outputChannels.wheelSpeedRear = getRearSpeed(nowNt).value_or(0);
+	engine->outputChannels.wheelSlip = getSlipPercent(nowNt).value_or(0);
+}
+
+class TractionSlipSensor : public Sensor {
+public:
+	TractionSlipSensor() : Sensor(SensorType::WheelSlipRatio) {}
+
+	SensorResult get() const final override {
+		auto ratio = engine->module<TractionWheels>().unmock().getSlipRatio(getTimeNowNt());
+		if (!ratio) {
+			return UnexpectedCode::Unknown;
+		}
+		return ratio.Value;
+	}
+
+	void showInfo(const char*) const override {}
+};
+
+// vehicle speed from the free (not driven) axle, only when no other speed sensor exists
+class FreeAxleSpeedSensor : public Sensor {
+public:
+	FreeAxleSpeedSensor() : Sensor(SensorType::VehicleSpeed) {}
+
+	SensorResult get() const final override {
+		auto& wheels = engine->module<TractionWheels>().unmock();
+		efitick_t nowNt = getTimeNowNt();
+		auto speed = engineConfiguration->tcFrontWheelDrive ? wheels.getRearSpeed(nowNt) : wheels.getFrontSpeed(nowNt);
+		if (!speed) {
+			return UnexpectedCode::Unknown;
+		}
+		return speed.Value;
+	}
+
+	void showInfo(const char*) const override {}
+};
+
+static TractionSlipSensor slipSensor;
+static FreeAxleSpeedSensor freeAxleSpeed;
+
+void initTractionWheels() {
+	if (engineConfiguration->tcWheelSource == TC_WHEELS_OFF) {
+		return;
+	}
+	if (!Sensor::hasSensor(SensorType::WheelSlipRatio)) {
+		slipSensor.Register();
+	}
+	if (!Sensor::hasSensor(SensorType::VehicleSpeed)) {
+		freeAxleSpeed.Register();
+	}
+}
diff --git a/firmware/controllers/modules/traction_wheels/traction_wheels.h b/firmware/controllers/modules/traction_wheels/traction_wheels.h
new file mode 100644
index 00000000000..8307ae1b490
--- /dev/null
+++ b/firmware/controllers/modules/traction_wheels/traction_wheels.h
@@ -0,0 +1,54 @@
+/*
+ * @file traction_wheels.h
+ *
+ * Wheel speeds for traction control, from wired sensors or from the CAN network.
+ * - wired: aux speed input 1 = front wheel, aux speed input 2 = rear wheel, turned into
+ *   km/h with the teeth of each tone ring and the tire circumference
+ * - CAN: four wheel speeds in km/h received by the custom CAN frames (any ABS, when its
+ *   frame layout is known) or by the pro CAN slots, targets 'Wheel speed FL/FR/RL/RR'
+ * The axle speed is the average of the wheels that work. Slip = driven axle / free axle,
+ * published as the WheelSlipRatio sensor that the traction control tables already use
+ * (timing drop, spark skip and throttle drop by slip x speed).
+ */
+
+#pragma once
+
+#define TC_WHEEL_COUNT 4
+
+enum class TcWheel : uint8_t {
+	FrontLeft = 0,
+	FrontRight = 1,
+	RearLeft = 2,
+	RearRight = 3,
+};
+
+class TractionWheels : public EngineModule {
+public:
+	using interface_t = TractionWheels;
+
+	void onSlowCallback() override;
+
+	void setCanWheelSpeed(TcWheel wheel, float kph, efitick_t nowNt);
+
+	expected<float> getFrontSpeed(efitick_t nowNt) const;
+	expected<float> getRearSpeed(efitick_t nowNt) const;
+	// driven / free, unexpected when off, switched off, a speed is missing or below the minimum speed
+	expected<float> getSlipRatio(efitick_t nowNt) const;
+	// (driven - free) / free in %
+	expected<float> getSlipPercent(efitick_t nowNt) const;
+
+	bool isEnabledBySwitch() const;
+
+	// wired sensor frequency (Hz) to km/h
+	static float wiredHzToKph(float hz, int pulsesPerRev);
+
+private:
+	expected<float> canAxle(TcWheel left, TcWheel right, efitick_t nowNt) const;
+
+	float m_canSpeed[TC_WHEEL_COUNT] = {};
+	efitick_t m_canTime[TC_WHEEL_COUNT] = {};
+	bool m_canSeen[TC_WHEEL_COUNT] = {};
+};
+
+// registers the wheel slip sensor when a wheel speed source is chosen (after the other sensors)
+void initTractionWheels();
