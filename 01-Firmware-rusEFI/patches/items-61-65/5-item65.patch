diff --git a/unit_tests/tests/test_traction_wheels.cpp b/unit_tests/tests/test_traction_wheels.cpp
new file mode 100644
index 00000000000..2b7f2ef2022
--- /dev/null
+++ b/unit_tests/tests/test_traction_wheels.cpp
@@ -0,0 +1,87 @@
+#include "pch.h"
+
+#include "traction_wheels.h"
+#include "ftcan_receiver.h"
+#include "gppwm_channel_reader.h"
+
+// Traction control wheel speeds from wired sensors or CAN, wheel slip
+
+static void setupCan() {
+	engineConfiguration->tcWheelSource = TC_WHEELS_CAN;
+	engineConfiguration->tcFrontWheelDrive = 0; // rear drive
+	engineConfiguration->tcMinSpeed = 10;
+}
+
+TEST(TractionWheels, offByDefault) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	auto& tc = engine->module<TractionWheels>().unmock();
+	tc.setCanWheelSpeed(TcWheel::RearLeft, 50, getTimeNowNt());
+	EXPECT_FALSE(tc.getSlipRatio(getTimeNowNt()));
+}
+
+TEST(TractionWheels, canSlipRearDrive) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	setupCan();
+	auto& tc = engine->module<TractionWheels>().unmock();
+	efitick_t now = getTimeNowNt();
+
+	// CAN targets reach the wheels
+	setCanTargetValue(FTCAN_TARGET_WHEEL_FL, 50, now);
+	setCanTargetValue(FTCAN_TARGET_WHEEL_FR, 50, now);
+	setCanTargetValue(FTCAN_TARGET_WHEEL_RL, 55, now);
+	setCanTargetValue(FTCAN_TARGET_WHEEL_RR, 65, now);
+
+	EXPECT_NEAR(50, tc.getFrontSpeed(now).value_or(0), 1e-4);
+	EXPECT_NEAR(60, tc.getRearSpeed(now).value_or(0), 1e-4);
+	EXPECT_NEAR(1.2, tc.getSlipRatio(now).value_or(0), 1e-4);
+	EXPECT_NEAR(20, tc.getSlipPercent(now).value_or(0), 1e-3);
+	EXPECT_NEAR(20, readGppwmChannel(GPPWM_WheelSlip).value_or(0), 1e-3);
+
+	// one wheel per axle is enough
+	advanceTimeUs(300'000);
+	now = getTimeNowNt();
+	tc.setCanWheelSpeed(TcWheel::FrontLeft, 40, now);
+	tc.setCanWheelSpeed(TcWheel::RearLeft, 44, now);
+	advanceTimeUs(300'000);
+	now = getTimeNowNt();
+	EXPECT_NEAR(1.1, tc.getSlipRatio(now).value_or(0), 1e-4);
+
+	// all CAN data old: no slip
+	advanceTimeUs(600'000);
+	EXPECT_FALSE(tc.getSlipRatio(getTimeNowNt()));
+}
+
+TEST(TractionWheels, frontDriveAndMinSpeed) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	setupCan();
+	engineConfiguration->tcFrontWheelDrive = 1;
+	auto& tc = engine->module<TractionWheels>().unmock();
+	efitick_t now = getTimeNowNt();
+
+	tc.setCanWheelSpeed(TcWheel::FrontLeft, 30, now);
+	tc.setCanWheelSpeed(TcWheel::RearLeft, 25, now);
+	EXPECT_NEAR(1.2, tc.getSlipRatio(now).value_or(0), 1e-4);
+
+	// free axle below the minimum speed: no slip (standing start wheelspin is launch control)
+	tc.setCanWheelSpeed(TcWheel::FrontLeft, 20, now);
+	tc.setCanWheelSpeed(TcWheel::RearLeft, 5, now);
+	EXPECT_FALSE(tc.getSlipRatio(now));
+}
+
+TEST(TractionWheels, wiredSpeedFromToneRing) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	engineConfiguration->tcWheelSource = TC_WHEELS_WIRED;
+	engineConfiguration->tcFrontPulsesPerRev = 48;
+	engineConfiguration->tcRearPulsesPerRev = 48;
+	engineConfiguration->tcTireCircumference = 2000; // mm
+	engineConfiguration->tcMinSpeed = 10;
+	auto& tc = engine->module<TractionWheels>().unmock();
+
+	// 48 pulses per turn, 10 turns/s = 480 Hz = 20 m/s = 72 km/h
+	EXPECT_NEAR(72, TractionWheels::wiredHzToKph(480, 48), 1e-3);
+
+	Sensor::setMockValue(SensorType::AuxSpeed1, 480);
+	Sensor::setMockValue(SensorType::AuxSpeed2, 528);
+	EXPECT_NEAR(72, tc.getFrontSpeed(getTimeNowNt()).value_or(0), 1e-3);
+	EXPECT_NEAR(1.1, tc.getSlipRatio(getTimeNowNt()).value_or(0), 1e-4);
+}
