diff --git a/unit_tests/tests/test_water_methanol.cpp b/unit_tests/tests/test_water_methanol.cpp
new file mode 100644
index 00000000000..c2c700f7c55
--- /dev/null
+++ b/unit_tests/tests/test_water_methanol.cpp
@@ -0,0 +1,82 @@
+#include "pch.h"
+
+#include "water_methanol.h"
+#include "gppwm_channel_reader.h"
+
+// Water/methanol injection: tank level, fault, timing and fuel while flowing
+
+static void setupWmi() {
+	engineConfiguration->wmiGppwmChannel = 2; // Generic PWM 2
+	engineConfiguration->wmiActiveDuty = 10;
+	engineConfiguration->wmiLevelDelay = 1;
+	engineConfiguration->wmiTimingAdd = 4;
+	engineConfiguration->wmiFuelTrim = -10;
+}
+
+TEST(WaterMethanol, offByDefault) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	WaterMethanol wmi;
+	EXPECT_EQ(60, wmi.filterDuty(1, 60));
+	EXPECT_EQ(WmiStatus::Off, wmi.getStatus());
+	EXPECT_EQ(0, wmi.getTimingAdd());
+	EXPECT_EQ(1, wmi.getFuelCoefficient());
+}
+
+TEST(WaterMethanol, flowingAddsTimingAndFuelByDuty) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	setupWmi();
+	WaterMethanol wmi;
+
+	// other outputs pass untouched
+	EXPECT_EQ(30, wmi.filterDuty(0, 30));
+	EXPECT_EQ(WmiStatus::Ready, wmi.getStatus());
+
+	EXPECT_EQ(50, wmi.filterDuty(1, 50));
+	EXPECT_EQ(WmiStatus::Flowing, wmi.getStatus());
+	EXPECT_NEAR(2, wmi.getTimingAdd(), 1e-4);
+	EXPECT_NEAR(0.95, wmi.getFuelCoefficient(), 1e-4);
+
+	// below the flowing duty: nothing added
+	wmi.filterDuty(1, 5);
+	EXPECT_EQ(WmiStatus::Ready, wmi.getStatus());
+	EXPECT_EQ(0, wmi.getTimingAdd());
+}
+
+TEST(WaterMethanol, tankLowStopsOutputAfterDelayAndFaults) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	setupWmi();
+	WaterMethanol wmi;
+
+	wmi.updateLevel(false, getTimeNowNt());
+	wmi.updateLevel(true, getTimeNowNt());
+	advanceTimeUs(500'000);
+	wmi.updateLevel(true, getTimeNowNt());
+	EXPECT_FALSE(wmi.isTankLow());
+	EXPECT_EQ(50, wmi.filterDuty(1, 50));
+
+	advanceTimeUs(600'000);
+	wmi.updateLevel(true, getTimeNowNt());
+	EXPECT_TRUE(wmi.isTankLow());
+	EXPECT_EQ(0, wmi.filterDuty(1, 50));
+	EXPECT_EQ(WmiStatus::Fault, wmi.getStatus());
+	EXPECT_EQ(0, wmi.getTimingAdd());
+	EXPECT_EQ(1, wmi.getFuelCoefficient());
+
+	// not asked: tank low only, no fault
+	wmi.filterDuty(1, 0);
+	EXPECT_EQ(WmiStatus::TankLow, wmi.getStatus());
+	EXPECT_FALSE(wmi.isFault());
+}
+
+TEST(WaterMethanol, faultAlertChannel) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	setupWmi();
+	auto& wmi = engine->module<WaterMethanol>().unmock();
+	EXPECT_EQ(0, readGppwmChannel(GPPWM_WmiFault).value_or(-1));
+
+	wmi.updateLevel(true, getTimeNowNt());
+	advanceTimeUs(1'100'000);
+	wmi.updateLevel(true, getTimeNowNt());
+	wmi.filterDuty(1, 80);
+	EXPECT_EQ(1, readGppwmChannel(GPPWM_WmiFault).value_or(-1));
+}
