diff --git a/firmware/controllers/modules/water_methanol/water_methanol.cpp b/firmware/controllers/modules/water_methanol/water_methanol.cpp
new file mode 100644
index 00000000000..94b19c90e82
--- /dev/null
+++ b/firmware/controllers/modules/water_methanol/water_methanol.cpp
@@ -0,0 +1,72 @@
+#include "pch.h"
+
+#include "water_methanol.h"
+
+bool WaterMethanol::isWmiOutput(size_t gppwmIndex) const {
+	int channel = engineConfiguration->wmiGppwmChannel;
+	return channel > 0 && (size_t)(channel - 1) == gppwmIndex;
+}
+
+void WaterMethanol::updateLevel(bool lowSwitch, efitick_t nowNt) {
+	if (lowSwitch != m_lastSwitch) {
+		m_lastSwitch = lowSwitch;
+		m_switchTimer.reset(nowNt);
+	}
+	// tank slosh: the switch has to stay put for the delay before the state changes
+	if (m_tankLow != lowSwitch && m_switchTimer.getElapsedSeconds(nowNt) >= engineConfiguration->wmiLevelDelay) {
+		m_tankLow = lowSwitch;
+	}
+}
+
+float WaterMethanol::filterDuty(size_t gppwmIndex, float requestedDuty) {
+	if (!isWmiOutput(gppwmIndex)) {
+		return requestedDuty;
+	}
+	m_requestedDuty = requestedDuty;
+	return m_tankLow ? 0 : requestedDuty;
+}
+
+float WaterMethanol::getDuty() const {
+	if (engineConfiguration->wmiGppwmChannel == 0 || m_tankLow) {
+		return 0;
+	}
+	return m_requestedDuty;
+}
+
+WmiStatus WaterMethanol::getStatus() const {
+	if (engineConfiguration->wmiGppwmChannel == 0) {
+		return WmiStatus::Off;
+	}
+	bool asked = m_requestedDuty > engineConfiguration->wmiActiveDuty;
+	if (m_tankLow) {
+		return asked ? WmiStatus::Fault : WmiStatus::TankLow;
+	}
+	return asked ? WmiStatus::Flowing : WmiStatus::Ready;
+}
+
+angle_t WaterMethanol::getTimingAdd() const {
+	if (getStatus() != WmiStatus::Flowing) {
+		return 0;
+	}
+	return engineConfiguration->wmiTimingAdd * clampF(0, getDuty(), 100) / 100;
+}
+
+float WaterMethanol::getFuelCoefficient() const {
+	if (getStatus() != WmiStatus::Flowing) {
+		return 1;
+	}
+	return 1 + engineConfiguration->wmiFuelTrim * clampF(0, getDuty(), 100) / 100 / 100;
+}
+
+void WaterMethanol::onSlowCallback() {
+#if EFI_GPIO_HARDWARE
+	bool low = isBrainPinValid(engineConfiguration->wmiLevelPin)
+		&& efiReadPin(engineConfiguration->wmiLevelPin, engineConfiguration->wmiLevelPinMode);
+#else
+	bool low = false;
+#endif
+	updateLevel(low, getTimeNowNt());
+
+	engine->outputChannels.wmiDuty = getDuty();
+	engine->outputChannels.wmiStatus = (uint8_t)getStatus();
+}
diff --git a/firmware/controllers/modules/water_methanol/water_methanol.h b/firmware/controllers/modules/water_methanol/water_methanol.h
new file mode 100644
index 00000000000..94c0805f355
--- /dev/null
+++ b/firmware/controllers/modules/water_methanol/water_methanol.h
@@ -0,0 +1,58 @@
+/*
+ * @file water_methanol.h
+ *
+ * Water/methanol injection (WMI). The nozzle valve or the pump is one of the generic PWM
+ * outputs (duty table by MAP x RPM, also on/off); this module adds what a WMI kit needs:
+ * - tank level switch: with the tank low the WMI output is turned off (the pump does not
+ *   run dry) and 'WMI fault' turns on while the table asks for WMI, so an alert can cut
+ *   boost (safe mode) or warn
+ * - timing added and fuel trim while WMI flows, scaled by the duty (full value at 100 %)
+ */
+
+#pragma once
+
+#include <rusefi/timer.h>
+
+enum class WmiStatus : uint8_t {
+	Off = 0,		// no generic PWM output chosen
+	Ready = 1,		// table asks for no WMI now
+	Flowing = 2,
+	TankLow = 3,	// tank low, WMI not asked now
+	Fault = 4,		// WMI asked but the tank is low: output kept off
+};
+
+class WaterMethanol : public EngineModule {
+public:
+	using interface_t = WaterMethanol;
+
+	void onSlowCallback() override;
+
+	// level switch reading (true = tank low), debounced with wmiLevelDelay
+	void updateLevel(bool lowSwitch, efitick_t nowNt);
+
+	// called by the generic PWM output: duty asked by its table; returns the duty to use
+	float filterDuty(size_t gppwmIndex, float requestedDuty);
+
+	bool isWmiOutput(size_t gppwmIndex) const;
+	bool isTankLow() const {
+		return m_tankLow;
+	}
+	float getRequestedDuty() const {
+		return m_requestedDuty;
+	}
+	// actual duty, 0 while blocked
+	float getDuty() const;
+	WmiStatus getStatus() const;
+	bool isFault() const {
+		return getStatus() == WmiStatus::Fault;
+	}
+
+	angle_t getTimingAdd() const;
+	float getFuelCoefficient() const;
+
+private:
+	bool m_tankLow = false;
+	bool m_lastSwitch = false;
+	Timer m_switchTimer;
+	float m_requestedDuty = 0;
+};
