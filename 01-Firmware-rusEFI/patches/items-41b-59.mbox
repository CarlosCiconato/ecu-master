diff --git a/unit_tests/tests/test_egt_rise.cpp b/unit_tests/tests/test_egt_rise.cpp
new file mode 100644
index 0000000000..68c93745d5
--- /dev/null
+++ b/unit_tests/tests/test_egt_rise.cpp
@@ -0,0 +1,64 @@
+#include "pch.h"
+
+#include "egt_rise_monitor.h"
+#include "gppwm_channel_reader.h"
+
+// pro-style "fast EGT rise" alert sensor
+
+static void feed(EgtRiseMonitor& mon, float startTemp, float ratePerSecond, float seconds, size_t cylinder = 0) {
+	const float dt = 0.05f;
+	float temp = startTemp;
+	for (float t = 0; t < seconds; t += dt) {
+		SensorResult egts[EGT_RISE_COUNT] = {unexpected, unexpected, unexpected, unexpected, unexpected, unexpected, unexpected, unexpected};
+		for (size_t i = 0; i < EGT_RISE_COUNT; i++) {
+			egts[i] = (i == cylinder) ? SensorResult(temp) : SensorResult(500.0f);
+		}
+		mon.update(egts, EGT_RISE_COUNT, dt);
+		temp += ratePerSecond * dt;
+	}
+}
+
+TEST(EgtRise, steadyTemperatureIsZero) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	EgtRiseMonitor mon;
