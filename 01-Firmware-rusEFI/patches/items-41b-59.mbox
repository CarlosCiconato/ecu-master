diff --git a/firmware/controllers/limp_manager.cpp b/firmware/controllers/limp_manager.cpp
index e8049595ba..4850c9a021 100644
--- a/firmware/controllers/limp_manager.cpp
+++ b/firmware/controllers/limp_manager.cpp
@@ -214,6 +214,7 @@ void LimpManager::updateState(float rpm, efitick_t nowNt) {
 		m_boostCutHysteresis = {};
 	}
 
+	bool oilCutNow = false;
 	if (engine->rpmCalculator.isRunning()) {
 		bool hasOilpSensor = Sensor::hasSensor(SensorType::OilPressure);
 		auto oilp = Sensor::get(SensorType::OilPressure);
@@ -223,7 +224,11 @@ void LimpManager::updateState(float rpm, efitick_t nowNt) {
 		// Only check if the setting is enabled and you have an oil pressure sensor
 		if (minOilPressure > 0 && hasOilpSensor) {
 			// Has it been long enough we should have pressure?
-			bool isTimedOut = engine->rpmCalculator.getSecondsSinceEngineStart(nowNt) > 5.0f;
+			// pro/outra-ecu style: the time to build pressure can be set, 0 = 5 s as before
+			float startTimeout = engineConfiguration->oilPressureStartTimeout > 0
+				? (float)engineConfiguration->oilPressureStartTimeout
+				: 5.0f;
+			bool isTimedOut = engine->rpmCalculator.getSecondsSinceEngineStart(nowNt) > startTimeout;
 			isInAfterStartWindow = !isTimedOut;
 
 			// Only check before timed out
@@ -239,6 +244,7 @@ void LimpManager::updateState(float rpm, efitick_t nowNt) {
 			// If time is up, the sensor works, and no pressure, kill the engine.
 			if (isTimedOut && !m_hadOilPressureAfterStart) {
 				allowFuel.clear(ClearReason::OilPressure);
+				oilCutNow = true;
 			}
 		}
 
@@ -255,6 +261,7 @@ void LimpManager::updateState(float rpm, efitick_t nowNt) {
 			if (!isPressureSufficient && !isInAfterStartWindow
 				&& m_lowOilPressureTimer.hasElapsedSec(engineConfiguration->minimumOilPressureTimeout)) {
 				allowFuel.clear(ClearReason::OilPressure);
+				oilCutNow = true;
 			}
 		}
 
@@ -280,6 +287,16 @@ void LimpManager::updateState(float rpm, efitick_t nowNt) {
 		m_highOilPressureTimer.reset(nowNt);
 	}
 
+	// An alert on oil pressure that shut the engine off counts as a low oil pressure shutdown too
+	if (engine->module<AlertManager>()->isEngineOffBy(GPPWM_OilPressure)) {
+		oilCutNow = true;
+	}
+	updateOilRestartLock(engine->rpmCalculator.isRunning(), oilCutNow, nowNt);
+	if (m_oilRestartLocked) {
+		allowFuel.clear(ClearReason::OilRestartLock);
+		allowSpark.clear(ClearReason::OilRestartLock);
+	}
+
 	// If we're in the engine-stop window (a stop was requested recently via start button, Lua,
 	// console, TS command or a board hook - see ShutdownController::isEngineStop and
 	// StopRequestedReason), inhibit fuel so the engine actually winds down instead of restarting
@@ -375,7 +392,39 @@ void LimpManager::updateState(float rpm, efitick_t nowNt) {
 	}
 }
 
+void LimpManager::updateOilRestartLock(bool isRunning, bool oilCutNow, efitick_t nowNt) {
+	if (isRunning && oilCutNow) {
+		m_oilCutWhileRunning = true;
+	}
+
+	if (m_oilRestartLocked
+		&& m_oilRestartLockTimer.hasElapsedSec(engineConfiguration->oilRestartLockTime)) {
+		m_oilRestartLocked = false;
+	}
+
+	// The engine stopped after a low oil pressure cut: block the next start for a while
+	if (m_oilCutWhileRunning && engine->rpmCalculator.isStopped()) {
+		m_oilCutWhileRunning = false;
+		if (engineConfiguration->oilRestartLockTime > 0) {
+			m_oilRestartLocked = true;
+			m_oilRestartLockTimer.reset(nowNt);
+		}
+	}
+}
+
+float LimpManager::getOilRestartLockLeft(efitick_t nowNt) const {
+	if (!m_oilRestartLocked) {
+		return 0;
+	}
+	return std::max(0.0f, engineConfiguration->oilRestartLockTime - m_oilRestartLockTimer.getElapsedSeconds(nowNt));
+}
+
 void LimpManager::onIgnitionStateChanged(bool ignitionOn) {
+	// Turning the key off ends the oil restart lock
+	if (!ignitionOn) {
+		m_oilRestartLocked = false;
+		m_oilCutWhileRunning = false;
+	}
 	m_ignitionOn = ignitionOn;
 }
 
