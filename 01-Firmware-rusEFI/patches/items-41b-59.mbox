new file mode 100644
index 0000000000..c33764ec4b
--- /dev/null
+++ b/firmware/controllers/modules/egt_rise/egt_rise_monitor.cpp
@@ -0,0 +1,77 @@
+#include "pch.h"
+
+#include "egt_rise_monitor.h"
+
+void EgtRiseMonitor::update(const SensorResult* egts, size_t count, float dtSeconds) {
+	count = std::min<size_t>(count, EGT_RISE_COUNT);
+
+	for (size_t i = 0; i < count; i++) {
+		if (!egts[i]) {
+			// sensor not working: forget its history
+			m_valid[i] = false;
+			m_hasWindowStart[i] = false;
+			m_rate[i] = 0;
+		} else {
+			m_valid[i] = true;
+		}
+	}
+
+	m_elapsed += dtSeconds;
+	if (m_elapsed < sampleTime) {
+		return;
+	}
+
+	float elapsed = m_elapsed;
+	m_elapsed = 0;
+
+	// first order smoothing, about smoothTime long
+	float alpha = elapsed / (smoothTime + elapsed);
+
+	for (size_t i = 0; i < count; i++) {
+		if (!egts[i]) {
+			continue;
+		}
+
+		float temp = egts[i].Value;
+		if (m_hasWindowStart[i]) {
+			float raw = (temp - m_windowStart[i]) / elapsed;
+			m_rate[i] += alpha * (raw - m_rate[i]);
+		}
+		m_windowStart[i] = temp;
+		m_hasWindowStart[i] = true;
+	}
+}
+
+expected<float> EgtRiseMonitor::getMaxRiseRate() const {
+	expected<float> result = unexpected;
+	for (size_t i = 0; i < EGT_RISE_COUNT; i++) {
+		if (m_valid[i] && (!result || m_rate[i] > result.Value)) {
+			result = m_rate[i];
+		}
+	}
+	return result;
+}
+
+float EgtRiseMonitor::getRiseRate(size_t index) const {
+	return index < EGT_RISE_COUNT ? m_rate[index] : 0;
+}
+
+void EgtRiseMonitor::onSlowCallback() {
+	efitick_t nowNt = getTimeNowNt();
+	float dt = m_timerStarted ? m_timer.getElapsedSecondsAndReset(nowNt) : 0;
+	if (!m_timerStarted) {
+		m_timer.reset(nowNt);
+		m_timerStarted = true;
+	}
+	// a long pause (debugger, first call) must not look like a slow rise
+	dt = std::min(dt, 1.0f);
+
+	SensorResult egts[EGT_RISE_COUNT] = {unexpected, unexpected, unexpected, unexpected, unexpected, unexpected, unexpected, unexpected};
+	for (size_t i = 0; i < EGT_RISE_COUNT; i++) {
+		egts[i] = Sensor::get(static_cast<SensorType>(static_cast<int>(SensorType::EGT1) + i));
+	}
+	update(egts, EGT_RISE_COUNT, dt);
+
+	auto maxRate = getMaxRiseRate();
+	engine->outputChannels.egtRiseRate = maxRate ? maxRate.Value : 0;
+}
