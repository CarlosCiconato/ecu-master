+/*
+ * @file downshift_blip.h
+ *
+ * outra-ecu-style throttle blip on downshift ("punta-taco") with the electronic throttle:
+ * pressing the blip button (or a micro switch on the clutch or the gear lever) adds a
+ * throttle opening for a set time, only above a minimum RPM. The added opening goes on
+ * top of the pedal target, before the throttle maximum and the throttle rev limiter.
+ */
+
+#pragma once
+
+#include <rusefi/timer.h>
+
+class DownshiftBlip : public EngineModule {
+public:
+	using interface_t = DownshiftBlip;
+
+	void onFastCallback() override;
+
+	void update(bool buttonPressed, float rpm, efitick_t nowNt);
+
+	// throttle opening to add right now, in %
+	float getThrottleAdd(efitick_t nowNt) const;
+	bool isActive(efitick_t nowNt) const;
+
+private:
+	bool m_wasPressed = false;
+	bool m_started = false;
+	Timer m_blipTimer;
+};
