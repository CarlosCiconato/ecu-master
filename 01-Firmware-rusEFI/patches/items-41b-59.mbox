@@ -0,0 +1,39 @@
+/*
+ * @file egt_rise_monitor.h
+ *
+ * pro-style "fast EGT rise" alert sensor: how fast each EGT is going up, in C per
+ * second. The temperature is sampled every half second and the rate is smoothed over about
+ * a second, so thermocouple noise does not trip the alert. The fastest rising EGT is the
+ * alert sensor "EGT rise rate".
+ */
+
+#pragma once
+
+#define EGT_RISE_COUNT 8 // initializers below list 8 entries
+
+class EgtRiseMonitor : public EngineModule {
+public:
+	using interface_t = EgtRiseMonitor;
+
+	void onSlowCallback() override;
+
+	// egts: one reading per EGT input (invalid = sensor not working); dtSeconds since the last call
+	void update(const SensorResult* egts, size_t count, float dtSeconds);
+
+	// fastest rising EGT in C/s, unexpected when no EGT works
+	expected<float> getMaxRiseRate() const;
+	float getRiseRate(size_t index) const;
+
+	// sample window and smoothing time
+	static constexpr float sampleTime = 0.5f;
+	static constexpr float smoothTime = 1.0f;
+
+private:
+	float m_elapsed = 0;
+	float m_windowStart[EGT_RISE_COUNT] = {};
+	bool m_hasWindowStart[EGT_RISE_COUNT] = {};
+	float m_rate[EGT_RISE_COUNT] = {};
+	bool m_valid[EGT_RISE_COUNT] = {};
+	Timer m_timer;
+	bool m_timerStarted = false;
+};
