diff --git a/unit_tests/tests/test_oil_restart_lock.cpp b/unit_tests/tests/test_oil_restart_lock.cpp
new file mode 100644
index 0000000000..e8abc87b8d
--- /dev/null
+++ b/unit_tests/tests/test_oil_restart_lock.cpp
@@ -0,0 +1,150 @@
+#include "pch.h"
+
+#include "limp_manager.h"
+#include "alert_manager.h"
+
+// pro/outra-ecu-style oil pressure start check: settable time to build pressure, and
+// a restart lock after the engine was shut off for low oil pressure
+
+TEST(OilRestartLock, startTimeoutCanBeSet) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	engineConfiguration->minOilPressureAfterStart = 200;
+	engineConfiguration->oilPressureStartTimeout = 2;
+
+	LimpManager dut;
+	Sensor::setMockValue(SensorType::OilPressure, 50);
+	engine->rpmCalculator.setRpmValue(1000);
+
+	dut.updateState(1000, getTimeNowNt());
+	EXPECT_TRUE(dut.allowInjection());
+
+	advanceTimeUs(1.5e6);
+	dut.updateState(1000, getTimeNowNt());
+	EXPECT_TRUE(dut.allowInjection());
+
+	// 2.5 s after start: cut, instead of waiting 5 s
+	advanceTimeUs(1.0e6);
+	dut.updateState(1000, getTimeNowNt());
+	EXPECT_EQ(ClearReason::OilPressure, dut.allowInjection().reason);
+}
+
+static void shutDownForLowOil(LimpManager& dut) {
+	engineConfiguration->minOilPressureAfterStart = 200;
+	Sensor::setMockValue(SensorType::OilPressure, 50);
+	engine->rpmCalculator.setRpmValue(1000);
+	dut.updateState(1000, getTimeNowNt());
+	advanceTimeUs(5.5e6);
+	dut.updateState(1000, getTimeNowNt());
+	ASSERT_EQ(ClearReason::OilPressure, dut.allowInjection().reason);
+
+	// the engine stops
+	engine->rpmCalculator.setRpmValue(0);
+	dut.updateState(0, getTimeNowNt());
+}
+
+TEST(OilRestartLock, offByDefault) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	LimpManager dut;
+	shutDownForLowOil(dut);
+	EXPECT_FALSE(dut.isOilRestartLocked());
+	EXPECT_TRUE(dut.allowInjection());
+}
+
+TEST(OilRestartLock, blocksStartForSetTime) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	engineConfiguration->oilRestartLockTime = 30;
+	LimpManager dut;
+	shutDownForLowOil(dut);
+
+	EXPECT_TRUE(dut.isOilRestartLocked());
+	EXPECT_EQ(ClearReason::OilRestartLock, dut.allowInjection().reason);
+	EXPECT_EQ(ClearReason::OilRestartLock, dut.allowIgnition().reason);
+	EXPECT_NEAR(30, dut.getOilRestartLockLeft(getTimeNowNt()), 0.1);
+
+	// still locked after 20 s, also while cranking
+	advanceTimeUs(20e6);
+	engine->rpmCalculator.setRpmValue(200);
+	dut.updateState(200, getTimeNowNt());
+	EXPECT_EQ(ClearReason::OilRestartLock, dut.allowInjection().reason);
+	EXPECT_NEAR(10, dut.getOilRestartLockLeft(getTimeNowNt()), 0.1);
+
+	// free after 30 s
+	advanceTimeUs(11e6);
+	engine->rpmCalculator.setRpmValue(0);
+	dut.updateState(0, getTimeNowNt());
+	EXPECT_FALSE(dut.isOilRestartLocked());
+	EXPECT_TRUE(dut.allowInjection());
+}
+
+TEST(OilRestartLock, keyOffEndsLock) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	engineConfiguration->oilRestartLockTime = 60;
+	LimpManager dut;
+	shutDownForLowOil(dut);
+	ASSERT_TRUE(dut.isOilRestartLocked());
+
+	dut.onIgnitionStateChanged(false);
+	dut.onIgnitionStateChanged(true);
+	dut.updateState(0, getTimeNowNt());
+	EXPECT_FALSE(dut.isOilRestartLocked());
+	EXPECT_TRUE(dut.allowInjection());
+}
+
+TEST(OilRestartLock, oilAlertEngineOffLocksToo) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	engineConfiguration->oilRestartLockTime = 30;
+	engineConfiguration->cranking.rpm = 400;
+
+	auto& oil = config->alerts[0];
+	oil.sensor = GPPWM_OilPressure;
+	oil.action = ALERT_ENGINE_OFF;
+	oil.triggerBelow = true;
+	oil.useRpmCurve = false;
+	oil.threshold = 100;
+	oil.delay = 0;
+	oil.minRpm = 0;
+
+	auto& alerts = engine->module<AlertManager>().unmock();
+	LimpManager dut;
+
+	Sensor::setMockValue(SensorType::OilPressure, 50);
+	engine->rpmCalculator.setRpmValue(3000);
+	Sensor::setMockValue(SensorType::Rpm, 3000);
+	alerts.update(getTimeNowNt());
+	ASSERT_TRUE(alerts.isEngineOffBy(GPPWM_OilPressure));
+	EXPECT_FALSE(alerts.isEngineOffBy(GPPWM_Clt));
+	dut.updateState(3000, getTimeNowNt());
+	EXPECT_EQ(ClearReason::AlertEngineOff, dut.allowInjection().reason);
+
+	engine->rpmCalculator.setRpmValue(0);
+	dut.updateState(0, getTimeNowNt());
+	EXPECT_TRUE(dut.isOilRestartLocked());
+}
+
+TEST(OilRestartLock, otherAlertDoesNotLock) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	engineConfiguration->oilRestartLockTime = 30;
+
+	auto& clt = config->alerts[0];
+	clt.sensor = GPPWM_Clt;
+	clt.action = ALERT_ENGINE_OFF;
+	clt.triggerBelow = false;
+	clt.useRpmCurve = false;
+	clt.threshold = 110;
+	clt.delay = 0;
+	clt.minRpm = 0;
+
+	auto& alerts = engine->module<AlertManager>().unmock();
+	LimpManager dut;
+
+	Sensor::setMockValue(SensorType::Clt, 120);
+	engine->rpmCalculator.setRpmValue(3000);
+	Sensor::setMockValue(SensorType::Rpm, 3000);
+	alerts.update(getTimeNowNt());
+	dut.updateState(3000, getTimeNowNt());
+	EXPECT_EQ(ClearReason::AlertEngineOff, dut.allowInjection().reason);
+
+	engine->rpmCalculator.setRpmValue(0);
+	dut.updateState(0, getTimeNowNt());
+	EXPECT_FALSE(dut.isOilRestartLocked());
+}
