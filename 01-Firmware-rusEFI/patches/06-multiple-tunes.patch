diff --git a/unit_tests/tests/controllers/test_tune_selector.cpp b/unit_tests/tests/controllers/test_tune_selector.cpp
new file mode 100644
index 0000000..6157a26
--- /dev/null
+++ b/unit_tests/tests/controllers/test_tune_selector.cpp
@@ -0,0 +1,154 @@
+#include "pch.h"
+
+#include "tune_selector.h"
+#include "fuel_math.h"
+
+extern ve_Map3D_t veMap;
+
+// pro-style tunes: tune 1 is the main tables, tunes 2 and 3 are config->extraTunes,
+// switched by a button or by writing activeTune, also with the engine running.
+
+class TuneSelectorTest : public testing::Test {
+protected:
+	EngineTestHelper eth{engine_type_e::TEST_ENGINE};
+
+	TuneSelector& tunes() {
+		return engine->module<TuneSelector>().unmock();
+	}
+
+	void press() {
+		tunes().update(true);
+		tunes().update(false);
+	}
+
+	void fillTune(size_t index, float ve, float ignition, float lambda) {
+		auto& tune = config->extraTunes[index];
+		setTable(tune.veTable, ve);
+		setTable(tune.injTimeTable, 0);
+		setTable(tune.ignitionTable, ignition);
+		setTable(tune.lambdaTable, lambda);
+	}
+
+	void SetUp() override {
+		setTable(config->veTable, 80);
+		setTable(config->ignitionTable, 10);
+		setTable(config->lambdaTable, 1.0f);
+		engineConfiguration->tuneCount = 3;
+		engineConfiguration->activeTune = 1;
+		fillTune(0, 60, 20, 0.9f);
+		fillTune(1, 40, 30, 0.8f);
+		tunes().update(false);
+	}
+};
+
+TEST_F(TuneSelectorTest, StartsOnMainTables) {
+	EXPECT_EQ(1, tunes().getActiveTune());
+	EXPECT_EQ(&config->veTable, &getActiveVeTable());
+	EXPECT_EQ(&config->ignitionTable, &getActiveIgnitionTable());
+	EXPECT_EQ(&config->lambdaTable, &getActiveLambdaTable());
+	EXPECT_EQ(&config->injTimeTable, &getActiveInjTimeTable());
+	EXPECT_EQ(1, engine->outputChannels.tuneInUse);
+}
+
+TEST_F(TuneSelectorTest, ButtonCyclesThroughTunes) {
+	press();
+	EXPECT_EQ(2, tunes().getActiveTune());
+	EXPECT_EQ(&config->extraTunes[0].veTable, &getActiveVeTable());
+	EXPECT_EQ(&config->extraTunes[0].boostTableOpenLoop, &getActiveBoostOpenLoopTable());
+	EXPECT_EQ(&config->extraTunes[0].boostTableClosedLoop, &getActiveBoostClosedLoopTable());
+
+	press();
+	EXPECT_EQ(3, tunes().getActiveTune());
+	EXPECT_EQ(&config->extraTunes[1].ignitionTable, &getActiveIgnitionTable());
+	EXPECT_EQ(3, engine->outputChannels.tuneInUse);
+
+	press();
+	EXPECT_EQ(1, tunes().getActiveTune());
+
+	// holding the button does not keep switching
+	tunes().update(true);
+	tunes().update(true);
+	tunes().update(true);
+	EXPECT_EQ(2, tunes().getActiveTune());
+}
+
+TEST_F(TuneSelectorTest, TuneCountLimitsTheButton) {
+	engineConfiguration->tuneCount = 2;
+	press();
+	EXPECT_EQ(2, tunes().getActiveTune());
+	press();
+	EXPECT_EQ(1, tunes().getActiveTune());
+
+	engineConfiguration->tuneCount = 1;
+	press();
+	EXPECT_EQ(1, tunes().getActiveTune());
+}
+
+TEST_F(TuneSelectorTest, EmptyTuneIsSkipped) {
+	// tune 2 has no lambda table, tune 3 has no VE table
+	setTable(config->extraTunes[0].lambdaTable, 0);
+	press();
+	EXPECT_EQ(3, tunes().getActiveTune());
+
+	setTable(config->extraTunes[1].veTable, 0);
+	tunes().update(false);
+	// the tune in use got emptied: back to the main tables
+	EXPECT_EQ(1, tunes().getActiveTune());
+	press();
+	EXPECT_EQ(1, tunes().getActiveTune());
+}
+
+TEST_F(TuneSelectorTest, EmptyMsTableIsSkippedInMsMode) {
+	engineConfiguration->fuelAlgorithm = engine_load_mode_e::LM_INJ_TIME;
+	// VE is filled but the ms table of tune 2 is empty
+	setTable(config->extraTunes[1].injTimeTable, 3.0f);
+	press();
+	EXPECT_EQ(3, tunes().getActiveTune());
+}
+
+TEST_F(TuneSelectorTest, AppSelectsTune) {
+	engineConfiguration->activeTune = 3;
+	tunes().update(false);
+	EXPECT_EQ(3, tunes().getActiveTune());
+
+	// the button still works from there
+	press();
+	EXPECT_EQ(1, tunes().getActiveTune());
+
+	// out of range is clamped to the number of tunes
+	engineConfiguration->tuneCount = 2;
+	engineConfiguration->activeTune = 3;
+	tunes().update(false);
+	EXPECT_EQ(2, tunes().getActiveTune());
+}
+
+TEST_F(TuneSelectorTest, TablesOfTheTuneAreUsed) {
+	float rpm = 3000;
+	float load = 50;
+	EXPECT_NEAR(80, veMap.getValue(rpm, load), 0.1);
+	EXPECT_NEAR(10, IgnitionState::getInterpolatedIgnitionAngle(rpm, load), 0.1);
+	EXPECT_NEAR(1.0, engine->fuelComputer.getTargetLambda(rpm, load), 0.01);
+
+	press();
+	EXPECT_NEAR(60, veMap.getValue(rpm, load), 0.1);
+	EXPECT_NEAR(20, IgnitionState::getInterpolatedIgnitionAngle(rpm, load), 0.1);
+	EXPECT_NEAR(0.9, engine->fuelComputer.getTargetLambda(rpm, load), 0.01);
+
+	press();
+	EXPECT_NEAR(40, veMap.getValue(rpm, load), 0.1);
+	EXPECT_NEAR(30, IgnitionState::getInterpolatedIgnitionAngle(rpm, load), 0.1);
+	EXPECT_NEAR(0.8, engine->fuelComputer.getTargetLambda(rpm, load), 0.01);
+}
+
+TEST_F(TuneSelectorTest, MsTableOfTheTuneIsUsed) {
+	engineConfiguration->fuelAlgorithm = engine_load_mode_e::LM_INJ_TIME;
+	setTable(config->injTimeTable, 4.0f);
+	setTable(config->extraTunes[0].injTimeTable, 6.0f);
+	tunes().update(false);
+
+	float mainMass = getInjectionTimeTableFuelMass(3000);
+	press();
+	EXPECT_EQ(2, tunes().getActiveTune());
+	float tune2Mass = getInjectionTimeTableFuelMass(3000);
+	EXPECT_GT(tune2Mass, mainMass);
+}
