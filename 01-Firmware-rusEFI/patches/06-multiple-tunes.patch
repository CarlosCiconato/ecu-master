diff --git a/firmware/controllers/modules/tune_selector/tune_selector.cpp b/firmware/controllers/modules/tune_selector/tune_selector.cpp
new file mode 100644
index 0000000..0f2c7c0
--- /dev/null
+++ b/firmware/controllers/modules/tune_selector/tune_selector.cpp
@@ -0,0 +1,130 @@
+#include "pch.h"
+
+#include "tune_selector.h"
+#include "speed_density.h"
+#include "boost_control.h"
+
+static_assert(std::is_same_v<decltype(tune_set_s::injTimeTable), inj_time_table_t>);
+static_assert(std::is_same_v<decltype(tune_set_s::veTable), ve_table_t>);
+static_assert(std::is_same_v<decltype(tune_set_s::ignitionTable), ignition_table_t>);
+static_assert(std::is_same_v<decltype(tune_set_s::lambdaTable), lambda_table_t>);
+static_assert(std::is_same_v<decltype(tune_set_s::boostTableOpenLoop), boost_open_table_t>);
+static_assert(std::is_same_v<decltype(tune_set_s::boostTableClosedLoop), boost_closed_table_t>);
+
+static tune_set_s* getExtraTune(uint8_t tune) {
+	if (tune < 2 || tune - 2 >= EXTRA_TUNE_COUNT) {
+		return nullptr;
+	}
+	return &config->extraTunes[tune - 2];
+}
+
+static tune_set_s* getActiveExtraTune() {
+	return getExtraTune(engine->module<TuneSelector>()->getActiveTune());
+}
+
+inj_time_table_t& getActiveInjTimeTable() {
+	auto tune = getActiveExtraTune();
+	return tune ? tune->injTimeTable : config->injTimeTable;
+}
+
+ve_table_t& getActiveVeTable() {
+	auto tune = getActiveExtraTune();
+	return tune ? tune->veTable : config->veTable;
+}
+
+ignition_table_t& getActiveIgnitionTable() {
+	auto tune = getActiveExtraTune();
+	return tune ? tune->ignitionTable : config->ignitionTable;
+}
+
+lambda_table_t& getActiveLambdaTable() {
+	auto tune = getActiveExtraTune();
+	return tune ? tune->lambdaTable : config->lambdaTable;
+}
+
+boost_open_table_t& getActiveBoostOpenLoopTable() {
+	auto tune = getActiveExtraTune();
+	return tune ? tune->boostTableOpenLoop : config->boostTableOpenLoop;
+}
+
+boost_closed_table_t& getActiveBoostClosedLoopTable() {
+	auto tune = getActiveExtraTune();
+	return tune ? tune->boostTableClosedLoop : config->boostTableClosedLoop;
+}
+
+template<typename TTable>
+static bool isEmptyTable(const TTable& table) {
+	for (const auto& row : table) {
+		for (const auto& cell : row) {
+			if ((float)cell != 0) {
+				return false;
+			}
+		}
+	}
+	return true;
+}
+
+bool TuneSelector::isTuneUsable(uint8_t tune) const {
+	if (tune == 1) {
+		return true;
+	}
+	auto set = getExtraTune(tune);
+	if (!set) {
+		return false;
+	}
+
+	bool fuelEmpty = engineConfiguration->fuelAlgorithm == engine_load_mode_e::LM_INJ_TIME
+		? isEmptyTable(set->injTimeTable)
+		: isEmptyTable(set->veTable);
+	return !fuelEmpty && !isEmptyTable(set->lambdaTable);
+}
+
+uint8_t TuneSelector::getTuneCount() const {
+	return std::clamp<int>(engineConfiguration->tuneCount, 1, 1 + EXTRA_TUNE_COUNT);
+}
+
+void TuneSelector::selectTune(uint8_t tune) {
+	if (isTuneUsable(tune)) {
+		m_activeTune = tune;
+	}
+}
+
+void TuneSelector::update(bool buttonPressed) {
+	uint8_t count = getTuneCount();
+
+	// The app (or TunerStudio) picks a tune by writing activeTune
+	uint8_t configTune = std::clamp<int>(engineConfiguration->activeTune, 1, count);
+	if (configTune != m_lastConfigTune) {
+		m_lastConfigTune = configTune;
+		selectTune(configTune);
+	} else if (buttonPressed && !m_wasPressed) {
+		// Next usable tune, skipping empty ones
+		uint8_t tune = m_activeTune;
+		for (uint8_t i = 0; i < count; i++) {
+			tune = tune % count + 1;
+			if (isTuneUsable(tune)) {
+				m_activeTune = tune;
+				break;
+			}
+		}
+	}
+	m_wasPressed = buttonPressed;
+
+	if (m_activeTune > count || !isTuneUsable(m_activeTune)) {
+		m_activeTune = 1;
+	}
+
+	// Point the VE and boost maps to the tables of the tune in use
+	initSpeedDensity();
+#if EFI_BOOST_CONTROL
+	updateBoostTablesForTune();
+#endif // EFI_BOOST_CONTROL
+
+	engine->outputChannels.tuneInUse = m_activeTune;
+}
+
+void TuneSelector::onSlowCallback() {
+	bool pressed = isBrainPinValid(engineConfiguration->tuneSwitchPin)
+		&& efiReadPin(engineConfiguration->tuneSwitchPin, engineConfiguration->tuneSwitchPinMode);
+	update(pressed);
+}
diff --git a/firmware/controllers/modules/tune_selector/tune_selector.h b/firmware/controllers/modules/tune_selector/tune_selector.h
new file mode 100644
index 0000000..83a9c72
--- /dev/null
+++ b/firmware/controllers/modules/tune_selector/tune_selector.h
@@ -0,0 +1,49 @@
+/*
+ * @file tune_selector.h
+ *
+ * pro-style tunes ("ajustes"): tune 1 is the main tables, tunes 2 and 3 are
+ * config->extraTunes, each with its own main fuel (ms or VE), ignition, lambda and boost
+ * tables on the main tables axes. A button cycles through the tunes, and the app can pick
+ * one by writing activeTune, also with the engine running.
+ */
+
+#pragma once
+
+using inj_time_table_t = decltype(persistent_config_s::injTimeTable);
+using ve_table_t = decltype(persistent_config_s::veTable);
+using ignition_table_t = decltype(persistent_config_s::ignitionTable);
+using lambda_table_t = decltype(persistent_config_s::lambdaTable);
+using boost_open_table_t = decltype(persistent_config_s::boostTableOpenLoop);
+using boost_closed_table_t = decltype(persistent_config_s::boostTableClosedLoop);
+
+class TuneSelector : public EngineModule {
+public:
+	using interface_t = TuneSelector;
+
+	void onSlowCallback() override;
+
+	void update(bool buttonPressed);
+
+	// 1 is the main tables, 2 and 3 are config->extraTunes
+	uint8_t getActiveTune() const {
+		return m_activeTune;
+	}
+	// A tune with an empty main fuel table or lambda table is never selected
+	bool isTuneUsable(uint8_t tune) const;
+
+private:
+	uint8_t getTuneCount() const;
+	void selectTune(uint8_t tune);
+
+	uint8_t m_activeTune = 1;
+	uint8_t m_lastConfigTune = 0;
+	bool m_wasPressed = false;
+};
+
+// Tables of the tune in use
+inj_time_table_t& getActiveInjTimeTable();
+ve_table_t& getActiveVeTable();
+ignition_table_t& getActiveIgnitionTable();
+lambda_table_t& getActiveLambdaTable();
+boost_open_table_t& getActiveBoostOpenLoopTable();
+boost_closed_table_t& getActiveBoostClosedLoopTable();
