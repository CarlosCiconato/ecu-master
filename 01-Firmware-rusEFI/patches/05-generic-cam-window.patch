 /**
  * @returns true if tooth should be ignored
  */
+bool isInCamSyncWindow(angle_t position, float windowStart, float windowWidth) {
+	// The window is given in crank degrees, so it matches in both crank turns of the engine cycle
+	float fromStart = fmodf(position - windowStart, 360);
+	if (fromStart < 0) {
+		fromStart += 360;
+	}
+	return fromStart < windowWidth;
+}
+
+void TriggerCentral::resetCamWindow(int index) {
+	m_camWindowToothCount[index] = 0;
+	m_camWindowSeen[index] = false;
+}
+
+void TriggerCentral::countCamWindowTooth(int index) {
+	if (m_camWindowToothCount[index] < UINT8_MAX) {
+		m_camWindowToothCount[index]++;
+	}
+}
+
+bool TriggerCentral::acceptCamWindowTooth(int index, angle_t currentPosition) {
+	if (!isInCamSyncWindow(currentPosition, config->camSyncWindowStart[index], config->camSyncWindowWidth[index])) {
+		// not the sync tooth
+		return false;
+	}
+
+	// teeth seen since the previous sync tooth, this one included
+	uint8_t counted = m_camWindowToothCount[index];
+	bool hadPrevious = m_camWindowSeen[index];
+	m_camWindowToothCount[index] = 0;
+	m_camWindowSeen[index] = true;
+
+	uint8_t expected = config->camSyncToothCount[index];
+	if (expected != 0 && hadPrevious && counted != expected) {
+		// missing or extra teeth (noise, or a window that also catches a tooth on the other crank turn)
+		camWindowToothErrors++;
+		return false;
+	}
+	return true;
+}
