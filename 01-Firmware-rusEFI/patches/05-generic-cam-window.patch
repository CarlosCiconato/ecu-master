+/*
+ * test_generic_cam_window.cpp
+ *
+ * pro-style generic cam decoder: any number of cam teeth, only the tooth inside the
+ * detection window gives engine phase, with an optional tooth count check.
+ */
+
+#include "pch.h"
+
+// Engine cycle is 100ms at 1200 RPM: one crank tooth per turn (half moon) at 0 and 50ms.
+// The cam has 4 evenly spaced teeth plus one extra tooth on the first crank turn only.
+static const int evenTeethMs[] = { 5, 30, 55, 80 };
+static const int extraToothMs = 12;
+static const int noiseToothMs = 40;
+
+struct CamRun {
+	bool evenTeeth = true;
+	bool extraTooth = true;
+	// cycle with one extra noise tooth, -1 for none
+	int noiseCycle = -1;
+};
+
+static void setupCrankAndCam(EngineTestHelper& eth, vvt_mode_e mode) {
+	engineConfiguration->triggerInputPins[1] = Gpio::Unassigned;
+	setCrankOperationMode();
+	engineConfiguration->vvtMode[0] = mode;
+	engineConfiguration->vvtOffsets[0] = 0;
+	eth.setTriggerType(trigger_type_e::TT_HALF_MOON);
+	engineConfiguration->camInputs[0] = Gpio::A10;
+}
+
+static bool isEvenTooth(int ms) {
+	for (int tooth : evenTeethMs) {
+		if (tooth == ms) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static void runCycles(EngineTestHelper& eth, const CamRun& run, int fromCycle, int cycles) {
+	for (int cycle = fromCycle; cycle < fromCycle + cycles; cycle++) {
+		for (int ms = 0; ms < 100; ms++) {
+			eth.moveTimeForwardUs(MS2US(1));
+
+			if (ms % 50 == 0) {
+				eth.firePrimaryTriggerRise();
+			} else if (ms % 50 == 25) {
+				eth.firePrimaryTriggerFall();
+			}
+
+			bool camTooth = (run.evenTeeth && isEvenTooth(ms))
+				|| (run.extraTooth && ms == extraToothMs)
+				|| (cycle == run.noiseCycle && ms == noiseToothMs);
+			if (camTooth) {
+				hwHandleVvtCamSignal(TriggerValue::RISE, getTimeNowNt(), 0);
+			}
+		}
+	}
+}
+
+// Single tooth decoder fed with just one tooth: gives the reference VVT position and the
+// position of that tooth, used to place the generic window
+static float referenceToothPosition(int toothMs, float* vvtPosition) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	setupCrankAndCam(eth, VVT_SINGLE_TOOTH);
+
+	float toothPosition = 0;
+	for (int cycle = 0; cycle < 20; cycle++) {
+		for (int ms = 0; ms < 100; ms++) {
+			eth.moveTimeForwardUs(MS2US(1));
+			if (ms % 50 == 0) {
+				eth.firePrimaryTriggerRise();
+			} else if (ms % 50 == 25) {
+				eth.firePrimaryTriggerFall();
+			}
+			if (ms == toothMs) {
+				hwHandleVvtCamSignal(TriggerValue::RISE, getTimeNowNt(), 0);
+				toothPosition = engine->triggerCentral.triggerState.vvtCurrentPosition;
+			}
+		}
+	}
+
+	EXPECT_TRUE(engine->triggerCentral.triggerState.hasSynchronizedPhase());
+	*vvtPosition = engine->triggerCentral.getVVTPosition(0, 0);
+	return toothPosition;
+}
+
+static void setWindowAround(float position, uint8_t toothCount) {
+	config->camSyncWindowStart[0] = position - 10;
+	config->camSyncWindowWidth[0] = 20;
+	config->camSyncToothCount[0] = toothCount;
+}
+
+TEST(GenericCamWindow, WindowMatchesBothCrankTurns) {
+	EXPECT_TRUE(isInCamSyncWindow(355, 350, 20));
+	EXPECT_TRUE(isInCamSyncWindow(5, 350, 20));
+	EXPECT_TRUE(isInCamSyncWindow(365, 0, 10));
+	EXPECT_TRUE(isInCamSyncWindow(725, 0, 10));
+	EXPECT_TRUE(isInCamSyncWindow(-10, 340, 30));
+	EXPECT_FALSE(isInCamSyncWindow(30, 0, 20));
+	EXPECT_FALSE(isInCamSyncWindow(200, 0, 20));
+	EXPECT_FALSE(isInCamSyncWindow(345, 350, 20));
+}
+
+TEST(GenericCamWindow, SyncsOnWindowToothAmongManyTeeth) {
+	float referenceVvt;
+	float extraPosition = referenceToothPosition(extraToothMs, &referenceVvt);
+
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+	setupCrankAndCam(eth, VVT_GENERIC_WINDOW);
+	setWindowAround(extraPosition, 5);
+
+	CamRun run;
+	runCycles(eth, run, 0, 20);
+
+	EXPECT_TRUE(engine->triggerCentral.triggerState.hasSynchronizedPhase());
+	// same engine phase and VVT position as a cam with only the sync tooth
+	EXPECT_NEAR(referenceVvt, engine->triggerCentral.getVVTPosition(0, 0), 0.5);
+	EXPECT_EQ(0, engine->triggerCentral.camWindowToothErrors);
+
+	// stays put over more cycles
+	runCycles(eth, run, 20, 10);
+	EXPECT_NEAR(referenceVvt, engine->triggerCentral.getVVTPosition(0, 0), 0.5);
+}
