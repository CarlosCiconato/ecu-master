 	uint8_t startupDelay;Time after startup before closed loop operation is allowed.;"seconds", 1, 0, 0, 250, 0
+	uint16_t minRpm;Closed loop runs only above this RPM. 0 = no limit.;"RPM", 1, 0, 0, 20000, 0
+	uint16_t maxRpm;Closed loop runs only below this RPM. 0 = no limit.;"RPM", 1, 0, 0, 20000, 0
 
