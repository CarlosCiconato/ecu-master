diff --git a/unit_tests/tests/test_stft.cpp b/unit_tests/tests/test_stft.cpp
index e495825..932e6aa 100644
--- a/unit_tests/tests/test_stft.cpp
+++ b/unit_tests/tests/test_stft.cpp
@@ -496,3 +496,43 @@ TEST_F(ShortTermFuelTrimBehavior, IntegrationUsesTargetLambdaAndClampsTimeConsta
 }
 
 } // namespace
+
+// pro-style: closed loop only between a minimum and a maximum RPM
+TEST(ClosedLoopFuel, RpmWindow) {
+	ShortTermFuelTrim stft;
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+
+	engineConfiguration->fuelClosedLoopCorrectionEnabled = true;
+	engineConfiguration->stft.minClt = -40;
+	engineConfiguration->stft.startupDelay = 0;
+	Sensor::setMockValue(SensorType::Clt, 80);
+	engine->rpmCalculator.setRpmValue(3000);
+	Sensor::setMockValue(SensorType::Rpm, 3000);
+	ASSERT_TRUE(engine->rpmCalculator.isRunning());
+
+	// 0 = no limit
+	engineConfiguration->stft.minRpm = 0;
+	engineConfiguration->stft.maxRpm = 0;
+	EXPECT_EQ(stftEnabled, stft.getCorrectionState());
+
+	engineConfiguration->stft.minRpm = 1500;
+	engineConfiguration->stft.maxRpm = 5000;
+	EXPECT_EQ(stftEnabled, stft.getCorrectionState());
+
+	Sensor::setMockValue(SensorType::Rpm, 1200);
+	EXPECT_EQ(stftDisabledRpmWindow, stft.getCorrectionState());
+
+	Sensor::setMockValue(SensorType::Rpm, 6000);
+	EXPECT_EQ(stftDisabledRpmWindow, stft.getCorrectionState());
+
+	// only the maximum set
+	engineConfiguration->stft.minRpm = 0;
+	Sensor::setMockValue(SensorType::Rpm, 800);
+	EXPECT_EQ(stftEnabled, stft.getCorrectionState());
+
+	// outside the window there is no correction
+	Sensor::setMockValue(SensorType::Rpm, 6000);
+	auto result = stft.getCorrection(6000, 50);
+	EXPECT_EQ(stftDisabledRpmWindow, stft.stftCorrectionState);
+	EXPECT_FLOAT_EQ(1, result.banks[0]);
+}
