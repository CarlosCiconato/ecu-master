-	stftStateList = bits, U08, [0:3], "Enabled", "Settings", "Tuning", "RPM", "Cranking Delay", "Clt", "AFR out of range", "DFCO", "TPS Accel", "Fuel Cut", "Launch"
+	stftStateList = bits, U08, [0:3], "Enabled", "Settings", "Tuning", "RPM", "Cranking Delay", "Clt", "AFR out of range", "DFCO", "TPS Accel", "Fuel Cut", "Launch", "RPM window"
 
 	unitsLabels = bits, U08, [0:2], @@UNITS_FAHRENHEIT@@ , @@UNITS_CELSIUS@@
