 9 files changed, 96 insertions(+), 2 deletions(-)

diff --git a/firmware/controllers/algo/accel_enrichment.cpp b/firmware/controllers/algo/accel_enrichment.cpp
index 1210a24..c89197d 100644
--- a/firmware/controllers/algo/accel_enrichment.cpp
+++ b/firmware/controllers/algo/accel_enrichment.cpp
@@ -25,6 +25,19 @@
 #include "tunerstudio.h"
 
 
+float getAccelCltMult() {
+	auto clt = Sensor::get(SensorType::Clt);
+	if (!clt) {
+		return 1;
+	}
+	float mult = interpolate2d(clt.Value, config->tpsAccelCltBins, config->tpsAccelCltMult);
+	// 0 or nonsense in an old tune: no change
+	if (mult < 0.01f || mult > 100) {
+		return 1;
+	}
+	return mult;
+}
+
 // on this level we do not distinguish between multiplier and 'ms adder' modes
 float TpsAccelEnrichment::getTpsEnrichment() {
 	ScopePerf perf(PE::GetTpsEnrichment);
@@ -87,6 +100,12 @@ float TpsAccelEnrichment::getTpsEnrichment() {
 		resetFractionValues();
 	}
 
+	// bigger accel enrichment with a cold engine, decel enleanment unchanged
+	cltMult = getAccelCltMult();
+	if (extraFuel > 0) {
+		extraFuel *= cltMult;
+	}
+
 	float mult = interpolate2d(rpm, config->tpsTspCorrValuesBins,
 						config->tpsTspCorrValues);
 	if (mult != 0 && (mult < 0.01 || mult > 100)) {
