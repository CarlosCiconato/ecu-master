diff --git a/unit_tests/tests/test_accel_enrichment.cpp b/unit_tests/tests/test_accel_enrichment.cpp
index 37579d1..c8fd1a4 100644
--- a/unit_tests/tests/test_accel_enrichment.cpp
+++ b/unit_tests/tests/test_accel_enrichment.cpp
@@ -490,3 +490,54 @@ TEST(fuel, StoppedTpsResetDoesNotInventAccelerationFromHeldThrottle) {
 	engine->rpmCalculator.setRpmValue(1200);
 	EXPECT_NEAR(0, ae.getTpsEnrichment(), 0.00001f);
 }
+
+// pro-style bigger accel enrichment with a cold engine
+TEST(fuel, tpsAccelColdEngineMultiplier) {
+	EngineTestHelper eth(engine_type_e::TEST_ENGINE);
+
+	engineConfiguration->tpsAccelEnrichmentThreshold = 5;
+	engineConfiguration->tpsAccelLookback = 2;
+	engineConfiguration->tpsAccelFractionPeriod = 1;
+	engineConfiguration->tpsAccelFractionDivisor = 1;
+	engineConfiguration->tpsDecelEnleanmentThreshold = 5;
+	engineConfiguration->tpsDecelEnleanmentMultiplier = 0.1;
+
+	setTable(config->tpsTpsAccelTable, 1.0f);
+	setRpmTableBin(config->tpsTspCorrValuesBins);
+	setLinearCurve(config->tpsTspCorrValues, 1, 1);
+
+	// 2.0 at -40 C going down to 1.0 at 60 C and above
+	copyArray(config->tpsAccelCltBins, { -40, -20, 0, 20, 40, 60, 80, 100 });
+	copyArray(config->tpsAccelCltMult, { 2.0f, 1.8f, 1.6f, 1.4f, 1.2f, 1.0f, 1.0f, 1.0f });
+
+	initAccelEnrichment();
+	engine->rpmCalculator.setRpmValue(600);
+	engine->periodicFastCallback();
+
+	auto ae = engine->module<TpsAccelEnrichment>();
+	ae->setLength(2);
+
+	auto trigger = [&](float from, float to) {
+		ae->resetAE();
+		ae->onNewValue(from);
+		ae->onNewValue(to);
+		return ae->getTpsEnrichment();
+	};
+
+	// warm engine: no change
+	Sensor::setMockValue(SensorType::Clt, 90);
+	EXPECT_NEAR(1.0f, trigger(0, 10), EPS4D);
+
+	// cold engine: bigger accel enrichment
+	Sensor::setMockValue(SensorType::Clt, 0);
+	EXPECT_NEAR(1.6f, trigger(0, 10), EPS4D);
+	Sensor::setMockValue(SensorType::Clt, 10);
+	EXPECT_NEAR(1.5f, trigger(0, 10), EPS4D);
+
+	// decel enleanment is not made bigger
+	EXPECT_NEAR(-1.0f, trigger(10, 0), EPS4D);
+
+	// failed coolant sensor: no change
+	Sensor::setInvalidMockValue(SensorType::Clt);
+	EXPECT_NEAR(1.0f, trigger(0, 10), EPS4D);
+}
