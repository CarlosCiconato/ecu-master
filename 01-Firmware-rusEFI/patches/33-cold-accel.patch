diff --git a/firmware/integration/rusefi_config.txt b/firmware/integration/rusefi_config.txt
index c443f1f..1df2c40 100644
--- a/firmware/integration/rusefi_config.txt
+++ b/firmware/integration/rusefi_config.txt
@@ -2508,6 +2508,11 @@ int8_t[ENGINE_NOISE_CURVE_SIZE] autoscale knockBaseNoise;Knock sensor output kno
 uint8_t[TPS_TPS_ACCEL_CLT_CORR_TABLE] autoscale tpsTspCorrValuesBins;;"RPM", 50, 0, 0, 12500, 0
 uint8_t[TPS_TPS_ACCEL_CLT_CORR_TABLE] autoscale tpsTspCorrValues;Multiplier applied to additive TPS enrichment at each RPM. 1.00 is neutral, 0.50 halves and 2.00 doubles. Ignored by MAP Prediction and Lua.;"multiplier", 0.02, 0, 0, 5, 2
 
+! pro-style bigger accel enrichment with a cold engine
+#define TPS_ACCEL_CLT_SIZE 8
+int8_t[TPS_ACCEL_CLT_SIZE] tpsAccelCltBins;;"C", 1, 0, -40, 120, 0
+uint8_t[TPS_ACCEL_CLT_SIZE] autoscale tpsAccelCltMult;Multiplier applied to TPS accel enrichment at each coolant temperature. 1.00 is neutral, 2.00 doubles it with a cold engine. Not applied to decel enleanment. Ignored by MAP Prediction and Lua.;"multiplier", 0.02, 0, 0, 5, 2
+
 uint8_t[TPS_TPS_ACCEL_CLT_CORR_TABLE] autoscale predictiveMapBlendDurationBins;;"RPM", 50, 0, 0, 12500, 0
 uint8_t[TPS_TPS_ACCEL_CLT_CORR_TABLE] autoscale predictiveMapBlendDurationValues;Transition duration and total event time limit from estimated MAP toward current measured MAP, interpolated at current RPM. Rising estimated MAP restarts blending without extending the event time limit. Prediction may exit earlier. The largest duration in this curve also sizes TPS history. Used only by MAP Prediction.;"second", 0.02, 0, 0, 5, 2
 
