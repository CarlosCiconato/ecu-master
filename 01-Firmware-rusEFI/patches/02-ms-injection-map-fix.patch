From d4e0c4d300396d275f806712c4ff4a3834e7ec08 Mon Sep 17 00:00:00 2001
From: Carlos Ciconato <354919267+CarlosCiconato@users.noreply.github.com>
Date: Sun, 25 Oct 2026 11:12:25 +0000
Subject: [PATCH] Fix Injection time (ms) build: enum header and injector flow
 access

LM_INJ_TIME must also go in the hand-maintained generated enums header,
and getBaseFlowRate is reached through unmock() since the module is
mockable in unit tests.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TkhsyMr5ndz2MBCxuDZhPC
---
 firmware/controllers/algo/fuel_math.cpp                      | 2 +-
 .../generated/enums/rusefi_config_generated_enums.h          | 5 ++++-
 .../tests/ignition_injection/test_injection_time_map.cpp     | 2 +-
 3 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/firmware/controllers/algo/fuel_math.cpp b/firmware/controllers/algo/fuel_math.cpp
index cb71ed2..a2df5b2 100644
--- a/firmware/controllers/algo/fuel_math.cpp
+++ b/firmware/controllers/algo/fuel_math.cpp
@@ -212,7 +212,7 @@ mass_t convertInjectionTimeToFuelMass(floatms_t pulseMs) {
 	}
 
 	// Base flow (no pressure ratio), so the injector model still compensates fuel pressure
-	return effectiveMs * engine->module<InjectorModelPrimary>()->getBaseFlowRate() * 0.001f;
+	return effectiveMs * engine->module<InjectorModelPrimary>().unmock().getBaseFlowRate() * 0.001f;
 }
 
 float getInjectionTimeTableLoad() {
diff --git a/firmware/controllers/generated/enums/rusefi_config_generated_enums.h b/firmware/controllers/generated/enums/rusefi_config_generated_enums.h
index aa9d8f8..b089a7d 100644
--- a/firmware/controllers/generated/enums/rusefi_config_generated_enums.h
+++ b/firmware/controllers/generated/enums/rusefi_config_generated_enums.h
@@ -51,6 +51,8 @@ namespace rusefi::generated::enums
         LM_REAL_MAF = 1,
         LM_ALPHA_N = 2,
         LM_LUA = 3,
+        /* pro-style main map: injector pulse in ms per cylinder per cycle at 14 V, deadtime included */
+        LM_INJ_TIME = 4,
         UNSUPPORTED_ENUM_VALUE
     };
 
@@ -59,6 +61,7 @@ namespace rusefi::generated::enums
         { engine_load_mode_e::LM_SPEED_DENSITY, "LM_SPEED_DENSITY" },
         { engine_load_mode_e::LM_REAL_MAF, "LM_REAL_MAF" },
         { engine_load_mode_e::LM_ALPHA_N, "LM_ALPHA_N" },
-        { engine_load_mode_e::LM_LUA, "LM_LUA" }
+        { engine_load_mode_e::LM_LUA, "LM_LUA" },
+        { engine_load_mode_e::LM_INJ_TIME, "LM_INJ_TIME" }
     };
 }
diff --git a/unit_tests/tests/ignition_injection/test_injection_time_map.cpp b/unit_tests/tests/ignition_injection/test_injection_time_map.cpp
index 66fa2fc..61f6999 100644
--- a/unit_tests/tests/ignition_injection/test_injection_time_map.cpp
+++ b/unit_tests/tests/ignition_injection/test_injection_time_map.cpp
@@ -36,7 +36,7 @@ protected:
 	}
 
 	float flowGramPerMs() {
-		return engine->module<InjectorModelPrimary>()->getBaseFlowRate() * 0.001f;
+		return engine->module<InjectorModelPrimary>().unmock().getBaseFlowRate() * 0.001f;
 	}
 };
 
