diff --git a/firmware/config/boards/nossa_top6c/adc3_slow_config.h b/firmware/config/boards/nossa_top6c/adc3_slow_config.h
new file mode 100644
index 00000000000..d076fe6a342
--- /dev/null
+++ b/firmware/config/boards/nossa_top6c/adc3_slow_config.h
@@ -0,0 +1,14 @@
+/**
+ * @file adc3_slow_config.h
+ *
+ * ADC3-only pins read as normal slow analog inputs (EFI_ADC3_SLOW, see stm32_adc_v2_adc3.cpp).
+ * ADC3 is shared with software knock (PF4/PF5): a knock window preempts a slow batch.
+ */
+
+#pragma once
+
+#define ADC3_SLOW_CHANNELS { \
+	EFI_ADC_35, /* PF9  ADC3_IN7, AV11 */ \
+	EFI_ADC_36, /* PF10 ADC3_IN8, AIN14 internal MAP */ \
+	EFI_ADC_37, /* PF3  ADC3_IN9, AIN13 */ \
+}
diff --git a/firmware/config/boards/nossa_top6c/board.mk b/firmware/config/boards/nossa_top6c/board.mk
new file mode 100644
index 00000000000..a5c09c3a8b4
--- /dev/null
+++ b/firmware/config/boards/nossa_top6c/board.mk
@@ -0,0 +1,59 @@
+# Board "nossa top 6c": STM32F767IIT6 (LQFP176, 2 MB flash), based on Proteus F7.
+BOARDCPPSRC = $(BOARD_DIR)/board_configuration.cpp
+
+ifneq ($(PROJECT_CPU),ARCH_STM32F7)
+$(error nossa_top6c is STM32F7 only, got [$(PROJECT_CPU)])
+endif
+
+# No LEDs on this board (PE3 is LS18, PD14 is IGN1).
+DDEFS += -DLED_CRITICAL_ERROR_BRAIN_PIN=Gpio::Unassigned
+DDEFS += -DFIRMWARE_ID=\"nossa_top6c\"
+DDEFS += $(VAR_DEF_ENGINE_TYPE)
+
+DDEFS += -DBOOT_COM_RS232_RX_MAX_DATA=120
+DDEFS += -DOPEN_BLT_TEST_COMMAND=1
+DDEFS += -DBOOT_BACKDOOR_ENTRY_TIMEOUT_MS=0
+
+DDEFS += -DVR_SUPPLY_VOLTAGE=5
+
+# ADC3: software knock on PF4/PF5 plus ADC3-only slow inputs PF9/PF10/PF3 (adc3_slow_config.h)
+DDEFS += -DSTM32_ADC_USE_ADC3=TRUE
+DDEFS += -DEFI_SOFTWARE_KNOCK=TRUE
+DDEFS += -DEFI_ADC3_SLOW=TRUE
+
+# TunerStudio on UART4 (PH13 TX / PH14 RX, AF8) for the ESP32-S3, at the same time as USB.
+DDEFS += -DTS_PRIMARY_UxART_PORT=SD4 -DEFI_TS_PRIMARY_IS_SERIAL=TRUE -DSTM32_SERIAL_USE_UART4=TRUE
+DDEFS += -DEFI_CONSOLE_TX_BRAIN_PIN=Gpio::H13 -DEFI_CONSOLE_RX_BRAIN_PIN=Gpio::H14 -DEFI_CONSOLE_AF=8
+
+# CAN1 PD0/PD1 for OpenBLT
+DDEFS += -DBOOT_COM_CAN_CHANNEL_INDEX=0
+DDEFS += -DOPENBLT_CAN_RX_PORT=GPIOD
+DDEFS += -DOPENBLT_CAN_RX_PIN=0
+DDEFS += -DOPENBLT_CAN_TX_PORT=GPIOD
+DDEFS += -DOPENBLT_CAN_TX_PIN=1
+
+DDEFS += -DHW_NOSSA_TOP6C=1
+
+DDEFS += -DKNOCK_SPECTROGRAM=TRUE
+DDEFS += -DLUA_RX_MAX_FILTER_COUNT=96
+# Reuses the Proteus F7 static id (TS/console identification only)
+DDEFS += -DSTATIC_BOARD_ID=STATIC_BOARD_ID_PROTEUS_F7
+# OTG2 has enough endpoints for a second CDC ACM for the CAN sniffer.
+DDEFS += -DHAL_USE_USB_CDC_2=TRUE
+DDEFS += -DEFI_HD_ACR=TRUE
+# technical debt: UI uses separate ts_show_tcu flag
+DDEFS += -DEFI_TCU=TRUE
+
+ifeq ($(EFI_LUA_LOOKUP),)
+  EFI_LUA_LOOKUP = TRUE
+endif
+DDEFS += -DEFI_LUA_LOOKUP=$(EFI_LUA_LOOKUP)
+
+ifeq ($(DEBUG_LEVEL_OPT),)
+  DEBUG_LEVEL_OPT = -Os -ggdb -g
+endif
+
+# STM32F767IIT6 has 2 MB of flash
+include $(PROJECT_DIR)/hw_layer/ports/stm32/2mb_flash.mk
+
+DDEFS += -DBOARD_SERIAL="\"000000000000010000000000\""
diff --git a/firmware/config/boards/nossa_top6c/board_configuration.cpp b/firmware/config/boards/nossa_top6c/board_configuration.cpp
new file mode 100644
index 00000000000..42e61cc9836
--- /dev/null
+++ b/firmware/config/boards/nossa_top6c/board_configuration.cpp
@@ -0,0 +1,174 @@
+/**
+ * @file boards/nossa_top6c/board_configuration.cpp
+ *
+ * @brief Configuration defaults for the "nossa top 6c" board (STM32F767IIT6).
+ *
+ * Based on the Proteus board configuration.
+ * This board has no LEDs: status LED getters return Gpio::Unassigned and
+ * LED_CRITICAL_ERROR_BRAIN_PIN is Gpio::Unassigned (board.mk).
+ * PB2 is hard-wired to GND: never configure it as an output.
+ */
+
+#include "pch.h"
+#include "basic_configuration.h"
+#include "nossa_top6c_meta.h"
+#include "board_overrides.h"
+
+static const brain_pin_e injPins[] = {
+	Gpio::TOP6C_LS_1,
+	Gpio::TOP6C_LS_2,
+	Gpio::TOP6C_LS_3,
+	Gpio::TOP6C_LS_4,
+	Gpio::TOP6C_LS_5,
+	Gpio::TOP6C_LS_6,
+	Gpio::TOP6C_LS_7,
+	Gpio::TOP6C_LS_8,
+};
+
+static const brain_pin_e ignPins[] = {
+	Gpio::TOP6C_IGN_1,
+	Gpio::TOP6C_IGN_2,
+	Gpio::TOP6C_IGN_3,
+	Gpio::TOP6C_IGN_4,
+	Gpio::TOP6C_IGN_5,
+	Gpio::TOP6C_IGN_6,
+	Gpio::TOP6C_IGN_7,
+	Gpio::TOP6C_IGN_8,
+};
+
+static void setInjectorPins() {
+	for (size_t i = 0; i < efi::size(engineConfiguration->injectionPins); i++) {
+		engineConfiguration->injectionPins[i] = i < efi::size(injPins) ? injPins[i] : Gpio::Unassigned;
+	}
+}
+
+static void setIgnitionPins() {
+	for (size_t i = 0; i < efi::size(engineConfiguration->ignitionPins); i++) {
+		engineConfiguration->ignitionPins[i] = i < efi::size(ignPins) ? ignPins[i] : Gpio::Unassigned;
+	}
+}
+
+// No LEDs on this board
+Gpio getCommsLedPin() {
+	return Gpio::Unassigned;
+}
+
+Gpio getRunningLedPin() {
+	return Gpio::Unassigned;
+}
+
+Gpio getWarningLedPin() {
+	return Gpio::Unassigned;
+}
+
+static void setupVbatt() {
+	// Analog input divider: copied from Proteus (5.6k high side/10k low side). CHECK against the PCB.
+	engineConfiguration->analogInputDividerCoefficient = 1.56f;
+
+	// 82k high side/10k low side = 9.2
+	engineConfiguration->vbattDividerCoeff = (92.0f / 10.0f);
+
+	// Battery sense on PA7
+	engineConfiguration->vbattAdcChannel = TOP6C_IN_VBATT;
+
+	engineConfiguration->adcVcc = 3.3f;
+}
+
+static void setupEtb() {
+	setupTLE9201IncludingStepper(Gpio::TOP6C_ETB1_PWM, Gpio::TOP6C_ETB1_DIR, Gpio::TOP6C_ETB1_DIS);
+	setupTLE9201IncludingStepper(Gpio::TOP6C_ETB2_PWM, Gpio::TOP6C_ETB2_DIR, Gpio::TOP6C_ETB2_DIS, 1);
+}
+
+static bool applyTop6cBasicConfiguration(BasicConfigurationAction action) {
+	return applyBasicConfiguration(action,
+		setupEtb,
+		TOP6C_IN_TPS,
+		TOP6C_IN_TPS1_2,
+		TOP6C_IN_PPS,
+		TOP6C_IN_PPS2);
+}
+
+static void setupDefaultSensorInputs() {
+	// VR1 = crank, VR2 = cam
+	engineConfiguration->triggerInputPins[0] = Gpio::TOP6C_VR_1;
+	engineConfiguration->triggerInputPins[1] = Gpio::Unassigned;
+	engineConfiguration->camInputs[0] = Gpio::TOP6C_VR_2;
+
+	// Hall pull-up enable outputs (turned on only when the input type is Hall)
+	engineConfiguration->hallPullupCrank1Pin = Gpio::TOP6C_VR1_PULLUP;
+	engineConfiguration->hallPullupCam1Pin = Gpio::TOP6C_VR2_PULLUP;
+	// VR3 (PA10) is not assigned by default; its pull-up is offered as cam input 2
+	engineConfiguration->hallPullupCam2Pin = Gpio::TOP6C_VR3_PULLUP;
+
+	engineConfiguration->clt.adcChannel = TOP6C_IN_CLT;
+	engineConfiguration->iat.adcChannel = TOP6C_IN_IAT;
+	engineConfiguration->tps1_1AdcChannel = TOP6C_IN_TPS;
+
+	// Internal MAP sensor MPXH6400A (4 bar) on AIN14 / PF10 (ADC3 only: no crank-synced MAP averaging)
+	engineConfiguration->map.sensor.hwChannel = TOP6C_IN_MAP;
+	engineConfiguration->map.sensor.type = MT_MPXH6400;
+
+	// Both onboard rusEFI wideband controllers are on CAN1
+	engineConfiguration->enableAemXSeries = true;
+	engineConfiguration->widebandOnSecondBus = false;
+}
+
+static void setupSdCard() {
+	engineConfiguration->sdCardSpiDevice = SPI_DEVICE_3;
+	engineConfiguration->sdCardCsPin = Gpio::D2;
+
+	engineConfiguration->is_enabled_spi_3 = true;
+	engineConfiguration->spi3sckPin = Gpio::C10;
+	engineConfiguration->spi3misoPin = Gpio::C11;
+	engineConfiguration->spi3mosiPin = Gpio::C12;
+}
+
+static void top6c_boardConfigOverrides() {
+	setupSdCard();
+	setupVbatt();
+
+	engineConfiguration->clt.config.bias_resistor = TOP6C_DEFAULT_AT_PULLUP;
+	engineConfiguration->iat.config.bias_resistor = TOP6C_DEFAULT_AT_PULLUP;
+
+	engineConfiguration->canTxPin = Gpio::D1;
+	engineConfiguration->canRxPin = Gpio::D0;
+	engineConfiguration->can2RxPin = Gpio::B12;
+	engineConfiguration->can2TxPin = Gpio::B13;
+
+	engineConfiguration->lps25BaroSensorScl = Gpio::B10;
+	engineConfiguration->lps25BaroSensorSda = Gpio::B11;
+}
+
+static void top6c_boardDefaultConfiguration() {
+	setInjectorPins();
+	setIgnitionPins();
+	setupEtb();
+
+	engineConfiguration->isSdCardEnabled = true;
+
+	setupDefaultSensorInputs();
+
+	engineConfiguration->enableSoftwareKnock = true;
+}
+
+// ESP32-S3: IO0 high = normal boot from flash, EN high = run.
+static void top6c_boardInitHardware() {
+#if EFI_PROD_CODE
+	palSetLine(PAL_LINE(GPIOI, 5));
+	palSetLineMode(PAL_LINE(GPIOI, 5), PAL_MODE_OUTPUT_PUSHPULL);
+	palSetLine(PAL_LINE(GPIOI, 4));
+	palSetLineMode(PAL_LINE(GPIOI, 4), PAL_MODE_OUTPUT_PUSHPULL);
+#endif // EFI_PROD_CODE
+}
+
+void boardPrepareForStop() {
+	// Wake on the CAN RX pin
+	palEnableLineEvent(PAL_LINE(GPIOD, 0), PAL_EVENT_MODE_RISING_EDGE);
+}
+
+void setup_custom_board_overrides() {
+	custom_board_DefaultConfiguration = top6c_boardDefaultConfiguration;
+	custom_board_ConfigOverrides = top6c_boardConfigOverrides;
+	custom_board_applyBasicConfiguration = applyTop6cBasicConfiguration;
+	custom_board_InitHardware = top6c_boardInitHardware;
+}
