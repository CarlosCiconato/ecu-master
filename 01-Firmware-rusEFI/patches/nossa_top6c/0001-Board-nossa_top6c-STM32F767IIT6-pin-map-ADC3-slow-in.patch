+		case Gpio::H2:
+			return "5V supply 1 OK";
+		case Gpio::H3:
+			return "5V supply 2 OK";
+		case Gpio::H6:
+			return "Lowside 1";
+		case Gpio::H7:
+			return "Highside 2";
+		case Gpio::H8:
+			return "Ignition 2";
+		case Gpio::H9:
+			return "Highside 1";
+		case Gpio::I0:
+			return "Ignition 6";
+		default:
+			return nullptr;
+	}
+	return nullptr;
+}
